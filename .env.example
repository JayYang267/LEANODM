# Confirm these public values with the site owner before a production build.
# Optional legacy override: only https://www.leanodm.com (or its trailing slash).
# All canonical/schema/sitemap URLs share src/config/seo.ts. Preview domains,
# localhost, HTTP and path/query overrides fail the build rather than leak.
PUBLIC_SITE_URL=
# A working contact-page URL or mailto URL; never the template's mock RFQ form.
PUBLIC_CONTACT_URL=

# Optional RFQ receiver; leave empty until the receiver is implemented and verified.
# A same-origin path or an absolute HTTPS URL. Used at BUILD time.
# JSON POST; successful HTTP status plus {"accepted":true} is required.
# This repository does not include a receiver or an attachment upload service.
PUBLIC_RFQ_ENDPOINT=
