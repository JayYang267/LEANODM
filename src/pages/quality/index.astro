---
import { SITE } from '@config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import QualityReviewBrief from '../../components/QualityReviewBrief.astro';
import ActivityHighlights from '../../components/ActivityHighlights.astro';
import { systemControls, qualityDocuments, improvementSteps, qualityFaqs } from '../../data/quality-system';
import '../../styles/quality-system.css';
const title = 'Quality Management System for OEM & ODM Manufacturing | LEANODM.com';
const description = 'Explore Xinyinhai’s documented quality management controls: requirements, approved revisions, supplier quality, traceability, corrective action and supplier review.';
const origin = SITE.url;
const canonical = new URL('/quality/',origin).href;
const image = new URL('/brand/leanodm-wordmark.png',origin).href;
const navigation = [{label:'System overview',href:'#system-overview'},{label:'Document control',href:'#document-control'},{label:'Improvement',href:'#improvement'},{label:'Supplier review',href:'#supplier-review'},{label:'FAQ',href:'#faq'}];
const schema = {'@context':'https://schema.org','@graph':[
  {'@type':'WebPage','@id':`${canonical}#webpage`,url:canonical,name:title,description,inLanguage:'en', isPartOf: { '@id': `${origin}/#website` },about:{'@id':`${origin}/#xinyinhai`},breadcrumb:{'@id':`${canonical}#breadcrumbs`}},
  {'@type':'BreadcrumbList','@id':`${canonical}#breadcrumbs`,itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:origin+'/'},{'@type':'ListItem',position:2,name:'Quality Management System',item:canonical}]},
  {'@type':'FAQPage','@id':`${canonical}#faq`,mainEntity:qualityFaqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))},
]};
---
<BaseLayout title={title} description={description} technicalPage technicalNavigation={navigation} technicalPageTitle="Quality system" technicalContactLabel="Prepare Quality Review" technicalFooterDescription="Define the product, factory scope and quality evidence needed for your supplier review." contactHref="#project-requirements">
  <Fragment slot="head"><link rel="canonical" href={canonical}/><meta property="og:url" content={canonical}/><meta property="og:image" content={image}/><meta property="og:image:alt" content="LEANODM.com website wordmark"/><meta name="twitter:image" content={image}/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/></Fragment>
  <div class="qs-page">
    <section class="qs-hero" aria-labelledby="page-title"><div class="qs-container">
      <nav class="qs-breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Quality</li></ol></nav>
      <div class="qs-hero-grid"><div><p class="qs-eyebrow">QUALITY / MANAGEMENT SYSTEM</p><h1 id="page-title">Quality Management System</h1><p class="qs-lead">Connect the agreed requirement to the production decision.</p><p class="qs-intro">Xinyinhai’s documented procedures connect engineering, purchasing, production and quality through approved information, defined responsibilities and reviewable records. Explore how those controls support an OEM or ODM project.</p><div class="qs-actions"><a class="qs-button" href="#system-overview">Explore the system <span aria-hidden="true">↓</span></a><a class="qs-link" href="#supplier-review">Plan a supplier review <span aria-hidden="true">↗</span></a></div></div>
        <figure class="qs-map"><div class="qs-map-head"><span>FROM REQUIREMENT TO REVIEW</span><span>QMS</span></div><ol><li><span>01</span><div><strong>Agree the requirement</strong><small>Specification, sample and acceptance criteria</small></div></li><li><span>02</span><div><strong>Control the information</strong><small>Approved drawings, materials and instructions</small></div></li><li><span>03</span><div><strong>Verify and record</strong><small>Inspection, testing and release decisions</small></div></li><li><span>04</span><div><strong>Review and improve</strong><small>Feedback, causes and verified corrective action</small></div></li></ol><figcaption><b aria-hidden="true">↺</b> Approved improvements return to the working standard.</figcaption></figure>
      </div><div class="qs-hero-foot"><span>Defined responsibilities</span><span>Controlled revisions</span><span>Documented decisions</span></div>
    </div></section>

    <div class="qs-container">
      <section id="system-overview" class="qs-section" aria-labelledby="system-title"><div class="qs-heading"><div><p class="qs-eyebrow">01 / CONNECTED CONTROLS</p><h2 id="system-title">A quality system across the project.</h2></div><p>Inspection sits within a wider process. Requirements, materials, working information and follow-up must connect so each team has a clear basis for its decisions.</p></div><div class="qs-controls">{systemControls.map((item,i)=><article><span class="qs-number">0{i+1}</span><h3>{item.name}</h3><p>{item.text}</p><a class="qs-link" href={item.href}>{item.link}<span aria-hidden="true">↗</span></a></article>)}</div></section>

      <section id="document-control" class="qs-section" aria-labelledby="documents-title"><div class="qs-heading"><div><p class="qs-eyebrow">02 / APPROVED INFORMATION</p><h2 id="documents-title">Document Revision &amp; Quality Record Control</h2></div><p>The file-control procedure defines approval, distribution, change and withdrawal of documents. Record control defines how the resulting evidence is collected, retained and accessed.</p></div>
        <div class="qs-table-wrap" role="region" aria-label="Controlled documents and their purpose; scroll horizontally" tabindex="0"><table><caption>Information used to align the project teams</caption><thead><tr><th scope="col">Information</th><th scope="col">Documented control</th><th scope="col">Why it matters</th></tr></thead><tbody>{qualityDocuments.map(row=><tr><th scope="row">{row.document}</th><td>{row.control}</td><td>{row.purpose}</td></tr>)}</tbody></table></div><p class="qs-table-hint">On a small screen, scroll the table to compare all columns.</p>
        <div class="qs-band"><h3>A change needs a shared decision.</h3><p>A revised material, drawing or customer requirement can affect purchasing, tooling, work instructions and verification. Review the affected scope, communicate the approved change and confirm the information used for the next production run. Certified products also follow their applicable certification-change requirements.</p><a class="qs-link" href="/customization/product-adaptation/">Explore product adaptation <span aria-hidden="true">↗</span></a></div>
      </section>

      <section id="risk-and-responsibility" class="qs-section qs-split" aria-labelledby="risk-title"><div><p class="qs-eyebrow">03 / PREVENTION & RESPONSIBILITY</p><h2 id="risk-title">Quality Risk Review &amp; Responsibilities</h2><p>The procedures call for risk identification across design, supply, production, measurement and customer feedback. Relevant departments define actions and follow their effectiveness.</p><p>For a buyer, the practical starting point is the product’s intended use, destination market, critical characteristics and known concerns.</p><a class="qs-link" href="/customization/new-product-development/">Engineering and design review <span aria-hidden="true">↗</span></a></div><dl class="qs-evidence"><div><dt>Engineering and production planning</dt><dd>Review technical requirements, design inputs, material availability and production feasibility. Coordinate requirement and order changes.</dd></div><div><dt>Purchasing, production and warehouse</dt><dd>Control supplier information, work instructions, materials, storage and identification through the relevant stages.</dd></div><div><dt>Quality and management review</dt><dd>Maintain inspection and measurement controls, review nonconformities and use process monitoring and internal audits to identify improvement needs.</dd></div></dl></section>

      <section id="improvement" class="qs-section" aria-labelledby="improvement-title"><div class="qs-heading"><div><p class="qs-eyebrow">04 / CORRECTIVE ACTION</p><h2 id="improvement-title">Corrective Action &amp; Effectiveness Review</h2></div><p>Customer complaints, significant quality problems, audit findings and abnormal data can trigger corrective action. The documented process connects the response with effectiveness checks and the working standard.</p></div><ol class="qs-sequence">{improvementSteps.map((step,i)=><li><span class="qs-number">0{i+1}</span><h3>{step.name}</h3><p>{step.text}</p></li>)}</ol><div class="qs-inline-links"><a class="qs-link" href="/quality/quality-control-process/#release">Nonconformity and release <span aria-hidden="true">↗</span></a></div></section>

      <ActivityHighlights placement="quality" title="Improvement in everyday practice" intro="Explore recorded examples of workplace organization, material flow and shared learning." />

      <section id="quality-integrity" class="qs-section qs-split" aria-labelledby="integrity-title"><div><p class="qs-eyebrow">05 / PEOPLE & RELIABLE RECORDS</p><h2 id="integrity-title">Quality decisions depend on honest information.</h2><p>The quality-culture procedure sets expectations for truthful inspection records, confidentiality, fair decisions and reporting concerns. Training supports awareness of each person’s responsibilities.</p></div><dl class="qs-evidence"><div><dt>Record the actual result</dt><dd>Keep inspection and test information accurate and complete. Do not alter results, conceal nonconformities or bypass the approved release process.</dd></div><div><dt>Maintain competence</dt><dd>Identify training needs for the role, provide instruction and assess effectiveness through the appropriate knowledge or practical evaluation.</dd></div><div><dt>Raise concerns and follow up</dt><dd>Provide a route for concerns to be received, investigated and followed through with records and protection of confidential information.</dd></div></dl><div class="qs-inline-links"><a class="qs-link" href="/quality/inspector-training/">Inspector training <span aria-hidden="true">↗</span></a><a class="qs-link" href="/about/ethical-manufacturing/">Ethical manufacturing <span aria-hidden="true">↗</span></a></div></section>

      <section id="supplier-review" class="qs-section" aria-labelledby="review-title"><div class="qs-heading"><div><p class="qs-eyebrow">06 / SUPPLIER QUALIFICATION</p><h2 id="review-title">Supplier Quality Evidence &amp; Certification Review</h2></div><p>Use the public process summaries to identify the quality records to review for the site and product scope. Where supplier qualification requires certification, check the applicable certificate holder, scope and validity with your LEANODM contact.</p></div><div class="qs-split"><div><h3>Records to discuss</h3><ul class="qs-evidence-list"><li>Applicable specification, approved sample and revision history</li><li>Supplier approval and incoming-inspection examples</li><li>First article, process and final inspection records</li><li>Relevant tests and measurement-equipment status</li><li>Material, production and shipment record links</li><li>Corrective-action follow-up and effectiveness review</li></ul><p>Specify any confidentiality limits and whether a redacted example or a project-specific record is needed.</p></div><div><h3>Review the applicable certificate</h3><p>For ISO 9001-based supplier qualification, check the <strong>certified legal entity, manufacturing site, scope, standard edition, issuing body and validity</strong> on the current certificate.</p><p>A quality management system certificate and a product-specific approval answer different questions. Product certification and test reports should match the relevant product, market and configuration.</p><a class="qs-link" href="#project-requirements">Prepare your review checklist <span aria-hidden="true">↓</span></a></div></div></section>

      <section id="quality-pages" class="qs-section" aria-labelledby="quality-pages-title"><p class="qs-eyebrow">EXPLORE THE DETAILS</p><h2 id="quality-pages-title">Continue your quality review.</h2><div class="qs-related"><a href="/quality/quality-control-process/">Quality Control Process <span>First articles, production checks and acceptance decisions.</span></a><a href="/quality/incoming-inspection/">Incoming Inspection <span>Material-specific checks and supplier quality controls.</span></a><a href="/quality/appearance-inspection/">Appearance Inspection <span>Visual defects, viewing conditions and reference samples.</span></a><a href="/quality/product-testing/">Product Testing <span>Test methods, conditions and the verification context.</span></a><a href="/quality/traceability/">Traceability &amp; Materials <span>Identification, material protection and record relationships.</span></a><a href="/quality/inspector-training/">Inspector Training <span>Defect recognition and consistent inspection decisions.</span></a></div></section>
      <section id="faq" class="qs-section" aria-labelledby="faq-title"><p class="qs-eyebrow">BUYER QUESTIONS</p><h2 id="faq-title">Quality management questions.</h2><div class="qs-faq">{qualityFaqs.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></section>
    </div><QualityReviewBrief />
  </div>
</BaseLayout>
