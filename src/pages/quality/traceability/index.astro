---
import { SITE } from '@config/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QualityReviewBrief from '../../../components/QualityReviewBrief.astro';
import { traceabilityRecords, traceFaqs } from '../../../data/quality-system';
import '../../../styles/quality-system.css';
const title = 'Product Traceability & Material Control | LEANODM.com';
const description = 'Understand documented order, batch, material and delivery record links, inspection status, customer-supplied materials and quality investigation at Xinyinhai.';
const origin = SITE.url;
const canonical = new URL('/quality/traceability/',origin).href;
const image = new URL('/brand/leanodm-wordmark.png',origin).href;
const navigation = [{label:'Record links',href:'#record-links'},{label:'Material status',href:'#material-status'},{label:'Protection',href:'#material-protection'},{label:'Investigation',href:'#investigation'},{label:'FAQ',href:'#faq'}];
const breadcrumbs = [{name:'Home',url:'/'},{name:'Quality',url:'/quality/'},{name:'Traceability & Materials',url:'/quality/traceability/'}];
const schema = {'@context':'https://schema.org','@graph':[
  {'@type':'WebPage','@id':`${canonical}#webpage`,url:canonical,name:title,description,inLanguage:'en', isPartOf: { '@id': `${origin}/#website` },about:{'@id':`${origin}/#xinyinhai`},breadcrumb:{'@id':`${canonical}#breadcrumbs`}},
  {'@type':'BreadcrumbList','@id':`${canonical}#breadcrumbs`,itemListElement:breadcrumbs.map((item,i)=>({'@type':'ListItem',position:i+1,name:item.name,item:new URL(item.url,origin).href}))},
  {'@type':'FAQPage','@id':`${canonical}#faq`,mainEntity:traceFaqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))},
]};
const steps=[{name:'Identify the reference',text:'Collect the product, order or shipment reference, batch or date code, defect description and available samples.'},{name:'Review the records',text:'Check related production, material, inspection and delivery information to establish the affected scope.'},{name:'Coordinate containment',text:'Review stock and delivered quantities with the relevant teams and customer; agree the response for the identified issue.'},{name:'Control returned goods',text:'Identify and isolate returned goods. Review the approved disposition, including rework and reinspection where appropriate.'},{name:'Verify corrective action',text:'Investigate the cause, follow the action taken and confirm effectiveness. Retain the investigation and follow-up records.'}];
---
<BaseLayout title={title} description={description} technicalPage technicalNavigation={navigation} technicalPageTitle="Traceability" technicalContactLabel="Prepare Traceability Review" technicalFooterDescription="Agree order references, material identification and record access for your product." contactHref="#project-requirements">
  <Fragment slot="head"><link rel="canonical" href={canonical}/><meta property="og:url" content={canonical}/><meta property="og:image" content={image}/><meta property="og:image:alt" content="LEANODM.com website wordmark"/><meta name="twitter:image" content={image}/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/></Fragment>
  <div class="qs-page">
    <section class="qs-hero" aria-labelledby="page-title"><div class="qs-container"><nav class="qs-breadcrumb" aria-label="Breadcrumb"><ol>{breadcrumbs.map((item,i)=><li>{i<2?<a href={item.url}>{item.name}</a>:<span aria-current="page">{item.name}</span>}</li>)}</ol></nav><div class="qs-hero-grid"><div><p class="qs-eyebrow">QUALITY / IDENTIFICATION & RECORDS</p><h1 id="page-title">Product Traceability &amp; Material Control</h1><p class="qs-lead">Connect product and material batches to order, production, inspection and delivery records.</p><p class="qs-intro">Documented controls connect orders, material batches, production, inspection and delivery information. Identification and storage controls help keep material status clear as products move through the factory.</p><div class="qs-actions"><a class="qs-button" href="#record-links">Explore the record links <span aria-hidden="true">↓</span></a><a class="qs-link" href="#investigation">Quality investigation <span aria-hidden="true">↗</span></a></div></div>
      <figure class="qs-map"><div class="qs-map-head"><span>RECORD RELATIONSHIPS</span><span>TRACE</span></div><div class="qs-trace-map"><div class="qs-trace-root"><strong>Reviewed contract</strong><small>Order reference and agreed requirements</small></div><ul class="qs-record-tree"><li><strong>Delivery note</strong><small>Product, quantity, date and shipment details</small></li><li><strong>Production work order</strong><small>Manufacturing content and requirements</small><ul><li><strong>Final inspection report</strong><small>Quality findings for the product lot</small></li><li><strong>Work record</strong><ul><li><strong>Material batch</strong><ul><li><strong>Manufacturer</strong></li></ul></li></ul></li></ul></li></ul></div><figcaption>Agree the required traceability extent for the product and order.</figcaption></figure>
      </div><div class="qs-hero-foot"><span>Order and batch references</span><span>Visible material status</span><span>Investigation support</span></div></div></section>
      <div class="qs-container">
        <section id="record-links" class="qs-section" aria-labelledby="records-title"><div class="qs-heading"><div><p class="qs-eyebrow">01 / FROM ORDER TO DELIVERY</p><h2 id="records-title">Order, Batch &amp; Delivery Record Links</h2></div><p>The identification and traceability procedure sets out the relationships below. Planning defines the required extent when traceability is needed by the contract, applicable requirements or internal management.</p></div><div class="qs-table-wrap" role="region" aria-label="Traceability record relationships; scroll horizontally" tabindex="0"><table><caption>Records and responsibilities in the documented process</caption><thead><tr><th scope="col">Stage</th><th scope="col">Record</th><th scope="col">Information connected</th><th scope="col">Responsible function</th></tr></thead><tbody>{traceabilityRecords.map(row=><tr><th scope="row">{row.stage}</th><td>{row.record}</td><td>{row.links}</td><td>{row.owner}</td></tr>)}</tbody></table></div><p class="qs-table-hint">On a small screen, scroll the table to compare all columns.</p><div class="qs-band"><h3>Define the level of detail at the start.</h3><p>Order and material-batch records are the basis described here. If your project needs individual serial numbers, barcode scanning, specific retention periods or digital access, include those requirements in the initial review so the method and feasibility can be agreed.</p></div></section>

        <section id="material-status" class="qs-section" aria-labelledby="status-title"><div class="qs-heading"><div><p class="qs-eyebrow">02 / IDENTIFICATION & SEGREGATION</p><h2 id="status-title">Material Identification, Status &amp; Segregation</h2></div><p>Physical identification and the corresponding records distinguish material waiting for a decision from accepted items and items requiring controlled disposition.</p></div><div class="qs-statuses"><article><span class="qs-number">BEFORE THE DECISION</span><h3>Awaiting inspection</h3><p>Receive and identify the material, keep it in the designated waiting area and initiate the relevant inspection or verification route.</p></article><article><span class="qs-number">AFTER ACCEPTANCE</span><h3>Accepted for the next stage</h3><p>Apply the required status identification and retain the acceptance record so warehouse and production teams can recognize the decision.</p></article><article><span class="qs-number">WHEN AN ISSUE IS FOUND</span><h3>Controlled disposition</h3><p>Identify and segregate nonconforming items. Review return, rework, scrap or an authorized concession; keep the decision and any required customer agreement recorded.</p></article></div><p class="qs-caption">Status is a recorded decision supported by labels, designated areas or containers. Reworked products require the relevant reinspection before acceptance.</p><a class="qs-link" href="/quality/quality-control-process/#release">How nonconformities are handled <span aria-hidden="true">↗</span></a></section>

        <section id="material-protection" class="qs-section qs-split" aria-labelledby="protection-title"><div><p class="qs-eyebrow">03 / STORAGE & CUSTOMER MATERIALS</p><h2 id="protection-title">Storage Protection &amp; Customer-Supplied Materials</h2><p>The product-protection procedure connects receiving, storage, issuing, handling and delivery. Material identity and inspection status need to remain recognizable throughout those activities.</p><a class="qs-link" href="/quality/incoming-inspection/">Review incoming material controls <span aria-hidden="true">↗</span></a></div><dl class="qs-evidence"><div><dt>Batch identification and stock rotation</dt><dd>Identify the material, specification, quantity and batch reference. Use stock-location records and first-in, first-out issuing to support orderly material flow.</dd></div><div><dt>Storage and handling protection</dt><dd>Use suitable storage locations, containers and handling methods to avoid deterioration or damage. Preserve labels and check stock condition when inventory is reviewed.</dd></div><div><dt>Customer-supplied material</dt><dd>Identify it as customer property, maintain separate inventory records and appropriate protection, and control its use for the intended customer’s product. Communicate abnormal usage through the customer-coordination team.</dd></div><div><dt>Damaged or uncertain stock</dt><dd>Re-identify material found damaged, deteriorated or otherwise abnormal and refer it to Quality for a decision before further use.</dd></div></dl></section>

        <section id="investigation" class="qs-section" aria-labelledby="investigation-title"><div class="qs-heading"><div><p class="qs-eyebrow">04 / CUSTOMER FEEDBACK & INVESTIGATION</p><h2 id="investigation-title">Quality Investigation &amp; Affected-Batch Review</h2></div><p>Inspection and delivery records support a focused response to a quality concern. Where a return or recall is needed, the documented procedure calls for coordination with the customer, a defined plan and controlled handling of returned goods.</p></div><ol class="qs-sequence">{steps.map((step,i)=><li><span class="qs-number">0{i+1}</span><h3>{step.name}</h3><p>{step.text}</p></li>)}</ol><div class="qs-band"><h3>Bring the references that help locate the records.</h3><p>Share the order or shipment number, product revision, visible batch or date code, affected quantity and defect description. Photographs, retained samples and packaging labels can help clarify the issue.</p><a class="qs-link" href="/quality/#improvement">Corrective action and effectiveness review <span aria-hidden="true">↗</span></a></div></section>

        <section id="related-controls" class="qs-section" aria-labelledby="related-title"><p class="qs-eyebrow">RELATED CONTROLS</p><h2 id="related-title">Read the record links in context.</h2><div class="qs-related"><a href="/quality/">Quality Management System <span>Document control, responsibilities and improvement.</span></a><a href="/quality/quality-control-process/">Quality Control Process <span>Inspection stages, decisions and reinspection.</span></a><a href="/customization/oem-manufacturing/">OEM Manufacturing <span>Production readiness and agreed manufacturing information.</span></a></div></section>
        <section id="faq" class="qs-section" aria-labelledby="faq-title"><p class="qs-eyebrow">BUYER QUESTIONS</p><h2 id="faq-title">Traceability and material questions.</h2><div class="qs-faq">{traceFaqs.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></section>
      </div><QualityReviewBrief mode="traceability" />
  </div>
</BaseLayout>
