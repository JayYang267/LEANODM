---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../config/site';
import ActivityCard from '../../../components/ActivityCard.astro';
import ImageLightbox from '../../../components/ImageLightbox.astro';
import { activities, activityCategories, getRelatedActivities, activityContextLinks, type Activity } from '../../../data/activities';
import '../../../styles/activities.css';
export function getStaticPaths() { return activities.map(activity => ({ params: { slug: activity.slug }, props: { activity } })); }
interface Props { activity: Activity }
const { activity } = Astro.props;
const category = activityCategories.find(item => item.id === activity.category)!;
const images = activity.media.filter(item => item.kind === 'image');
const videos = activity.media.filter(item => item.kind === 'video');
const related = getRelatedActivities(activity);
const contextLinks = [...new Set(activity.placements.filter(item => item !== 'home'))].map(placement => activityContextLinks[placement]);
if (!contextLinks.length) contextLinks.push(activityContextLinks[activity.category === 'improvement' ? 'quality' : 'ethical']);
const origin = SITE.url;
const canonical = new URL(`/about/activities/${activity.slug}/`, origin).href;
const coverUrl = new URL(activity.coverImageUrl, origin).href;
const breadcrumbs = [
  { name: 'Home', url: '/' }, { name: 'About', url: '/about/' },
  { name: 'Activities & Community', url: '/about/activities/' },
  { name: activity.title, url: `/about/activities/${activity.slug}/` },
];
// The archive records when an activity occurred, not when this page was published.
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Article', '@id': canonical + '#article', headline: activity.title, description: activity.summary, url: canonical, image: coverUrl, inLanguage: 'en', mainEntityOfPage: canonical, isPartOf: { '@id': origin + '/#website' }, about: { '@id': origin + '/#xinyinhai' } },
  { '@type': 'BreadcrumbList', '@id': canonical + '#breadcrumbs', itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(item.url, origin).href })) },
] };
const navigation = [{ label: 'Story', href: '#story' }, ...(images.length ? [{ label: 'Photo collection', href: '#gallery' }] : []), ...(videos.length ? [{ label: 'Films', href: '#films' }] : []), { label: 'All activities', href: '/about/activities/' }];
const galleryImages = (items: typeof images, offset: number) => items.map((image, index) => ({ image, position: index + offset + 1 }));
---
<BaseLayout title={`${activity.title} | Activities & Community | LEANODM`} description={activity.summary} technicalPage technicalPageTitle="Activities & Community" technicalNavigation={navigation} contactHref="/rfq" technicalFooterDescription="Explore the people and records behind the factory, then discuss your project with our team.">
  <Fragment slot="head"><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /><meta property="og:image" content={coverUrl} /><meta property="og:image:alt" content={activity.title} /><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} /></Fragment>
  <div class="activities-page activity-detail">
    <section class="activity-story-hero" id="overview"><div class="activity-container"><nav class="activity-breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/about/">About</a></li><li><a href="/about/activities/">Activities &amp; Community</a></li><li aria-current="page">Story</li></ol></nav><div class="activity-story-heading"><p class="activity-eyebrow">{category.title}</p><h1>{activity.title}<span class="activity-red-dot" aria-hidden="true">.</span></h1><p class="activity-lead">{activity.summary}</p><div class="activity-story-meta">{activity.date ? <time datetime={activity.date}>{activity.dateLabel}</time> : <span>{activity.dateLabel}</span>}<span>{activity.imageCount} {activity.imageCount === 1 ? 'photograph' : 'photographs'}{videos.length > 0 && ` · ${videos.length} ${videos.length === 1 ? 'film' : 'films'}`}</span><a href={`/about/activities/?category=${activity.category}#archive`}>More in this category <span aria-hidden="true">↗</span></a></div></div></div><figure class="activity-story-cover"><img src={activity.coverImageUrl} width={activity.cover.width} height={activity.cover.height} alt={activity.title} fetchpriority="high" /><figcaption>{activity.title} — {activity.dateLabel}</figcaption></figure></section>
    <section class="activity-story-section" id="story"><div class="activity-container activity-story-layout"><aside><p class="activity-eyebrow">THE DOCUMENTED MOMENT</p><h2>About this activity</h2><p class="activity-record-note">A record from Xinyinhai’s activity archive. Current factory arrangements may differ from those shown.</p></aside><div class="activity-story-copy"><section><span>01 / BACKGROUND</span><h3>Activity background</h3><p>{activity.background}</p></section><section><span>02 / ACTIVITY</span><h3>What the collection records</h3><p>{activity.activity}</p></section><section><span>03 / RELEVANCE</span><h3>Relevance to the factory record</h3><p>{activity.relevance}</p></section></div></div></section>
    {images.length > 0 && <section class="activity-gallery-section" id="gallery"><div class="activity-container"><div class="activity-section-heading"><div><p class="activity-eyebrow">THE PHOTO COLLECTION</p><h2>Photographs from this activity</h2></div><p>{images.length} original moments from this record. Open any photograph to view it in full.</p></div><div class="activity-gallery">{galleryImages(images.slice(0, 6), 0).map(({ image, position }) => <figure id={`photo-${image.id}`}><a href={image.src} data-lightbox={activity.slug} data-width={image.width} data-height={image.height} data-title={activity.title} data-caption={`Photograph ${position} of ${images.length} · ${activity.dateLabel}`} data-source="Xinyinhai activity archive" aria-label={`Open photograph ${position}: ${activity.title}`}><img src={image.thumbnail} width={image.width} height={image.height} alt={`${activity.title} — photograph ${position}`} loading="lazy" decoding="async" /><span aria-hidden="true">↗</span></a><figcaption><span>Photograph {String(position).padStart(2, '0')}</span><span>{activity.dateLabel}</span></figcaption></figure>)}</div>{images.length > 6 && <details class="activity-more-photos"><summary>View the remaining {images.length - 6} photographs <span aria-hidden="true">＋</span></summary><div class="activity-gallery">{galleryImages(images.slice(6), 6).map(({ image, position }) => <figure id={`photo-${image.id}`}><a href={image.src} data-lightbox={activity.slug} data-width={image.width} data-height={image.height} data-title={activity.title} data-caption={`Photograph ${position} of ${images.length} · ${activity.dateLabel}`} data-source="Xinyinhai activity archive" aria-label={`Open photograph ${position}: ${activity.title}`}><img src={image.thumbnail} width={image.width} height={image.height} alt={`${activity.title} — photograph ${position}`} loading="lazy" decoding="async" /><span aria-hidden="true">↗</span></a><figcaption><span>Photograph {String(position).padStart(2, '0')}</span><span>{activity.dateLabel}</span></figcaption></figure>)}</div></details>}</div></section>}
    {videos.length > 0 && <section class="activity-films-section" id="films"><div class="activity-container"><div class="activity-section-heading"><div><p class="activity-eyebrow">FROM THE VIDEO ARCHIVE</p><h2>Recorded films from this activity</h2></div><p>Play each film to explore the recorded scene. Videos load when requested.</p></div><div class="activity-films">{videos.map((video, index) => <figure id={`film-${video.id}`} class:list={['activity-film', { 'activity-film-portrait': video.height > video.width }]}><div class="activity-video-stage"><video controls preload="none" playsinline poster={video.poster ?? video.thumbnail} width={video.width} height={video.height} aria-label={`${activity.title} — film ${index + 1}`}><source src={video.src} type="video/mp4" />{video.guide && <track kind="captions" src={video.guide} srclang="en" label="English context guide (not a transcript)" />}<p>Your browser does not support embedded video. <a href={video.src}>Open film {index + 1}</a>.</p></video></div><figcaption><div><span>FILM {String(index + 1).padStart(2, '0')}</span><h3>{activity.title}</h3></div><a href={video.src} target="_blank" rel="noopener">Open video file <span aria-hidden="true">↗</span></a></figcaption>{video.guide && <p class="activity-film-guide"><strong>English context guide.</strong> The optional text describes the scene and its context; it is not a speech transcript or translation. Enable it in the video’s captions menu.</p>}</figure>)}</div></div></section>}
    <section class="activity-context-section"><div class="activity-container"><p class="activity-eyebrow">CONNECT THE RECORD WITH YOUR REVIEW</p><h2>Related factory and company evidence</h2><div class="activity-context-links">{contextLinks.map(link => <a href={link.href}><div><strong>{link.label}</strong><small>{link.description}</small></div><span aria-hidden="true">↗</span></a>)}</div></div></section>
    <section class="activity-highlights"><div class="activity-container"><div class="activity-section-heading"><div><p class="activity-eyebrow">CONTINUE EXPLORING</p><h2>Related activity records</h2></div><a class="activity-text-link" href="/about/activities/">All activities <span aria-hidden="true">→</span></a></div><div class="activity-grid">{related.map(item => <ActivityCard activity={item} />)}</div></div></section>
  </div>
  {images.length > 0 && <ImageLightbox />}
</BaseLayout>
