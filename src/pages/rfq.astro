---
import { SITE } from '@config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import RFQForm from '../components/RFQForm.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-iconset/components';
import moldPhoto from '../assets/tooling-injection-molding/mold-guide-maintenance.jpg';
import { rfqCapabilities, rfqFaqs, rfqSteps } from '../data/rfq';
import '../styles/rfq.css';

const title = 'Product Development & Manufacturing Quote | LEANODM';
const description = 'Prepare a quote inquiry for plastic, silicone or electronic product development and manufacturing. Share your concept, authorized sample or approved design for project review.';
const canonical = new URL('/rfq/', SITE.url).href;
const navigation = [{ label: 'Your project', href: '#rfq-form' }, { label: 'Manufacturing', href: '#manufacturing-support' }, { label: 'FAQ', href: '#rfq-faq' }];
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description, inLanguage: 'en', isPartOf: { '@id': new URL('/#website', canonical).href }, about: { '@id': new URL('/#xinyinhai', canonical).href } },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', canonical).href },
    { '@type': 'ListItem', position: 2, name: 'Request a Quote', item: canonical },
  ] },
] };
---

<BaseLayout title={title} description={description} technicalPage technicalPageTitle="Request a quote" technicalNavigation={navigation} contactHref="#rfq-form" technicalContactLabel="Start your inquiry" technicalFooterDescription="Share your idea, existing product or approved design to discuss the next useful step.">
  <Fragment slot="head"><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} /></Fragment>
  <div class="rfq-page"><div class="rfq-container">
    <header class="rfq-intro">
      <p class="rfq-eyebrow"><span aria-hidden="true"></span> YOUR IDEA. OUR NEXT CONVERSATION.</p>
      <h1>Request a quote<span class="rfq-red-dot" aria-hidden="true">.</span></h1>
      <p class="rfq-lead">Tell us what you want to make. An early idea is enough to start.</p>
      <p class="rfq-scope">Toys, creative gifts, stationery and other projects involving plastic, silicone or electronic elements.</p>
    </header>
    <div class="rfq-main-grid">
      <section class="rfq-form-card" aria-labelledby="rfq-form-title">
        <div class="rfq-card-heading"><span class="rfq-heading-icon" aria-hidden="true"><Icon name="lucide:file-pen-line" /></span><div><h2 id="rfq-form-title">Prepare your product brief</h2><p>Only your email and a short description are required.</p></div></div>
        <RFQForm />
      </section>
      <aside class="rfq-sidebar" aria-label="Contact and manufacturing support">
        <section class="rfq-contact-card" id="rfq-contact" aria-labelledby="rfq-contact-title">
          <p class="rfq-eyebrow">LET'S TALK</p><h2 id="rfq-contact-title">Discuss your project</h2><p>Share your brief or clarify the next step.</p>
          <a class="rfq-contact-email" href="mailto:quotes@leanodm.com"><Icon name="lucide:mail" /><span><small>Email your project</small><strong>quotes@leanodm.com</strong></span><span aria-hidden="true">↗</span></a>
          <div class="rfq-wechat"><Icon name="lucide:message-circle" /><div><small>WeChat</small><strong>yang410829766</strong><p>Please mention your project when adding us.</p></div></div>
        </section>
        <section class="rfq-support-card" id="manufacturing-support" aria-labelledby="rfq-support-title">
          <p class="rfq-eyebrow">FROM PARTS TO A FINISHED PRODUCT</p><h2 id="rfq-support-title">Manufacturing support</h2>
          <ul class="rfq-capabilities">{rfqCapabilities.map(item => <li><span class="rfq-capability-icon" aria-hidden="true"><Icon name={`lucide:${item.icon}`} /></span><div><a href={item.href}>{item.title}<span aria-hidden="true"> ↗</span></a><p>{item.text}</p></div></li>)}</ul>
          <figure class="rfq-factory-photo"><Image src={moldPhoto} width={640} height={360} fit="cover" position="centre" format="webp" quality={70} loading="lazy" decoding="async" alt="Lubricant being applied to a mold guide post at Xinyinhai" /><figcaption>From the Xinyinhai factory record: mold guide-post care.</figcaption></figure>
        </section>
      </aside>
    </div>
    <section class="rfq-next" aria-labelledby="rfq-next-title">
      <div class="rfq-next-heading"><p class="rfq-eyebrow">AFTER WE RECEIVE YOUR BRIEF</p><h2 id="rfq-next-title">How your product brief is reviewed</h2><a href="/customization/how-we-work/">How we work <span aria-hidden="true">↗</span></a></div>
      <ol>{rfqSteps.map((step, index) => <li><span class="rfq-step-number">0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
      <p class="rfq-process-note">The review stages depend on your project. Scope, responsibilities and approvals are agreed before the next stage.</p>
    </section>
    <section class="rfq-faq" id="rfq-faq" aria-labelledby="rfq-faq-title">
      <div><p class="rfq-eyebrow">A FEW PRACTICAL ANSWERS</p><h2 id="rfq-faq-title">Product inquiry questions</h2><p>A short brief is a useful starting point. We can identify the missing information together.</p><a href="/customization/project-fit/">Project fit &amp; working principles <span aria-hidden="true">↗</span></a></div>
      <div class="rfq-faq-list">{rfqFaqs.map(faq => <details><summary>{faq.question}<Icon name="lucide:plus" aria-hidden="true" /></summary><p>{faq.answer}</p></details>)}</div>
    </section>
  </div></div>
</BaseLayout>
