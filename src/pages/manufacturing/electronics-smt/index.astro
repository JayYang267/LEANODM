---
import { SITE } from '@config/site';
import BaseLayout from '@layouts/BaseLayout.astro';
import ImageLightbox from '@components/ImageLightbox.astro';
import { Image, getImage } from 'astro:assets';
import oven from '../../../assets/electronics-smt/reflow-oven-body.jpg';
import aoi from '../../../assets/electronics-smt/aoi-inspection-bed.jpg';
import rack from '../../../assets/electronics-smt/board-tray.jpg';
import workflow from '../../../data/electronics-smt-workflow.json';
import defects from '../../../data/smt-defects.json';
import { smtNavigation, trainingMatrix, smtFaqs } from '../../../data/electronics-smt';
import '../../../styles/quality-control-process.css';
import '../../../styles/electronics-smt.css';

const title = 'Electronics Integration & SMT Assembly for Electronic Products | LEANODM.com';
const description = 'Xinyinhai’s in-house electronics development and SMT assembly for electronic toys and plastic electronic products, with documented printing, quality gates, maintenance and operator training.';
const route = '/manufacturing/electronics-smt/';
const origin = SITE.url;
const canonical = new URL(route, origin).href;
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Manufacturing', url: '/manufacturing/' }, { name: 'Electronics & SMT', url: route }];
const rawContact = import.meta.env.PUBLIC_CONTACT_URL?.trim() || '';
const contact = /^(https:\/\/[^\s]+|mailto:[^\s@]+@[^\s@]+)$/i.test(rawContact) ? rawContact : '';
const equipmentNames = [...new Set(workflow.maintenance.map(item => item.equipment))];
const equipment = equipmentNames.map(name => {
  const items = workflow.maintenance.filter(item => item.equipment === name);
  return { name, group: items[0].group, items, cycles: [...new Set(items.map(item => item.cycle))].join(' · ') };
});
const photos = await Promise.all([
  { image: oven, title: 'Reflow oven detail', caption: 'Machine-body detail from the archived workshop board. The board separately specifies paste- and PCB-dependent setup and a record after each setup.' },
  { image: aoi, title: 'AOI inspection bed', caption: 'Inspection-bed detail from the archived workshop board. AOI is shown in the single-sided and double-sided B routes.' },
  { image: rack, title: 'Board storage rack', caption: 'Storage detail from the archived workshop board. Its handling note specifies one PCB per rack layer; the applicable handling rule is reviewed for the job.' },
].map(async photo => ({ ...photo, full: await getImage({ src: photo.image, width: photo.image.width, format: 'webp', quality: 88 }) })));
const gateObjects = ['Process documents', 'PCB appearance', 'PCB installation', 'Screen-print result', 'Component placement', 'Post-oven board appearance', 'Depaneling result', 'Packaged boards', 'Warehouse entry'];
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description, inLanguage: 'en', isPartOf: { '@id': `${origin}/#website` }, about: { '@id': `${origin}/#xinyinhai` }, breadcrumb: { '@id': `${canonical}#breadcrumbs` }, mainEntity: { '@id': `${canonical}#service` } },
  { '@type': 'Service', '@id': `${canonical}#service`, name: 'Electronics integration and SMT assembly', serviceType: 'Electronics integration and printed circuit board assembly', description, url: canonical, provider: { '@id': `${origin}/#xinyinhai` } },
  { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumbs`, itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(item.url, origin).href })) },
] };
---

<BaseLayout title={title} description={description} technicalPage technicalNavigation={smtNavigation} technicalPageTitle="Electronics & SMT" contactHref="#project-requirements" technicalContactLabel="Prepare an Electronics RFQ" technicalFooterDescription="Share your project stage, board information, function and test requirements, quantity and target market.">
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL('/images/electronics-smt/overview.png', origin).href} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Electronics and SMT process illustration connecting PCB assembly to product integration" />
    <meta name="twitter:image" content={new URL('/images/electronics-smt/overview.png', origin).href} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
  </Fragment>

  <div class="qc-page smt-page">
    <section class="qc-hero" aria-labelledby="page-title">
      <div class="qc-container">
        <nav class="qc-breadcrumb" aria-label="Breadcrumb"><ol>{breadcrumbs.map((item, index) => <li>{index < breadcrumbs.length - 1 ? <a href={item.url}>{item.name}</a> : <span aria-current="page">{item.name}</span>}</li>)}</ol></nav>
        <div class="qc-hero-grid smt-hero-grid">
          <div>
            <p class="qc-eyebrow">MANUFACTURING / ELECTRONICS INTEGRATION</p>
            <h1 id="page-title">Electronics Integration &amp; SMT Assembly</h1>
            <p class="qc-lead">From the board to the product, with a defined manufacturing route.</p>
            <p class="qc-intro">Xinyinhai provides in-house electronics development and SMT assembly for electronic toys, interactive products and plastic products with electronics. Planned maintenance, internal training, automatic printing and inspection gates support consistent execution.</p>
            <p class="qc-intro">Start with the function you need and the board information you have. We review the board, housing, assembly and testing requirements together, then agree the project scope.</p>
            <div class="qc-actions"><a class="qc-button" href="#project-requirements">Prepare an Electronics RFQ <span aria-hidden="true">↗</span></a><a class="qc-text-link" href="#factory-evidence">Review factory evidence <span aria-hidden="true">↓</span></a></div>
          </div>
          <figure class="smt-hero-visual">
            <div class="smt-visual-heading"><span>BOARD → FINISHED PRODUCT</span><span>PROCESS OVERVIEW</span></div>
            <div class="smt-board-art" aria-hidden="true"><svg viewBox="630 100 560 495" focusable="false"><image href="/images/electronics-smt/overview.svg" width="1200" height="630" /></svg></div>
            <figcaption>Illustrative board-to-housing connection. The actual electronics, interfaces and test scope are defined for your product.</figcaption>
          </figure>
        </div>
        <div class="qc-hero-foot"><span>SMT &amp; PCB assembly</span><span>Documented setup &amp; exception routes</span><span>Board-to-product integration</span></div>
      </div>
    </section>

    <div class="qc-container">
      <div class="smt-glossary" aria-label="Electronics terminology"><p><strong>SMT</strong> — Surface Mount Technology places components on a board.</p><p><strong>PCB / PCBA</strong> — A printed circuit board / a board with components assembled.</p><p><strong>AOI</strong> — Automated optical inspection checks visible assembly features.</p></div>

      <section id="workflow" class="qc-section" aria-labelledby="workflow-title">
        <div class="qc-heading"><div><p class="qc-eyebrow">01 / DOCUMENTED PROCESS</p><h2 id="workflow-title">SMT Assembly Workflow &amp; Inspection Gates</h2></div><p>Printing and placement variation can travel downstream. The workshop board puts checks between operations and shows where a rejected board goes, including cleaning, correction and AOI reinspection.</p></div>
        <ol class="smt-main-flow">
          <li><span>01</span><h3>Receive &amp; check</h3><p>PCB intake and appearance inspection.</p><small>Appearance issue → IQC disposition</small></li>
          <li><span>02</span><h3>Print &amp; check</h3><p>Red adhesive where shown, then automatic solder-paste printing.</p><small>Inspect each print operation</small></li>
          <li><span>03</span><h3>Place &amp; check</h3><p>Component placement followed by pre-oven QC.</p><small>Exception → technical improvement</small></li>
          <li><span>04</span><h3>Reflow / cure</h3><p>Set parameters for the paste and PCB requirements.</p><small>Setup → parameter record</small></li>
          <li><span>05</span><h3>Inspect optically</h3><p>AOI on the single-sided and double-sided B routes.</p><small>Reject → repair → Return to AOI</small></li>
          <li><span>06</span><h3>Rack &amp; transfer</h3><p>Rack the boards for the next route or assembly handoff.</p><small>Double-sided A continues to B</small></li>
        </ol>
        <p class="qc-note">This overview summarizes the archived workshop routes. Red-adhesive printing and curing apply where shown. The detailed route, inspection coverage and current work instruction are reviewed for each board.</p>
        <details id="workflow-detail" class="smt-detail">
          <summary><span>Single-sided and double-sided A/B routes</span><small>All steps &amp; exception returns</small></summary>
          <div class="smt-detail-body">
            <div class="smt-route-grid">{workflow.routes.map((item, index) => <article><h3>{item.name}</h3><p class="smt-small">{index === 1 ? 'After racking, continue to double-sided B. No separate AOI gate is drawn on A.' : index === 2 ? 'Begins at the board feeder. No red-adhesive print step is drawn on B.' : 'Includes the red-adhesive branch and post-reflow AOI.'}</p><ol class="smt-route">{item.steps.map((step, stepIndex) => <li><span>{String(stepIndex + 1).padStart(2, '0')}</span>{step}</li>)}</ol></article>)}</div>
            <div class="smt-table-scroll" tabindex="0" aria-label="Workflow exception routes; scroll horizontally if needed"><table><caption>Workshop-board exception paths — reject unless stated otherwise</caption><thead><tr><th scope="col">Route</th><th scope="col">Decision</th><th scope="col">Action</th><th scope="col">Return / onward path</th></tr></thead><tbody>{workflow.exceptions.map(item => <tr><td>{item.route}</td><th scope="row">{item.gate}{item.branch === 'Y' ? ' — correction accepted' : ''}</th><td>{item.action}</td><td>{item.returns_to || 'No return is drawn'}</td></tr>)}</tbody></table></div>
            <p class="qc-source-note">Source: archived SMT production workshop board, single-sided and double-sided A/B diagrams. On single-sided/A, both adhesive- and solder-paste-print rejects wash and return to red-adhesive printing. On B, a paste-print reject returns through the board feeder. AOI rejects are repaired and returned to AOI for reinspection.</p>
          </div>
        </details>

        <div class="smt-gate-strip"><strong>Separate quality-control reference</strong><p>Technical documents → board checks → print and placement checks → post-oven appearance → depaneling → packaging → ERP warehouse entry.</p></div>
        <details id="quality-gates-detail" class="smt-detail">
          <summary><span>Quality gates and disposition</span><small>9 nodes · separate source chart</small></summary>
          <div class="smt-detail-body">
            <div class="smt-table-scroll" tabindex="0" aria-label="Quality control reference table"><table><caption>Quality-control chart — node, object, normal flow and exception</caption><thead><tr><th scope="col">Node</th><th scope="col">Object / activity</th><th scope="col">Accepted / normal flow</th><th scope="col">Exception path</th></tr></thead><tbody>{workflow.gates.map((item, index) => <tr><th scope="row">{item.node}</th><td>{gateObjects[index]}</td><td>{item.next}{item.decision ? ' (OK)' : ''}</td><td>{item.exception || 'No exception is drawn'}{item.branch === 'Unlabelled right branch' ? '' : item.branch ? ` (${item.branch})` : ''}</td></tr>)}</tbody></table></div>
            <p class="qc-note">The PCB-installation branch returns to the warehouse, but its condition is not labelled. The quality chart sends print rejects to the warehouse; the workshop routes show washing and reprinting. These remain separate references. Their applicable conditions require project review.</p>
            <p class="qc-source-note">Source: archived SMT production quality-control chart. No additional recheck loop is drawn here. ERP warehouse entry is the stated final node.</p>
          </div>
        </details>
        <a class="qc-text-link" href="/quality/quality-control-process/">Explore factory Quality Control responsibilities <span aria-hidden="true">↗</span></a>
      </section>

      <section id="automatic-printing" class="qc-section" aria-labelledby="printing-title">
        <div class="qc-heading"><div><p class="qc-eyebrow">02 / AUTOMATIC SOLDER-PASTE PRINTING</p><h2 id="printing-title">Automatic Solder-Paste Printing Setup</h2></div><p>The automatic printer reduces reliance on hand printing. Operators still prepare the setup, add paste, confirm the print and arrange repairs. The aim is repeatable execution with visible quality decisions.</p></div>
        <div class="smt-print-visual">
          <div class="smt-print-band"><span>OPERATOR SETUP</span><span>AUTOMATIC RUN</span><span>QUALITY CONFIRMATION</span></div>
          <ol class="smt-print-phases"><li><span>01 / START</span><strong>Power &amp; self-check</strong><p>Start DSA control software and verify the system.</p></li><li><span>02 / PREPARE</span><strong>Rails, stencil &amp; squeegee</strong><p>Set width, align the stencil and prepare cleaning and paste.</p></li><li><span>03 / RUN</span><strong>Execute the print</strong><p>Run the automatic solder-paste printing operation.</p></li><li><span>04 / VERIFY</span><strong>Confirm, then produce</strong><p>Check the print result before continuing production.</p></li></ol>
          <div class="smt-faults"><p><strong>Self-check fails</strong><span>Power off → technical repair → restart from power on</span></p><p><strong>Print result fails</strong><span>Fine-adjust stencil → confirm print quality again</span></p></div>
        </div>
        <details id="printing-detail" class="smt-detail"><summary><span>The complete 11-step printer startup</span><small>Including cleaning-paper setup</small></summary><div class="smt-detail-body"><ol class="smt-numbered-steps">{workflow.printer.map((step, index) => <li data-print-step={index + 1}><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong></li>)}</ol><p class="qc-note">Cleaning frequency is set during preparation; the source supplies no fixed interval. DSA is the control-software label used in the archived diagram. The job’s paste, stencil and setup requirements determine the applicable settings.</p><p class="qc-source-note">Source: standalone automatic-printer flow. The workshop-board version ends with transfer to the placement machine and does not separately draw the cleaning-paper/frequency step.</p></div></details>
        <details class="smt-detail"><summary><span>Board-feeder and placement-machine preparation</span><small>Workshop-board startup references</small></summary><div class="smt-detail-body"><div class="smt-route-grid smt-two-routes">{(['feeder', 'placement'] as const).map(name => <article><h3>{name === 'feeder' ? 'Board feeder' : 'Component placement machine'}</h3><ol class="smt-route">{workflow.preflight[name].steps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{step}</li>)}</ol><p class="qc-note">{name === 'feeder' ? 'If the board does not fit, return to widening or narrowing the rail.' : 'A failed self-check leads to power-off and technical repair, then a restart. A failed placement confirmation returns to placement-coordinate setup.'}</p></article>)}</div><details class="smt-detail"><summary>Printer transfer sequence on the workshop board</summary><div class="smt-detail-body"><ol class="smt-route">{workflow.preflight.printer.steps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{step}</li>)}</ol><p class="smt-small">The same self-check repair/restart and print-adjustment/reconfirmation paths are drawn. This separate version has 10 steps and ends in board transfer.</p></div></details></div></details>
      </section>

      <section id="maintenance" class="qc-section" aria-labelledby="maintenance-title">
        <div class="qc-heading"><div><p class="qc-eyebrow">03 / EQUIPMENT MAINTENANCE &amp; 5S</p><h2 id="maintenance-title">SMT Equipment Maintenance Planning</h2></div><p>Equipment wear, dirt and disorder can affect execution. The preventive maintenance plan identifies equipment, parts and cycles. Training also addresses workplace organization and careful material handling.</p></div>
        <div class="smt-maintenance-summary"><div><strong>7</strong><span>equipment categories</span></div><div><strong>26</strong><span>planned maintenance items</span></div><div><strong>3 cycles</strong><span>monthly · half-yearly · annual</span></div></div>
        <div class="smt-equipment-groups">{['SMT', 'Related IC process'].map((group, groupIndex) => <div><h3>{groupIndex === 0 ? 'SMT equipment' : 'Related IC bonding & dispensing equipment'}</h3><p class="smt-small">{groupIndex === 0 ? 'Printing, placement, reflow and optical inspection.' : 'Separate process categories; these are not mandatory steps for every SMT board.'}</p><dl>{equipment.filter(item => groupIndex === 0 ? item.group === 'SMT' : item.group !== 'SMT').map(item => <div><dt>{item.name}</dt><dd>{item.cycles}<small>{item.items.length} planned items</small></dd></div>)}</dl></div>)}</div>
        <p class="qc-note"><strong>Plan status:</strong> monthly items are planned each month; half-yearly work is planned in June and December; annual work in December. The source year is blank and all implementation cells are blank. This is a maintenance plan; current condition, completion and availability are confirmed during production planning.</p>
        <p>See component placement, AOI, die and wire bonding, and selective soldering examples in the <a class="qc-text-link" href="/capabilities/production-equipment/#electronics">electronics equipment overview <span aria-hidden="true">↗</span></a>.</p>
        <details id="maintenance-detail" class="smt-detail"><summary><span>All 26 maintenance items and planned cycles</span><small>Complete English reference</small></summary><div class="smt-detail-body"><div class="smt-table-scroll" tabindex="0" aria-label="Complete maintenance plan"><table><caption>Preventive maintenance plan — equipment, item and cycle</caption><thead><tr><th scope="col">Equipment</th><th scope="col">Planned item</th><th scope="col">Cycle</th><th scope="col">Planned months</th></tr></thead><tbody>{workflow.maintenance.map((item, index) => <tr data-maintenance-item={index + 1} data-equipment={item.equipment} data-cycle={item.cycle}><th scope="row">{item.equipment}</th><td>{item.item}</td><td>{item.cycle}</td><td>{item.cycle === 'Monthly' ? 'Every month' : item.cycle === 'Half-yearly' ? 'June and December' : 'December'}</td></tr>)}</tbody></table></div><p class="qc-source-note">Source: archived annual SMT and bonding maintenance plan. Part-only entries remain part names; they do not imply a specific replacement or calibration action. “Nozzle / prism” normalizes the source spelling. The precise bonding-machine subtype is not specified.</p></div></details>
        <div class="smt-management"><article><h3>5S &amp; standard work</h3><p>Training connects sorting, orderly placement, cleaning, standardization and discipline to the work area. Storage examples and maintenance planning support that approach; they do not by themselves document a completed 5S audit.</p></article><article><h3>4M change awareness</h3><p>The plan also lists changes in people, methods, materials and machines. Recognizing a change helps identify what must be checked before the next run.</p></article><article><h3>Five-leak management</h3><p>A separate note covers water, electricity, oil, air and materials. These five leak categories are distinct from 5S workplace organization.</p></article></div>
        <section id="factory-evidence" class="smt-evidence" aria-labelledby="evidence-title"><div class="smt-evidence-heading"><div><p class="qc-eyebrow">FACTORY EVIDENCE / ARCHIVED WORKSHOP BOARD</p><h3 id="evidence-title">Equipment and storage details</h3></div><p>Selected, de-identified photo crops from the supplied workshop board. These show documented details; current equipment configuration is confirmed for the project.</p></div><div class="smt-photo-grid">{photos.map(photo => <figure><a href={photo.full.src} data-lightbox="smt-workshop" data-width={photo.image.width} data-height={photo.image.height} data-title={photo.title} data-caption={photo.caption} data-source="Archived workshop-board photograph; de-identified crop" aria-label={`Enlarge ${photo.title.toLowerCase()}`}><div class="smt-photo-frame"><Image src={photo.image} width={photo.image.width} format="webp" quality={88} alt={photo.title + ' from the archived workshop board'} loading="lazy" /></div><span>Enlarge detail <span aria-hidden="true">↗</span></span></a><figcaption><strong>{photo.title}</strong>{photo.caption}</figcaption></figure>)}</div></section>
      </section>

      <section id="training" class="qc-section" aria-labelledby="training-title">
        <div class="qc-heading"><div><p class="qc-eyebrow">04 / TRAINING, STANDARD WORK &amp; RECORDS</p><h2 id="training-title">Make the operator’s decisions consistent</h2></div><p>Xinyinhai conducts internal SMT training. The reviewed materials provide topics and methods for recognizing risks, following setup instructions and reporting abnormal results.</p></div>
        <div class="smt-table-scroll" tabindex="0" aria-label="SMT training topic matrix"><table class="smt-training-table"><caption>Training topics and their connection to the work</caption><thead><tr><th scope="col">Training topic</th><th scope="col">Related operation</th><th scope="col">Risk addressed</th><th scope="col">Document / check basis</th></tr></thead><tbody>{trainingMatrix.map(item => <tr><th scope="row">{item.topic}</th><td>{item.operation}</td><td>{item.risk}</td><td>{item.basis}</td></tr>)}</tbody></table></div>
        <div class="smt-record"><span>DOCUMENTED RECORD REQUIREMENT</span><h3>Reflow setup → a retained parameter record</h3><p>The workshop board requires the supervisor to set parameters before production according to the solder-paste type and PCB thickness and size. After each setup, the parameters are recorded in the reflow-oven setup-parameter record and retained in the workshop.</p><p class="smt-small">This is a documented requirement. No completed setup record is reproduced here, and historical temperature examples are not presented as a universal production profile.</p></div>
        <p class="qc-source-note">Training references are consolidated from the supplied materials, including general and third-party teaching content. They are evidence of training topics, rather than completed sign-ins, assessments, certification or measured defect reduction. Material-change checks and stencil identity/status checks are useful project-specific standard-work controls; their exact instruction and record format are agreed for the job.</p>
        <a class="qc-text-link" href="/quality/inspector-training/">See the wider Inspector Training framework <span aria-hidden="true">↗</span></a>
      </section>

      <section id="defect-analysis" class="qc-section" aria-labelledby="defect-title">
        <div class="qc-heading"><div><p class="qc-eyebrow">05 / VISUAL DEFECT ANALYSIS</p><h2 id="defect-title">SMT Defect Recognition &amp; Cause Analysis</h2></div><p>Visual examples give operators and technical staff a shared vocabulary. The eight training fishbones organize potential causes for discussion; investigation and verification are still needed to identify a root cause.</p></div>
        <div class="smt-defect-preview"><span>8 defect types</span><p>Upside-down placement · displacement · poor wetting · open joint · bridging · missing component · tombstoning · component on its side</p></div>
        <details id="defect-library" class="smt-detail smt-defect-library"><summary><span>Explore all eight training fishbone diagrams</span><small>English diagrams, examples &amp; readable factor lists</small></summary><div class="smt-detail-body">
          <p class="smt-small">The source’s branch arrangement is preserved: Environment, People and Materials above; Methods and Equipment below, each in its original left-to-right order. The backbone points right. Use horizontal scrolling or the image viewer to inspect the diagram; all factors are also listed below it.</p>
          {defects.map(defect => <details id={`defect-${defect.id}`} name="smt-defect" data-defect-panel={defect.sequence} class="smt-detail smt-defect-panel"><summary><span><b>{String(defect.sequence).padStart(2, '0')}</b>{defect.title}<small>{defect.definition}</small></span></summary><div class="smt-detail-body"><figure><div class="smt-fishbone-scroll" tabindex="0" aria-label={`${defect.title} diagram; scroll horizontally to read`}><a href={`/images/electronics-smt/${defect.svg}`} data-lightbox="smt-defects" data-width={defect.width} data-height={defect.height} data-title={defect.title} data-caption="Training analysis of potential causes. Original branch positions, causal connections and sample positions are preserved." data-source={`English derivative of the supplied SMT defect-training diagram, slide ${defect.sequence}`} aria-label={`Enlarge ${defect.title.toLowerCase()} diagram`}><img src={`/images/electronics-smt/${defect.svg}`} width={defect.width} height={defect.height} loading="lazy" decoding="async" alt={`${defect.title} training fishbone with potential causes across Environment, People, Materials, Methods and Equipment`} /></a></div><figcaption>Training diagram {defect.sequence} · <a href={`/images/electronics-smt/${defect.svg}`} data-lightbox="smt-defects" data-width={defect.width} data-height={defect.height} data-title={defect.title} data-caption="Training hypotheses, not confirmed factory incidents or root causes." data-source={`English derivative, slide ${defect.sequence}`}>Open zoomable diagram <span aria-hidden="true">↗</span></a></figcaption></figure><h3>Potential causes, by original branch</h3><div class="smt-factor-grid">{defect.branches.map(branch => <div><h4>{branch.name}<small>{branch.position === 'top' ? 'Upper branch' : 'Lower branch'}</small></h4><ul>{branch.factors.map(factor => <li data-defect-factor>{factor}</li>)}</ul></div>)}</div>{defect.uncertainSourceNote && <p class="qc-note">{defect.uncertainSourceNote}</p>}</div></details>)}
          <p class="qc-source-note">English derivatives of the eight supplied training diagrams, in original slide order. Their labels describe potential causes rather than factory incidents, verified root causes or improvement results. Sample photos are de-identified teaching details.</p>
        </div></details>
      </section>

      <section id="integration" class="qc-section" aria-labelledby="integration-title">
        <div class="qc-heading"><div><p class="qc-eyebrow">06 / ELECTRONICS INTEGRATION</p><h2 id="integration-title">Connect the PCBA to the whole product</h2></div><p>Board assembly is one part of an electronic product. Housing fit, connectors, wiring, controls and functional requirements need to be considered together before the finished-product route is set.</p></div>
        <div class="smt-integration"><article><span>DEFINE</span><h3>Function &amp; board requirements</h3><p>Review the intended interaction, power, interfaces, board information and acceptance criteria. Agree electronics design, firmware and sourcing responsibilities for the project.</p><a href="/customization/new-product-development/">New Product Development ↗</a></article><article><span>CONNECT</span><h3>Housing &amp; assembly</h3><p>Coordinate board mounting, enclosure features, wire paths and the required assembly operations, including fastening or hand soldering where applicable.</p><a href="/manufacturing/tooling-injection-molding/">Tooling &amp; Injection Molding ↗</a><a href="/manufacturing/assembly-packaging/">Assembly &amp; Packaging ↗</a></article><article><span>VERIFY</span><h3>Product-specific checks</h3><p>Define function and test requirements for the finished product. Board AOI supports the assembly checks; finished-product function and acceptance need their own criteria.</p><a href="/quality/product-testing/">Product Testing ↗</a><a href="/quality/quality-control-process/">Quality Control Process ↗</a></article></div>
        <aside class="qc-note"><h3>Protect firmware as part of production preparation</h3><p>Encrypted firmware installation, key management, chip read protection and authorized programming quantities are coordinated with the product’s chip and toolchain. Review <a href="/manufacturing/secure-programming/">Secure Programming &amp; Firmware Protection</a> before releasing a production package. Source code, production firmware and encrypted packages have distinct access and handover requirements.</p></aside>
      </section>

      <section id="faq" class="qc-section" aria-labelledby="faq-title"><div class="qc-heading"><div><p class="qc-eyebrow">BUYER QUESTIONS</p><h2 id="faq-title">Before you send an electronics RFQ</h2></div><p>Clarify the board, the finished-product requirements and the responsibilities to assess during the project review.</p></div><div class="smt-faqs">{smtFaqs.map(faq => <details class="smt-detail"><summary>{faq.question}</summary><div class="smt-detail-body"><p>{faq.answer}</p></div></details>)}</div></section>

      <section id="project-requirements" class="qc-section smt-project" aria-labelledby="project-title">
        <div><p class="qc-eyebrow">START WITH THE INFORMATION YOU HAVE</p><h2 id="project-title">Prepare your electronics project brief</h2><p>Begin with a non-sensitive overview of the function, test requirements, quantity, target market and project stage. Detailed BOM, PCB/Gerber, firmware and key material follow through the agreed confidential exchange.</p><div class="qc-actions"><a class="qc-button" href="/resources/electronics-smt-project-brief.txt" download>Download the RFQ brief <span aria-hidden="true">↓</span></a><a class="qc-text-link" href="/rfq/?source=manufacturing-electronics-smt#rfq-form">Discuss your electronics project <span aria-hidden="true">↗</span></a>{contact && <a class="qc-text-link" href={contact}>Send your project requirements <span aria-hidden="true">↗</span></a>}</div><p class="smt-small">Review the <a href="/customization/ip-protection/nda-project-start/">confidential project start process</a> or <a href="/rfq/?nda=1#rfq-form">request an NDA discussion before sharing detailed files</a>. Downloading the brief does not submit an inquiry. MOQ, lead time, current equipment availability and delivery scope require project review.</p></div>
        <dl class="smt-project-stages"><div><dt>Concept stage</dt><dd>Send a non-sensitive functional brief, target market and expected quantity.</dd></div><div><dt>Existing product or board</dt><dd>Describe the board and adaptation or integration you need; share restricted references after the exchange is agreed.</dd></div><div><dt>Ready-to-build design</dt><dd>Identify the available files and revisions. Transfer detailed BOM, PCB/Gerber, placement files and test criteria through the agreed channel.</dd></div></dl>
      </section>
