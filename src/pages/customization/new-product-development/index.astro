---
import CustomizationPage from '../../../layouts/CustomizationPage.astro';
import CustomizationSection from '../../../components/CustomizationSection.astro';
import CustomizationIcon from '../../../components/CustomizationIcon.astro';
import CustomizationFlow from '../../../components/CustomizationFlow.astro';
import CustomizationFigure from '../../../components/CustomizationFigure.astro';
import moldPhoto from '../../../assets/tooling-injection-molding/mold-guide-maintenance.jpg';
import { page } from '../../../data/customization/new-product-development';

const stages = [
  { number: '01', title: 'Requirements and feasibility', text: 'Define users, use conditions, essential functions and acceptance needs. Assess the proposed approach, key parts, risks and open questions.', decision: 'Agree the brief and the work needed to resolve uncertainty.' },
  { number: '02', title: 'Concept and engineering', text: 'Develop the selected direction into mechanical and applicable electronic design. Review interfaces, materials, assembly and the information needed for a sample.', decision: 'Review the concept and drawings before the next build.' },
  { number: '03', title: 'Prototype and DFM', text: 'Use prototypes to examine form, fit and function. Review design for manufacture and assembly, including molded features, joining, inspection access and production testing.', decision: 'Confirm corrections and the design proposed for tooling.' },
  { number: '04', title: 'Tooling and trial builds', text: 'Prepare the agreed tools and components. Evaluate tool-made samples for dimensions, appearance, assembly and function, then review corrections and repeat trials where needed.', decision: 'Approve the trial results and design-release information.' },
  { number: '05', title: 'Pilot production (PP)', text: 'Run the planned production process with the applicable materials, instructions, fixtures and checks. Review defects, process readiness, packaging and unresolved trial issues.', decision: 'Close release issues and confirm readiness for volume production.' },
  { number: '06', title: 'Mass production (MP)', text: 'Release production against the approved specification and sample. Apply the agreed incoming, process and finished-product controls, with shipment review and issue feedback.', decision: 'Confirm the required release evidence and delivery arrangements.' },
];
const gateRows = [
  ['Brief and design direction', 'Requirements, intended use, proposed solution and unresolved assumptions.', 'Confirm priorities, scope and the direction to develop.'],
  ['Prototype and tooling decision', 'Sample findings, revised drawings, DFM recommendations and testing needs.', 'Approve the design basis and authorized tooling work.'],
  ['Design and pilot review', 'Trial results, approved materials, key dimensions, process checks and open issues.', 'Agree the production baseline and release conditions.'],
];
const stageIcons = ['clipboard-list', 'pencil-ruler', 'box', 'wrench', 'settings', 'factory'];
const developmentFlow = [
  { title: 'Idea', icon: 'lightbulb' },
  { title: 'Requirements', icon: 'clipboard-list' },
  { title: 'Concept', icon: 'pencil-ruler' },
  { title: 'Engineering', icon: 'circuit-board' },
  { title: 'Prototype', icon: 'box' },
  { title: 'Tooling', icon: 'wrench' },
  { title: 'Validation', icon: 'clipboard-check' },
  { title: 'Pilot run', icon: 'settings' },
  { title: 'Mass production', icon: 'factory' },
];
const briefInputs = [
  { icon: 'users', title: 'Intended user', text: 'Who handles the product?' },
  { icon: 'map-pin', title: 'Use conditions', text: 'Where and how is it used?' },
  { icon: 'sliders-horizontal', title: 'Core functions', text: 'What must it do?' },
];
---
<CustomizationPage page={page}>
  <CustomizationSection id="product-brief" eyebrow="DEFINE THE PRODUCT" title="A useful brief explains the experience the product must deliver" intro="Technical choices follow the purpose, users and conditions of use.">
    <div class="npd-brief-inputs" aria-label="Inputs to the product brief">
      {briefInputs.map(item => <div><CustomizationIcon name={item.icon} /><div><strong>{item.title}</strong><span>{item.text}</span></div></div>)}
    </div>
    <div class="b2b-comparison npd-brief-panels">
      <div class="b2b-panel"><CustomizationIcon name="pencil-ruler" /><p>Describe what the user should be able to do, how the product will be handled and where it will be used. Identify essential functions, size or handling constraints, appearance expectations and packaging needs. Separate confirmed requirements from ideas that need investigation.</p></div>
      <div class="b2b-panel b2b-panel--tint"><CustomizationIcon name="circuit-board" /><p>For an electronic product, explain the expected interaction and power arrangement as far as they are known. Sound, light, buttons, movement or sensing each introduce design and test considerations. More complex connectivity or software needs a separately defined scope and responsibility.</p></div>
    </div>
    <p>Feasibility review identifies practical constraints, information gaps and the next evidence needed. If an existing design already meets the core need, <a href="/customization/product-adaptation/">Product Adaptation</a> may provide a more suitable starting point.</p>
  </CustomizationSection>

  <CustomizationSection id="development-stages" eyebrow="PLAN THE PROGRESSION" title="New Product Development Stages" intro="The scope determines which stages apply and what evidence is needed to move forward.">
    <div class="npd-route-overview">
      <span class="b2b-visual-label">THE DEVELOPMENT ROUTE AT A GLANCE</span>
      <CustomizationFlow label="Idea through new product development and production" steps={developmentFlow} compact />
    </div>
    <div class="npd-timeline-heading"><span class="b2b-visual-label">STAGE REVIEWS</span><span>Work to complete</span><span>Decision before progressing</span></div>
    <ol class="npd-timeline" aria-label="Detailed development stages and review decisions">
      {stages.map((stage, index) => <li class="npd-stage"><div class="npd-stage-node"><CustomizationIcon name={stageIcons[index]} /><span>{stage.number}</span></div><div class="npd-stage-work"><h3>{stage.title}</h3><p>{stage.text}</p></div><div class="npd-stage-decision"><CustomizationIcon name="badge-check" /><p><strong>Review decision</strong>{stage.decision}</p></div></li>)}
    </ol>
    <p class="qc-note">Development is iterative. Prototype results can change the design, and tooling trials can lead to further corrections. The number of builds and approval points is agreed around the product's risks and remaining questions.</p>
  </CustomizationSection>

  <CustomizationSection id="approval-gates" eyebrow="MAKE THE NEXT DECISION" title="Reviews connect design evidence with customer approval" intro="Each gate should make the current revision and outstanding actions clear.">
    <div class="npd-gates" aria-label="Customer decisions during new product development">
      {gateRows.map((row, index) => <article class="npd-gate"><div class="npd-gate-heading"><span>GATE {String(index + 1).padStart(2, '0')}</span><CustomizationIcon name={['clipboard-list', 'box', 'factory'][index]} /></div><span class="b2b-visual-label">REVIEW POINT</span><h3>{row[0]}</h3><div class="npd-gate-evidence"><strong>Evidence to examine</strong><p>{row[1]}</p></div><div class="npd-gate-decision"><CustomizationIcon name="badge-check" /><div><strong>Customer decision</strong><p>{row[2]}</p></div></div></article>)}
    </div>
    <div class="b2b-comparison">
      <div class="b2b-panel b2b-panel--tint"><CustomizationIcon name="file-check" /><p>A review record identifies the version, findings, action owners and decision. Consolidated feedback helps engineering resolve the same requirement consistently across appearance, mechanics, electronics and packaging.</p></div>
      <div class="b2b-panel"><CustomizationIcon name="git-compare-arrows" /><p>After design approval, changes are assessed against that baseline. We confirm effects on samples, tooling, validation, cost and timing before carrying the revision into the next stage.</p></div>
    </div>
    <h3>Document the evidence behind the decision</h3>
    <p>Xinyinhai’s documented design procedure connects the product specification, stage reviews, sample tests and pilot findings. The project plan identifies which records apply to the agreed development scope.</p>
    <div class="b2b-icon-cards">
      <article class="b2b-icon-card"><CustomizationIcon name="clipboard-list" /><span class="b2b-visual-label">DESIGN INPUT</span><h3>Specification and responsibilities</h3><p>Record technical requirements, intended use, applicable safety requirements, cost assumptions and timing. Review the inputs and identify the responsible engineers, stage deliverables and review points.</p></article>
      <article class="b2b-icon-card"><CustomizationIcon name="box" /><span class="b2b-visual-label">SAMPLE REVIEW</span><h3>Findings and customer confirmation</h3><p>Review sample test findings before customer confirmation and retain an identified reference sample. A changed sample returns to the relevant testing and review before it becomes the new reference.</p></article>
      <article class="b2b-icon-card"><CustomizationIcon name="file-check" /><span class="b2b-visual-label">FINAL DESIGN REVIEW</span><h3>Pilot evidence and design confirmation</h3><p>Bring the design inputs, drawings, test reports, stage reviews and applicable pilot report together. Confirm the design and resolve the release conditions before production relies on it.</p></article>
    </div>
    <p class="qc-note">A prototype demonstrates the characteristics it was built to evaluate. A generic check sheet describes a method; project-specific findings and recorded decisions establish what was reviewed and accepted.</p>
  </CustomizationSection>

  <CustomizationSection id="production-readiness" eyebrow="PREPARE FOR MANUFACTURING" title="Production Readiness & Engineering Handover" intro="An approved prototype is one part of the evidence for production readiness.">
    <div class="b2b-icon-cards npd-deliverables">
      <article class="b2b-icon-card"><CustomizationIcon name="files" /><span class="b2b-visual-label">DESIGN INFORMATION</span><h3>Product definition</h3><p>Bring the relevant drawings, BOM, material approvals, finishes and key dimensions into a consistent revision. Identify the approved sample and the characteristics it represents.</p></article>
      <article class="b2b-icon-card"><CustomizationIcon name="wrench" /><span class="b2b-visual-label">MANUFACTURING INFORMATION</span><h3>Process preparation</h3><p>Review assembly instructions, fixtures and test methods. Consider wrong-part assembly, wire interference, product protection and access for inspection in the actual production sequence.</p></article>
      <article class="b2b-icon-card"><CustomizationIcon name="clipboard-check" /><span class="b2b-visual-label">VALIDATION INFORMATION</span><h3>Pilot findings</h3><p>Evaluate production issues and the effectiveness of corrective action. Check packaging, material consistency and the agreed product tests before confirming release conditions.</p></article>
    </div>
    <div class="b2b-media-split npd-readiness-media">
      <CustomizationFigure src={moldPhoto} alt="Lubricant being applied to a mold guide post during maintenance at Xinyinhai" caption="Xinyinhai factory reference: mold guide-post maintenance. Tool condition is reviewed as part of production preparation." />
      <div class="b2b-panel b2b-panel--tint npd-release-review"><CustomizationIcon name="shield-check" /><span class="b2b-visual-label">PRODUCTION RELEASE REVIEW</span><p>Safety and reliability requirements depend on the product, users and intended markets. The project plan identifies the applicable checks and any external testing or specialist work needed. The release decision uses those agreed requirements.</p><p>See the <a href="/manufacturing/tooling-injection-molding/">tooling and injection molding process</a> for preparation, trials and repeat-production controls.</p></div>
    </div>
    <p>The release package uses controlled versions of the bill of materials (BOM), technical drawings (DWG), operating instructions (SOP) and inspection instructions (SIP), as applicable. Document control distributes approved revisions and withdraws obsolete internal copies. See <a href="/quality/">Xinyinhai’s quality management system</a> for the controls connecting engineering records with production.</p>
  </CustomizationSection>
</CustomizationPage>

<style>
  .npd-brief-inputs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; margin-bottom:22px; }
  .npd-brief-inputs>div { display:flex; align-items:center; gap:14px; padding:18px 20px; border:1px solid #d7e1ed; border-radius:6px; }
  .npd-brief-inputs strong,.npd-brief-inputs span { display:block; }
  .npd-brief-inputs strong { color:#1e4168; font-size:.88rem; margin-bottom:4px; }
  .npd-brief-inputs span { color:#617286; font-size:.76rem; }
  .npd-brief-panels { margin-bottom:22px; }
  .npd-route-overview { padding:24px; border:1px solid #cbd9e8; border-radius:7px; background:#f3f7fc; margin-bottom:28px; }
  .npd-timeline-heading { display:grid; grid-template-columns:70px minmax(0,1.45fr) minmax(0,1fr); gap:24px; padding:0 22px 12px; align-items:end; }
  .npd-timeline-heading>span { color:#62758b; font-size:.65rem; text-transform:uppercase; letter-spacing:.06em; line-height:1.6; }
  .npd-timeline { list-style:none; padding:0; margin:0; position:relative; }
  .npd-timeline::before { content:''; position:absolute; left:56px; top:35px; bottom:65px; width:2px; background:#bbcde2; }
  .npd-stage { display:grid; grid-template-columns:70px minmax(0,1.45fr) minmax(0,1fr); gap:24px; align-items:center; padding:24px 22px; position:relative; border-top:1px solid #dce5ef; }
  .npd-stage:last-child { border-bottom:1px solid #dce5ef; }
  .npd-stage-node { position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px; width:70px; min-height:74px; background:#eef4fb; border:1px solid #b8cce4; border-radius:6px; color:#2c5b8e; }
  .npd-stage-node>span { font-size:.65rem; font-weight:750; letter-spacing:.08em; }
  .npd-stage-work h3 { color:#1c3d63; font-size:1.05rem; margin:0 0 9px; }
  .npd-stage-work p { color:#52677f; font-size:.86rem; line-height:1.75; margin:0; }
  .npd-stage-decision { display:flex; gap:13px; align-items:flex-start; background:#f0f5fb; border-left:3px solid #6289b7; border-radius:0 5px 5px 0; padding:18px; }
  .npd-stage-decision p { font-size:.8rem; color:#496481; margin:0; line-height:1.75; }
  .npd-stage-decision strong { display:block; font-size:.6rem; letter-spacing:.08em; color:#2b537f; text-transform:uppercase; margin-bottom:6px; }
  .npd-stage-decision :global(svg) { width:22px; height:22px; flex-shrink:0; }
  .npd-gates { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; margin-bottom:24px; }
  .npd-gate { border:1px solid #cfdae8; border-radius:7px; overflow:hidden; display:flex; flex-direction:column; padding:22px 22px 0; background:#fff; }
  .npd-gate-heading { display:flex; align-items:center; justify-content:space-between; color:#2c598c; margin-bottom:20px; }
  .npd-gate-heading>span { font-size:.65rem; letter-spacing:.08em; font-weight:750; }
  .npd-gate h3 { color:#1e3e63; font-size:1rem; line-height:1.5; margin:8px 0 20px; }
  .npd-gate-evidence { flex:1; margin-bottom:20px; }
  .npd-gate-evidence>strong,.npd-gate-decision strong { display:block; font-size:.65rem; letter-spacing:.03em; text-transform:uppercase; color:#446382; margin-bottom:7px; }
  .npd-gate p { color:#586d83; font-size:.82rem; line-height:1.75; margin:0; }
  .npd-gate-decision { display:flex; gap:10px; background:#eaf1f9; border-top:1px solid #d3dfed; margin-inline:-22px; padding:18px 22px; }
  .npd-gate-decision :global(svg) { width:22px; height:22px; flex-shrink:0; }
  .npd-deliverables { margin-bottom:24px; }
  .npd-readiness-media { align-items:stretch; }
  .npd-release-review { display:flex; flex-direction:column; justify-content:center; }
  .npd-readiness-media :global(img) { aspect-ratio:4 / 3; object-position:50% 60%; }
  @media(max-width:959px) {
    .npd-stage,.npd-timeline-heading { grid-template-columns:60px minmax(0,1.25fr) minmax(0,1fr); gap:17px; padding-inline:12px; }
    .npd-stage-node { width:60px; min-height:68px; }
    .npd-timeline::before { left:41px; }
    .npd-gates { gap:14px; }
    .npd-gate { padding:18px 18px 0; }
    .npd-gate-decision { margin-inline:-18px; padding:16px 18px; }
    .npd-brief-inputs>div { padding:16px 14px; gap:10px; }
  }
  @media(max-width:699px) {
    .npd-brief-inputs,.npd-gates { grid-template-columns:1fr; }
    .npd-route-overview { padding:18px; }
    .npd-timeline-heading { display:none; }
    .npd-stage { grid-template-columns:50px minmax(0,1fr); gap:14px; padding:22px 0; align-items:start; }
    .npd-stage-node { grid-row:span 2; width:50px; min-height:64px; }
    .npd-stage-node :global(svg) { width:23px; height:23px; }
    .npd-timeline::before { left:24px; bottom:100px; }
    .npd-stage-decision { grid-column:2; padding:14px; }
    .npd-stage-work h3 { font-size:.98rem; }
  }
</style>
