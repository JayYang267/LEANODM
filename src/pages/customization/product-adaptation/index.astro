---
import CustomizationPage from '../../../layouts/CustomizationPage.astro';
import CustomizationSection from '../../../components/CustomizationSection.astro';
import CustomizationIcon from '../../../components/CustomizationIcon.astro';
import CustomizationFlow from '../../../components/CustomizationFlow.astro';
import CustomizationFigure from '../../../components/CustomizationFigure.astro';
import gapPhoto from '../../../../public/images/quality/appearance-inspection/assembled-parts-gap.webp';
import { page } from '../../../data/customization/product-adaptation';

const reviewRows = [
  ['Structure and assembly', 'Clearance, movement, fasteners, joining, part orientation and access for assembly.', 'Which interfaces and drawings change, and how fit and operation will be checked.'],
  ['Materials and components', 'Material compatibility, part performance, finish, dimensional behavior and replacement availability.', 'An approved material or component choice with the verification it needs.'],
  ['Electronics and power', 'Affected circuit behavior, PCB fit, wiring, switches, battery retention and production test access.', 'Applicable electrical checks and confirmation that required functions remain consistent.'],
  ['Tooling and process', 'Mold features, assembly sequence, fixtures, inspection and packing implications.', 'The proposed production changes and any tooling work requiring approval.'],
];
const reviewIcons = ['scan', 'boxes', 'circuit-board', 'wrench'];
const validationChecks = [
  { icon: 'scan', change: 'Structure or enclosure', check: 'Fit, movement and assembly', text: 'Compare clearances and interfaces with the agreed design and representative parts.' },
  { icon: 'circuit-board', change: 'Component or electronic function', check: 'Operation and power behavior', text: 'Check the affected function, connected interfaces and production test method.' },
  { icon: 'layers', change: 'Material or process', check: 'Performance and consistency', text: 'Select sample, reliability and appearance checks for the risks introduced by the change.' },
];
const changeSteps = [
  { title: 'Record the request', text: 'Current revision and reason', icon: 'file-pen-line' },
  { title: 'Assess the impact', text: 'Design, tools, cost and timing', icon: 'scan-search' },
  { title: 'Confirm the change', text: 'Scope and approval', icon: 'badge-check' },
  { title: 'Update the baseline', text: 'Files and approved sample', icon: 'files' },
  { title: 'Release the revision', text: 'Production and inspection', icon: 'clipboard-check' },
];
const handoverItems = [
  { icon: 'file-text', title: 'Design revision', text: 'Drawings, BOM and key dimensions' },
  { icon: 'boxes', title: 'Approved materials', text: 'Parts, materials and reference samples' },
  { icon: 'wrench', title: 'Production method', text: 'Instructions, fixtures and process changes' },
  { icon: 'clipboard-check', title: 'Release evidence', text: 'Inspection criteria and remaining actions' },
];
---
<CustomizationPage page={page}>
  <CustomizationSection id="change-scope" eyebrow="DEFINE THE CHANGE" title="What needs to improve, and what must stay consistent?" intro="The existing version becomes the reference for every proposed modification.">
    <p>Start by separating the symptom from the requested solution. A difficult battery change, a loose joint or a costly assembly may have several causes. Share the current sample, known failures and use conditions so the review can compare options against the same requirements.</p>
    <div class="b2b-icon-cards adaptation-modifications">
      <article class="b2b-icon-card"><CustomizationIcon name="scan" /><span class="b2b-visual-label">STRUCTURAL CHANGE</span><h3>Fit and use</h3><p>Adjust an enclosure, mechanical interface or operating feature for a defined application. Check the effect on handling, assembly and the surrounding parts.</p></article>
      <article class="b2b-icon-card"><CustomizationIcon name="circuit-board" /><span class="b2b-visual-label">FUNCTIONAL CHANGE</span><h3>Function and reliability</h3><p>Review an operating issue or proposed electronic change. Identify the affected circuit, power, control and mechanical interfaces before choosing a solution.</p></article>
      <article class="b2b-icon-card"><CustomizationIcon name="wrench" /><span class="b2b-visual-label">PROCESS CHANGE</span><h3>Manufacturing improvement</h3><p>Consider simpler parts, fewer assembly steps or suitable material alternatives. Compare production benefits with tooling, sample and validation requirements.</p></article>
    </div>
    <p>For an approved base product needing only branding or packaging changes, start with <a href="/customization/existing-products/">Existing Product Customization</a>. A new core design belongs in the <a href="/customization/new-product-development/">New Product Development</a> review.</p>
  </CustomizationSection>

  <CustomizationSection id="engineering-review" eyebrow="ASSESS THE EFFECT" title="Engineering Review of Product Changes" intro="Review the connected design and production steps before committing to a modification.">
    <figure class="adaptation-concept">
      <figcaption><span class="b2b-visual-label">CONCEPTUAL COMPARISON</span><strong>Existing baseline to proposed engineering revision</strong><span>Illustrative structure and electronics only; this is not a customer product or completed case.</span></figcaption>
      <div class="adaptation-concept-grid">
        <div class="adaptation-concept-panel">
          <div class="adaptation-concept-heading"><span>BEFORE</span><strong>Defined existing product</strong></div>
          <svg class="adaptation-product" viewBox="0 0 360 210" role="img" aria-labelledby="baseline-diagram-title baseline-diagram-description">
            <title id="baseline-diagram-title">Conceptual existing product baseline</title>
            <desc id="baseline-diagram-description">An outlined enclosure contains a button, circuit board and battery space. These represent the starting design to be reviewed.</desc>
            <rect class="concept-envelope" x="52" y="24" width="256" height="162" rx="20" />
            <rect class="concept-wall" x="64" y="36" width="232" height="138" rx="12" />
            <circle class="concept-fastener" cx="75" cy="47" r="4" /><circle class="concept-fastener" cx="285" cy="47" r="4" /><circle class="concept-fastener" cx="75" cy="163" r="4" /><circle class="concept-fastener" cx="285" cy="163" r="4" />
            <rect class="concept-board" x="92" y="85" width="110" height="66" rx="5" />
            <rect class="concept-chip" x="123" y="105" width="39" height="28" rx="2" />
            <path class="concept-trace" d="M92 105H117V92M162 119H192V93M143 133V144H179" />
            <rect class="concept-button" x="120" y="52" width="54" height="19" rx="9" />
            <path class="concept-wire" d="M147 71V85M202 116H218V134H235" />
            <rect class="concept-battery" x="235" y="75" width="34" height="78" rx="5" /><path class="concept-trace" d="M246 91H258M252 85V97M246 138H258" />
          </svg>
          <ul><li>Existing enclosure and interfaces</li><li>Current components and layout</li><li>Approved operating requirements</li></ul>
        </div>
        <div class="adaptation-concept-arrow" aria-hidden="true"><CustomizationIcon name="arrow-right" /><span>ENGINEERING<br />REVIEW</span></div>
        <div class="adaptation-concept-panel adaptation-concept-panel--revised">
          <div class="adaptation-concept-heading"><span>AFTER</span><strong>Proposed revised version</strong></div>
          <svg class="adaptation-product" viewBox="0 0 360 210" role="img" aria-labelledby="revised-diagram-title revised-diagram-description">
            <title id="revised-diagram-title">Conceptual proposed engineering changes</title>
            <desc id="revised-diagram-description">Highlighted areas show a revised button interface, component layout and wiring route. Each change needs its own agreed validation.</desc>
            <rect class="concept-envelope" x="52" y="24" width="256" height="162" rx="20" />
            <rect class="concept-wall" x="64" y="36" width="232" height="138" rx="12" />
            <circle class="concept-fastener" cx="75" cy="47" r="4" /><circle class="concept-fastener" cx="285" cy="47" r="4" /><circle class="concept-fastener" cx="75" cy="163" r="4" /><circle class="concept-fastener" cx="285" cy="163" r="4" />
            <rect class="concept-board concept-revision" x="91" y="88" width="124" height="66" rx="5" />
            <rect class="concept-chip" x="119" y="108" width="37" height="27" rx="2" /><rect class="concept-chip concept-revision" x="174" y="110" width="22" height="22" rx="2" />
            <path class="concept-trace" d="M91 109H112V97M156 122H174M137 135V146H196" />
            <rect class="concept-button concept-revision" x="116" y="49" width="66" height="24" rx="9" />
            <path class="concept-wire concept-revision-wire" d="M149 73V88M215 122H223V153H239" />
            <rect class="concept-battery" x="240" y="73" width="34" height="82" rx="5" /><path class="concept-trace" d="M251 89H263M257 83V95M251 139H263" />
            <path class="concept-guide" d="M106 45H191V78H106ZM168 103H202V138H168Z" />
          </svg>
          <ul><li>Structural fit and assembly review</li><li>Component and function changes</li><li>Targeted validation before release</li></ul>
        </div>
      </div>
      <div class="adaptation-concept-result"><CustomizationIcon name="clipboard-check" /><span><strong>Validation connects the versions.</strong> Confirm affected fit, function and production requirements against the agreed baseline.</span></div>
    </figure>
    <div class="adaptation-review-grid" aria-label="Engineering review of an existing product">
      {reviewRows.map((row, index) => <article class="b2b-icon-card"><CustomizationIcon name={reviewIcons[index]} /><span class="b2b-visual-label">REVIEW AREA</span><h3>{row[0]}</h3><dl><div><dt>Questions to examine</dt><dd>{row[1]}</dd></div><div><dt>Decision to record</dt><dd>{row[2]}</dd></div></dl></article>)}
    </div>
    <p>Design for manufacturability (DFM) connects the revised geometry to the process: wall thickness, draft, parting lines, undercuts and assembly tolerances can all affect the result. Value engineering compares simpler construction or material alternatives against the required function and quality, including the cost of tooling changes and renewed validation.</p>
    <p>For example, changing a button can affect its clearance, return movement, operating force and contact with the circuit below. Changing an enclosure can affect wire routing, screw access and how the product is tested. The review identifies these dependencies and separates confirmed information from points that need a sample.</p>
  </CustomizationSection>

  <CustomizationSection id="validation" eyebrow="CHECK THE REVISED VERSION" title="Validate the change and the functions it can affect" intro="Agree the evidence needed before approving the revised design.">
    <div class="b2b-icon-cards adaptation-risk-grid">
      {validationChecks.map(item => <article class="b2b-icon-card"><CustomizationIcon name={item.icon} /><span class="b2b-visual-label">CHANGE TO ASSESS</span><h3>{item.change}</h3><div class="adaptation-validation-link"><CustomizationIcon name="arrow-down" /><span>VALIDATION FOCUS</span></div><strong>{item.check}</strong><p>{item.text}</p></article>)}
    </div>
    <div class="b2b-media-split adaptation-validation-media">
      <CustomizationFigure src={gapPhoto} alt="Inspection reference showing a marked gap between assembled housing parts" caption="Inspection reference: an assembly gap, marked for review. A defect example, not a before-and-after customer case." />
      <div class="adaptation-validation-copy">
        <div class="b2b-panel b2b-panel--tint"><CustomizationIcon name="scan-search" /><h3>Compare with the baseline</h3><p>Review dimensions, fit, appearance and operation against the agreed specification. Where relevant, check interchangeability, assembly interference, battery contact, power behavior and access for production testing.</p><p>A visual model can help judge form. Material behavior, final finish and electronic operation may need separate representative samples.</p></div>
        <div class="b2b-panel"><CustomizationIcon name="clipboard-check" /><h3>Close the remaining issues</h3><p>Record findings, proposed corrections and the next review owner. Reliability, environmental, misuse or transport checks are selected according to the affected risks and intended use.</p><p>Customer feedback and engineering findings may require another revision. Sample approval records which version was reviewed and which production conditions it represents.</p></div>
      </div>
    </div>
  </CustomizationSection>

  <CustomizationSection id="change-approval" eyebrow="CONTROL THE REVISION" title="Engineering Change Approval & Revision Control" intro="The decision needs to reach drawings, materials, samples and production instructions.">
    <CustomizationFlow label="Controlled engineering change" steps={changeSteps} compact />
    <p>The change record identifies the current revision, requested modification, reason and affected items. Engineering reviews the implications, including whether tooling, fixtures or test methods need updating. Commercial and schedule effects are presented for confirmation before the affected work proceeds.</p>
    <p>Once agreed, the revised specification and sample become the reference for that version. Keep superseded information identifiable so purchasing, production and inspection use the correct requirements.</p>
    <p class="qc-note">A new request after approval can reopen part of the review. Confirm the affected files, stock, tooling and validation work before releasing the next revision.</p>
    <div class="b2b-comparison">
      <article class="b2b-panel"><CustomizationIcon name="files" /><h3>Issue the approved document set</h3><p>Route the change notice through engineering review and document control. Update the affected bill of materials (BOM), drawings (DWG), operating instructions (SOP) and inspection instructions (SIP). Withdraw superseded internal copies and identify retained references as obsolete.</p></article>
      <article class="b2b-panel b2b-panel--tint"><CustomizationIcon name="boxes" /><h3>Carry changes through purchasing</h3><p>When a supplier uses an affected specification or inspection standard, purchasing communicates the replacement revision. Changes to purchase requirements need approval and supplier confirmation; changes to agreed order specifications, quantity or timing are reviewed with the customer.</p></article>
    </div>
    <p><strong>Product-certification changes have an additional review.</strong> For products within an applicable 3C certification scope, Xinyinhai’s documented procedure adds certification approval before the changed product is produced or sold. This is separate from general engineering approval; the review must first establish the product's certification status and whether the proposed change falls within that scope.</p>
  </CustomizationSection>

  <CustomizationSection id="production-handover" eyebrow="PREPARE THE NEXT BUILD" title="Carry the engineering decision into production" intro="An accepted design change still needs a usable manufacturing handover.">
    <div class="adaptation-handover-grid">
      {handoverItems.map(item => <article class="b2b-icon-card"><CustomizationIcon name={item.icon} /><h3>{item.title}</h3><p>{item.text}</p></article>)}
    </div>
    <p>Update the applicable BOM, drawings, key dimensions, material approvals and inspection criteria. Review work instructions and fixtures when the assembly or process changes. A trial or pilot build may be needed to check that the revised design can be produced and inspected as intended.</p>
    <p>The release decision considers outstanding issues, approved samples and production readiness. Our <a href="/customization/how-we-work/">working process</a> explains how reviews, customer decisions and later changes connect.</p>
    <p>See <a href="/quality/traceability/">Traceability &amp; Materials</a> for how material identity, inspection status and available production records support review of affected stock, and the <a href="/quality/">quality management system</a> for document and corrective-action controls.</p>
  </CustomizationSection>
</CustomizationPage>

<style>
  .adaptation-modifications,.adaptation-risk-grid,.adaptation-handover-grid { margin-block:24px; }
  .adaptation-concept { margin:0 0 28px; padding:24px; border:1px solid #c8d6e5; border-radius:8px; background:#f4f7fb; }
  .adaptation-concept figcaption { display:grid; gap:7px; margin-bottom:22px; }
  .adaptation-concept figcaption>strong { color:#173451; font-size:1.1rem; }
  .adaptation-concept figcaption>span:last-child { color:#52647a; font-size:.78rem; }
  .adaptation-concept-grid { display:grid; grid-template-columns:minmax(0,1fr) 86px minmax(0,1fr); align-items:center; }
  .adaptation-concept-panel { border:1px solid #c7d3e2; border-radius:6px; background:#fff; min-width:0; overflow:hidden; }
  .adaptation-concept-panel--revised { border-color:#6686ae; }
  .adaptation-concept-heading { display:grid; gap:5px; padding:17px 19px; border-bottom:1px solid #d9e2ec; }
  .adaptation-concept-heading>span { font-size:.62rem; letter-spacing:.12em; font-weight:700; color:#5d7289; }
  .adaptation-concept-heading>strong { color:#213d5d; font-size:.92rem; }
  .adaptation-product { width:100%; height:auto; max-height:228px; display:block; }
  .concept-envelope { fill:#eef3f8; stroke:#6b819a; stroke-width:2; }
  .concept-wall { fill:#fff; stroke:#b7c5d5; stroke-width:1.5; }
  .concept-fastener { fill:none; stroke:#788b9e; stroke-width:1.5; }
  .concept-board { fill:#e1eaf4; stroke:#6885a7; stroke-width:2; }
  .concept-chip { fill:#f8fafc; stroke:#6d84a0; stroke-width:1.5; }
  .concept-button { fill:#d5e2ef; stroke:#59799d; stroke-width:2; }
  .concept-battery { fill:#f1f4f7; stroke:#91a2b4; stroke-width:1.5; }
  .concept-trace,.concept-wire { fill:none; stroke:#7e96b0; stroke-width:2; stroke-linejoin:round; }
  .concept-revision { fill:#d6e5f8; stroke:#285fa0; }
  .concept-revision-wire { stroke:#285fa0; stroke-width:3; }
  .concept-guide { fill:none; stroke:#4874a7; stroke-width:1.5; stroke-dasharray:4 4; }
  .adaptation-concept-panel ul { margin:0; padding:0 20px 18px 36px; color:#50657e; font-size:.78rem; line-height:1.75; }
  .adaptation-concept-arrow { display:flex; align-items:center; flex-direction:column; gap:10px; color:#486b99; }
  .adaptation-concept-arrow span { font-size:.52rem; line-height:1.65; letter-spacing:.05em; text-align:center; font-weight:750; }
  .adaptation-concept-result { display:flex; gap:13px; align-items:center; margin-top:20px; padding:16px 18px; background:#e5edf7; color:#385470; font-size:.82rem; border-radius:5px; }
  .adaptation-concept-result strong { color:#173451; }
  .adaptation-review-grid,.adaptation-handover-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; margin-bottom:26px; }
  .adaptation-review-grid dl { margin:18px 0 0; }
  .adaptation-review-grid dl>div+div { border-top:1px solid #dce5ef; padding-top:12px; margin-top:12px; }
  .adaptation-review-grid dt { font-size:.67rem; font-weight:700; text-transform:uppercase; letter-spacing:.03em; color:#31577e; margin-bottom:5px; }
  .adaptation-review-grid dd { margin:0; color:#52647a; font-size:.84rem; line-height:1.7; }
  .adaptation-validation-link { display:flex; align-items:center; gap:8px; margin:18px 0 10px; color:#52749c; }
  .adaptation-validation-link>span { font-size:.59rem; font-weight:750; letter-spacing:.06em; }
  .adaptation-risk-grid article>strong { display:block; color:#203f61; font-size:.91rem; }
  .adaptation-validation-copy { display:grid; gap:18px; }
  .adaptation-validation-media { align-items:start; }
  .adaptation-validation-media :global(img) { object-fit:contain; aspect-ratio:471 / 427; }
  .adaptation-handover-grid { grid-template-columns:repeat(4,minmax(0,1fr)); }
  @media(max-width:859px) { .adaptation-handover-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:699px) {
    .adaptation-concept { padding:16px; }
    .adaptation-concept-grid { grid-template-columns:1fr; }
    .adaptation-concept-arrow { flex-direction:row; justify-content:center; padding:15px; }
    .adaptation-concept-arrow :global(svg) { transform:rotate(90deg); }
    .adaptation-concept-arrow span { text-align:left; }
    .adaptation-review-grid { grid-template-columns:1fr; }
  }
  @media(max-width:479px) { .adaptation-handover-grid { grid-template-columns:1fr; } .adaptation-concept-result { align-items:flex-start; padding:14px; } }
</style>
