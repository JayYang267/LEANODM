---
import { SITE } from '@config/site';
import { CASE_STUDIES_PATH, DRIVING_SOUND_BOOK_CASE_PATH } from '@config/seo';
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import project from '@/data/cases/interactive-driving-sound-book.json';

const canonical = new URL(DRIVING_SOUND_BOOK_CASE_PATH, SITE.url).href;
const assemblyPath = '/manufacturing/assembly-packaging/';
const mediaPath = '/media/cases/interactive-driving-sound-book/';
const video = `${mediaPath}driving-activity-book.mp4`;
const poster = `${mediaPath}driving-activity-book-poster.webp`;
const captions = `${mediaPath}driving-activity-book-en.vtt`;
const productImage = `${mediaPath}finished-product.webp`;
const imageUrl = new URL(poster, SITE.url).href;
const { heading, description, chapters } = project;
const timeDisplay = (seconds: number) => `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      name: heading,
      description,
      url: canonical,
      inLanguage: 'en',
      isPartOf: { '@id': new URL('/#website', SITE.url).href },
      about: { '@id': new URL('/#xinyinhai', SITE.url).href },
      breadcrumb: { '@id': `${canonical}#breadcrumbs` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumbs`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', SITE.url).href },
        { '@type': 'ListItem', position: 2, name: 'Case Studies', item: new URL(CASE_STUDIES_PATH, SITE.url).href },
        { '@type': 'ListItem', position: 3, name: heading, item: canonical },
      ],
    },
  ],
};
---

<BaseLayout title={`${heading} | ${SITE.title}`} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={project.posterAlt} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={project.posterAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </Fragment>

  <article class="case" aria-labelledby="case-title">
    <header class="case-hero">
      <nav aria-label="Breadcrumb"><a href={CASE_STUDIES_PATH}>Case Studies</a><span aria-hidden="true">/</span><span aria-current="page">Production case</span></nav>
      <h1 id="case-title">{heading}</h1>
      <p class="case-lead">{project.summary}</p>
      <div class="case-actions">
        <Button href="#production-film">Watch the production film</Button>
        <a href="#project-next">Discuss a similar project</a>
      </div>
    </header>

    <section class="case-band" id="production-film" aria-labelledby="film-title">
      <div class="case-section">
        <h2 id="film-title">Production film</h2>
        <figure class="case-film">
          <video id="case-player" controls playsinline preload="none" poster={poster} width="1280" height="720" aria-label={`${heading}: production film`}>
            <source src={video} type="video/mp4" />
            <track kind="captions" src={captions} srclang="en" label="English" default />
            Your browser does not support embedded video.
          </video>
          <figcaption>
            <span>English captions</span>
            <a href={video}>Open the MP4 directly</a>
          </figcaption>
        </figure>

        <div class="case-chapters">
          <h3>Film chapters and summary</h3>
          <ol>
            {chapters.map(chapter => <li>
              <a class="case-chapter-link" href={`${video}#t=${chapter.time}`} data-seek={chapter.time}>
                <span>{timeDisplay(chapter.time)}</span>{chapter.label}
              </a>
              <p>{chapter.text}</p>
            </li>)}
          </ol>
        </div>
      </div>
    </section>

    <section class="case-section case-product" aria-labelledby="product-title">
      <div>
        <h2 id="product-title">Finished product and how it works</h2>
        <p>{project.product.description}</p>
        {project.product.details.length > 0 && <ul class="case-bullets">{project.product.details.map(detail => <li>{detail}</li>)}</ul>}
        {project.product.sources.length > 0 && <ul class="case-references" aria-label="Product references">
          {project.product.sources.map(source => <li><a href={source.url} rel="noreferrer">{source.label}</a><p>{source.note}</p></li>)}
        </ul>}
      </div>
      <figure class="case-product-image">
        <img src={productImage} width="456" height="553" alt={project.product.imageAlt} loading="lazy" decoding="async" />
        {project.product.imageCaption && <figcaption>{project.product.imageCaption}</figcaption>}
      </figure>
    </section>

    <section class="case-band" aria-labelledby="evidence-title">
      <div class="case-section">
        <h2 id="evidence-title">Manufacturing and quality evidence</h2>
        <ul class="case-bullets case-scope">{project.scope.map(scope => <li>{scope}</li>)}</ul>
        {project.quality.length > 0 && <div class="case-evidence">
          {project.quality.map(evidence => <section class="case-evidence-item">
            <h3>{evidence.title}</h3>
            <p>{evidence.issue}</p>
            <dl>
              <div><dt>Production step</dt><dd>{evidence.action}</dd></div>
              <div><dt>Evidence</dt><dd>{evidence.evidence}</dd></div>
              <div><dt>What buyers can use it for</dt><dd>{evidence.meaning}</dd></div>
            </dl>
          </section>)}
        </div>}
      </div>
    </section>

    <section class="case-section" id="project-next" aria-labelledby="next-title">
      <h2 id="next-title">Planning a similar project?</h2>
      <p>Share the product format, target market, required functions and launch timing for your educational toy, interactive book or licensed hardware. A short brief is enough to begin.</p>
      <div class="case-actions">
        <Button href="/rfq/#rfq-form">Start a project inquiry</Button>
        <Button variant="outline" href="/rfq/#rfq-contact">Ask about a factory visit</Button>
      </div>
      <ul class="case-links" aria-label="Manufacturing services and policies">
        <li><a href={assemblyPath}>Assembly &amp; packaging</a></li>
        <li><a href="/quality/quality-control-process/">Quality control process</a></li>
        <li><a href="/quality/product-testing/">Product testing</a></li>
        <li><a href="/customization/ip-protection/">IP &amp; confidentiality</a></li>
      </ul>
      {project.faq.length > 0 && <div class="case-faq">
        <h3>Frequently asked questions</h3>
        {project.faq.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
      </div>}
    </section>
  </article>
</BaseLayout>

<script>
  const player = document.querySelector<HTMLVideoElement>('#case-player');

  if (player) document.querySelectorAll<HTMLAnchorElement>('a[data-seek]').forEach(link => {
    link.addEventListener('click', event => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || player.error) return;
      event.preventDefault();
      player.currentTime = Number(link.dataset.seek);
      player.focus({ preventScroll: true });
      player.scrollIntoView({ block: 'nearest' });
      player.play().catch(() => { if (player.error) window.location.assign(link.href); });
    });
  });
</script>

<style>
  .case { color: #182637; line-height: 1.6; }
  .case [id] { scroll-margin-top: calc(var(--lean-global-header-height, 72px) + 16px); }
  .case a:not([class]) { color: #104f8d; text-decoration: underline; text-underline-offset: .22em; }
  .case :is(a, button, summary, video):focus-visible { outline: 3px solid #1672ba; outline-offset: 4px; }
  .case-hero, .case-section { width: min(100% - 2.5rem, 72rem); margin-inline: auto; }
  .case-hero { padding-block: clamp(1.55rem, 3.3vw, 3rem) clamp(1.8rem, 3.2vw, 3rem); }
  .case-hero nav { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem; font-size: .9rem; }
  .case h1, .case h2, .case h3, .case h4 { font-weight: 700; letter-spacing: -.025em; line-height: 1.18; }
  .case h1 { margin-top: 1rem; max-width: 29ch; font-size: clamp(2.15rem, 5.3vw, 3.65rem); text-wrap: balance; }
  .case h2 { font-size: clamp(1.57rem, 3.1vw, 2.45rem); margin-bottom: .8rem; }
  .case h3 { font-size: clamp(1.15rem, 1.9vw, 1.52rem); }
  .case p, .case li { overflow-wrap: anywhere; }
  .case-lead { max-width: 70ch; margin-top: 1rem; font-size: clamp(1.03rem, 1.8vw, 1.2rem); }
  .case-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .85rem 1.4rem; margin-top: 1.25rem; }
  .case-section { padding-block: clamp(2rem, 5vw, 4.6rem); }
  .case-section > p { max-width: 70ch; }
  .case-band { background: #f3f7fa; border-block: 1px solid #dce6ee; }
  #production-film .case-section { padding-block-start: clamp(1.65rem, 3.5vw, 3.4rem); }
  .case-film { max-width: min(100%, 62rem); margin: 1.1rem 0 0; }
  .case-film :is(video, img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; border-radius: .6rem; background: #102236; }
  .case-film figcaption { display: flex; gap: .5rem 1.5rem; flex-wrap: wrap; padding: .65rem 0; font-size: .9rem; }
  .case-chapters, .case-faq { margin-top: 1.8rem; }
  .case-chapters ol, .case-evidence { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem 1.6rem; margin-top: .9rem; }
  .case-chapters li { padding-block: .55rem; border-top: 1px solid #cedce7; }
  .case-chapter-link { display: flex; gap: .7rem; color: #104f8d; font-weight: 650; text-decoration: underline; text-underline-offset: .2em; min-height: 28px; }
  .case-chapter-link span { color: #35536b; font-variant-numeric: tabular-nums; }
  .case-product { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .85fr); align-items: start; gap: 1.55rem 2.75rem; }
  .case-product > div:only-child { grid-column: 1 / -1; max-width: 75ch; }
  .case-product-image img { display: block; width: 100%; height: auto; border-radius: .6rem; }
  .case-product-image figcaption { margin-top: .55rem; font-size: .9rem; }
  .case-bullets { list-style: disc; margin: .75rem 0 0; padding-left: 1.4rem; }
  .case-bullets li + li, .case-references li + li { margin-top: .45rem; }
  .case-references { margin-top: 1.1rem; }
  .case-scope { max-width: 75ch; }
  .case-evidence-item { min-width: 0; background: #fff; border: 1px solid #dce6ee; border-radius: .6rem; padding: 1.2rem; }
  .case-evidence-item p { margin-top: .5rem; }
  .case-evidence-item dl { margin-top: .8rem; }
  .case-evidence-item dl div + div { margin-top: .55rem; }
  .case-evidence-item dt { font-weight: 650; }
  .case-links { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; margin-top: 1.14rem; }
  .case-faq details { max-width: 75ch; border-top: 1px solid #dce6ee; padding-block: .65rem; }
  .case-faq details:first-of-type { margin-top: .75rem; }
  .case-faq summary { cursor: pointer; font-weight: 650; }
  .case-faq details p { margin-top: .32rem; }
  @media (max-width: 700px) {
    .case-chapters ol, .case-evidence, .case-product { grid-template-columns: minmax(0, 1fr); }
  }
</style>
