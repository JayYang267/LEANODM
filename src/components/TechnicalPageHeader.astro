---
import { technicalPageNavigation } from './technicalPageNavigation';

interface Props {
  navigation?: readonly { label: string; href: string }[];
  pageTitle?: string;
}

const {
  navigation = technicalPageNavigation,
  pageTitle = 'Technical page',
} = Astro.props;
---

<header class="technical-header">
  <div class="technical-header-inner">
    <a class="technical-section-label" href="#main-content">{pageTitle}</a>

    <nav class="technical-desktop-nav" aria-label={`${pageTitle} page sections`}>
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <details class="technical-mobile-menu">
      <summary>
        <span>Page Sections</span>
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
          <path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <nav class="technical-mobile-panel" aria-label={`${pageTitle} page sections mobile`}>
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>

<script is:inline>
  document.querySelectorAll('.technical-mobile-menu').forEach((menu) => {
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  });
</script>

<style>
  .technical-header {
    position: sticky;
    top: 68px;
    z-index: 60;
    width: 100%;
    border-bottom: 1px solid #e2e8f0;
    background: rgb(248 250 252 / 96%);
    backdrop-filter: blur(10px);
  }

  .technical-header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: min(100%, 1280px);
    min-height: 48px;
    margin-inline: auto;
    padding: 0.35rem 1rem;
  }

  .technical-section-label {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    color: #183ba3;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .technical-header a,
  .technical-header summary {
    border-radius: 0.375rem;
  }

  .technical-header a:focus-visible,
  .technical-header summary:focus-visible {
    outline: 3px solid #183ba3;
    outline-offset: 3px;
  }

  .technical-desktop-nav {
    display: none;
  }

  .technical-mobile-menu > summary {
    display: flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.45rem 0.55rem;
    color: #334155;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 650;
    list-style: none;
  }

  .technical-mobile-menu > summary::-webkit-details-marker {
    display: none;
  }

  .technical-mobile-menu[open] > summary svg {
    transform: rotate(180deg);
  }

  .technical-mobile-panel {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    max-height: calc(100dvh - 116px);
    overflow-y: auto;
    padding: 0.6rem 1rem 0.85rem;
    border-bottom: 1px solid #e2e8f0;
    background: white;
    box-shadow: 0 12px 20px rgb(15 23 42 / 8%);
  }

  .technical-mobile-panel > a {
    display: flex;
    min-height: 40px;
    align-items: center;
    padding: 0.65rem 0.75rem;
    color: #334155;
    font-size: 0.9rem;
    font-weight: 550;
  }

  .technical-mobile-panel > a:hover,
  .technical-desktop-nav > a:hover {
    color: #c71923;
    background: #fff1f2;
  }

  @media (min-width: 640px) {
    .technical-header-inner {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 860px) {
    .technical-desktop-nav {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 0.2rem;
    }

    .technical-desktop-nav > a {
      display: flex;
      min-height: 38px;
      align-items: center;
      padding: 0.45rem 0.65rem;
      color: #334155;
      font-size: 0.82rem;
      font-weight: 600;
      white-space: nowrap;
    }

    .technical-mobile-menu {
      display: none;
    }
  }

  @media (min-width: 1120px) {
    .technical-header {
      top: 99px;
    }

    .technical-header-inner {
      padding-inline: 2rem;
    }
  }
</style>
