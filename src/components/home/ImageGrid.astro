---
import ImageReveal from '@components/react/ImageReveal';
import { Image } from 'astro:assets';
import warehouseImg from '@assets/photo-1566576721346-d4a3b4eaeb55.jpg';
import fleetImg from '@assets/photo-1601584115197-04ecc0da31d7.jpg';
import manufacturingImg from '@assets/photo-1581091226825-a6a2a5aee158.jpg';
import commandCenterImg from '@assets/photo-1551288049-bebda4e38f71.jpg';
import distributionImg from '@assets/photo-1586528116311-ad8dd3c8310d.jpg';
---

<section class="py-24 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-secondary-100 text-secondary-800 text-sm font-semibold rounded-full">
        Manufacturing Project Overview
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        Review <span class="text-transparent bg-clip-text bg-linear-to-r from-primary-600 to-secondary-600">The Production Route</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Xinyinhai’s documented manufacturing work connects materials, production and inspection.
        These photographs are illustrative; the manufacturing pages show the factory records.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Large featured image -->
      <div class="md:row-span-2">
        <ImageReveal client:load delay={0}>
          <div class="relative h-full group overflow-hidden rounded-2xl shadow-xl">
            <Image 
              src={warehouseImg}
              alt="Illustrative warehouse stock photograph"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width={1200}
              height={800}
            />
            <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
              <h3 class="text-2xl font-bold mb-2">Material Preparation</h3>
              <p class="text-gray-200">Material identity, handling and production readiness</p>
            </div>
          </div>
        </ImageReveal>
      </div>

      <ImageReveal client:load delay={0.1}>
        <div class="relative h-64 lg:h-auto group overflow-hidden rounded-2xl shadow-xl">
          <Image 
            src={fleetImg}
            alt="Illustrative transport stock photograph"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            width={800}
            height={600}
          />
          <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="text-xl font-bold mb-1">Packing & Delivery Review</h3>
            <p class="text-sm text-gray-200">Confirm packing and delivery requirements</p>
          </div>
        </div>
      </ImageReveal>

      <ImageReveal client:load delay={0.2}>
        <div class="relative h-64 lg:h-auto group overflow-hidden rounded-2xl shadow-xl">
          <Image 
            src={manufacturingImg}
            alt="Illustrative manufacturing stock photograph"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            width={800}
            height={600}
          />
          <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="text-xl font-bold mb-1">Manufacturing</h3>
            <p class="text-sm text-gray-200">Documented methods at Xinyinhai</p>
          </div>
        </div>
      </ImageReveal>

      <div class="lg:row-start-3">        
        <ImageReveal client:load delay={0.3}>
          <div class="lg:col-span-2 relative h-64 lg:h-auto group overflow-hidden rounded-2xl shadow-xl">
            <Image 
              src={commandCenterImg}
              alt="Illustrative analytics stock photograph"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width={1200}
              height={600}
            />
            <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h3 class="text-xl font-bold mb-1">Process Information</h3>
              <p class="text-sm text-gray-200">Requirements, work instructions and production records</p>
            </div>
          </div>
        </ImageReveal>
      </div>
      <div class="lg:row-start-2 lg:col-start-2 lg:row-span-2 lg:col-span-2">        
        <ImageReveal client:load delay={0.4}>
          <div class="relative h-64 lg:h-auto group overflow-hidden rounded-2xl shadow-xl">
            <Image 
              src={distributionImg}
              alt="Illustrative warehouse stock photograph"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width={800}
              height={600}
            />
            <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h3 class="text-xl font-bold mb-1">Material & Product Handling</h3>
              <p class="text-sm text-gray-200">Identification, protection and defined handling methods</p>
            </div>
          </div>
        </ImageReveal>
      </div>
    </div>
  </div>
</section>

