---
import { Image } from 'astro:assets';

import discoveryImg from '@assets/photo-1454165804606-c3d57bc86b40.jpg';
import implementationImg from '@assets/photo-1522071820081-009f0129c71c.jpg';
import optimizationImg from '@assets/photo-1551288049-bebda4e38f71.jpg';
import supportGrowthImg from '@assets/photo-1552664730-d307ca884978.jpg';

interface Step {
  number: number;
  title: string;
  description: string;
  image: ImageMetadata;
  alt: string;
  hoverBorder: string;
  gradient: string;
  textColor: string;
}

const steps = [
  {
    number: 1,
    title: "Discovery & Planning",
    description: "We review the intended use, design status and available references to clarify the product requirements.",
    image: discoveryImg,
    alt: "Illustrative stock photograph of planning",
    hoverBorder: "hover:border-primary-500",
    gradient: "from-primary-600/90",
    textColor: "text-primary-600"
  },
  {
    number: 2,
    title: "Development & Preparation",
    description: "Xinyinhai’s documented development route connects engineering reviews, samples and preparation for the agreed manufacturing work.",
    image: implementationImg,
    alt: "Illustrative stock photograph of team collaboration",
    hoverBorder: "hover:border-secondary-500",
    gradient: "from-secondary-600/90",
    textColor: "text-secondary-700"
  },
  {
    number: 3,
    title: "Optimization",
    description: "Review the sample and process findings, identify necessary changes and define the next verification step.",
    image: optimizationImg,
    alt: "Illustrative stock photograph of analytics",
    hoverBorder: "hover:border-primary-500",
    gradient: "from-primary-600/90",
    textColor: "text-primary-600"
  },
  {
    number: 4,
    title: "Production Review",
    description: "Xinyinhai’s manufacturing procedures connect work instructions, inspection and records for the approved product scope.",
    image: supportGrowthImg,
    alt: "Illustrative stock photograph of a discussion",
    hoverBorder: "hover:border-secondary-500",
    gradient: "from-secondary-600/90",
    textColor: "text-secondary-700"
  }
];

const arrowPath = "M9 5l7 7-7 7";
---

<section class="py-24 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-secondary-100 text-secondary-800 text-sm font-semibold rounded-full">
        How We Work
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        A Defined <span class="text-transparent bg-clip-text bg-linear-to-r from-primary-600 to-secondary-600">Process</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Start with a product brief, then review the work and responsibilities. The photographs illustrate project discussions.
      </p>
    </div>

    <div class="relative">
      <!-- Connection Line (hidden on mobile) -->
      <div class="hidden lg:block absolute top-24 left-0 right-0 h-0.5 bg-linear-to-r from-primary-200 via-secondary-200 to-primary-200"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative">
        {steps.map((step) => (
          <div class="relative h-full">
            <div class={`bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all border-2 border-slate-100 ${step.hoverBorder} relative z-10 flex flex-col h-full`}>
              <div class="relative h-48 overflow-hidden">
                <Image 
                  src={step.image}
                  alt={step.alt}
                  class="w-full h-full object-cover"
                  width={800}
                  height={400}
                />
                <div class={`absolute inset-0 bg-linear-to-t ${step.gradient} to-transparent`}></div>
                <div class={`absolute top-4 right-4 w-12 h-12 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center ${step.textColor} font-bold text-xl shadow-lg`}>
                  {step.number}
                </div>
              </div>
              <div class="p-8 flex flex-col flex-1">
                <h3 class="text-xl font-bold text-slate-900 mb-3">{step.title}</h3>
                <p class="text-slate-600 leading-relaxed flex-1">
                  {step.description}
                </p>
                <div class={`mt-6 flex items-center text-sm ${step.textColor} font-semibold`}>
                  Learn more
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={arrowPath} />
                  </svg>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Key Benefits -->
    <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary-100 text-primary-600 mb-4">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h4 class="text-lg font-semibold text-slate-900 mb-2">Clear Inputs</h4>
        <p class="text-slate-600">Start with the product information available</p>
      </div>
      <div class="text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-secondary-100 text-secondary-600 mb-4">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h4 class="text-lg font-semibold text-slate-900 mb-2">Defined Verification</h4>
        <p class="text-slate-600">Agree the checks required for your product</p>
      </div>
      <div class="text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary-100 text-primary-600 mb-4">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
        <h4 class="text-lg font-semibold text-slate-900 mb-2">Project Communication</h4>
        <p class="text-slate-600">Confirm responsibilities and the next step</p>
      </div>
    </div>
  </div>
</section>


