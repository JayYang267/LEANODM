---
import Button from '../ui/Button.astro';
---

<section class="relative overflow-hidden bg-linear-to-r from-primary-800 to-secondary-700 text-white py-20">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: linear-gradient(45deg, white 25%, transparent 25%), linear-gradient(-45deg, white 25%, transparent 25%), linear-gradient(45deg, transparent 75%, white 75%), linear-gradient(-45deg, transparent 75%, white 75%); background-size: 60px 60px; background-position: 0 0, 0 30px, 30px -30px, -30px 0px;"></div>
  </div>

  <div class="container mx-auto relative z-10">
    <div class="max-w-4xl mx-auto text-center space-y-6 animate-fadeInUp">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight">Discuss Your Product Project</h2>
      <p class="text-lg md:text-xl text-primary-100 max-w-2xl mx-auto">Bring a concept, reference or design to review the relevant product development and manufacturing work with the project team.</p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center pt-6">
        <Button href="/rfq" size="lg" class="bg-white! text-primary-800! hover:bg-gray-100!">
          Request a Quote
        </Button>
      </div>

      <!-- Trust indicators -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 pt-12 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="text-3xl font-bold text-secondary-300">Brief</div>
          <div class="text-sm text-primary-200 mt-1">Product requirements</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-secondary-300">Scope</div>
          <div class="text-sm text-primary-200 mt-1">Agreed responsibilities</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-secondary-300">Quality</div>
          <div class="text-sm text-primary-200 mt-1">Product verification</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-secondary-300">Review</div>
          <div class="text-sm text-primary-200 mt-1">Next useful step</div>
        </div>
      </div>
    </div>
  </div>
</section>
