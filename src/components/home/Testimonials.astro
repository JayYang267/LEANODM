---
import TestimonialCard from '../ui/TestimonialCard.astro';


// No customer quotations are approved for publication.
const testimonials: { quote: string; name: string; role: string; image: ImageMetadata; ringColor: string }[] = [];
---

<section class="py-24 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-secondary-100 text-secondary-800 text-sm font-semibold rounded-full">
        Client Success Stories
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        Read <span class="text-transparent bg-clip-text bg-linear-to-r from-primary-600 to-secondary-600">Customer Feedback</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Customer feedback is published only after its source and permission for public use are confirmed.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {testimonials.map((testimonial) => (
        <TestimonialCard testimonial={testimonial} variant="home" />
      ))}
    </div>
  </div>
</section>
