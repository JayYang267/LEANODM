---
import { Image } from 'astro:assets';
import techDashboardImg from '@assets/photo-1551288049-bebda4e38f71.jpg';

interface Technology {
  title: string;
  description: string;
  iconGradient: string;
  iconPath: string;
}

const technologies: Technology[] = [
  {
    title: "Development Review",
    description: "Xinyinhai’s documented development route connects requirements, design reviews and verification before production release.",
    iconGradient: "from-primary-500 to-primary-600",
    iconPath: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
  },
  {
    title: "Production Information",
    description: "Work instructions, reference samples and production records define the manufacturing and inspection route for a product.",
    iconGradient: "from-secondary-500 to-secondary-600",
    iconPath: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
  },
  {
    title: "Electronics Integration",
    description: "Review the required functions, board assembly, housing interfaces and testing with the project team.",
    iconGradient: "from-primary-500 to-primary-600",
    iconPath: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
  },
  {
    title: "Documented Controls",
    description: "Xinyinhai’s quality procedures describe controlled information, inspection decisions and corrective action.",
    iconGradient: "from-secondary-500 to-secondary-600",
    iconPath: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
  }
];
---

<section class="py-24 bg-linear-to-b from-slate-900 via-slate-800 to-slate-900 relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div>
        <div class="inline-block px-4 py-2 mb-4 bg-white/10 backdrop-blur-sm text-white text-sm font-semibold rounded-full">
          Development & Process Controls
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Understand <span class="text-transparent bg-clip-text bg-linear-to-r from-primary-400 to-secondary-400">The Documented Work</span>
        </h2>
        <p class="text-xl text-slate-300 mb-8 leading-relaxed">
          Xinyinhai’s development and manufacturing records describe the methods behind this work. Project review establishes which processes and verification apply to your product.
        </p>

        <!-- Technology Features -->
        <div class="space-y-6">
          {technologies.map((tech) => (
            <div class="flex items-start group">
              <div class={`shrink-0 w-12 h-12 rounded-lg bg-linear-to-br ${tech.iconGradient} flex items-center justify-center mr-4 group-hover:scale-110 transition-transform`}>
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tech.iconPath} />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-2">{tech.title}</h3>
                <p class="text-slate-400 leading-relaxed">
                  {tech.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Visual -->
      <div class="relative">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl">
          <Image 
            src={techDashboardImg}
            alt="Illustrative analytics stock photograph"
            class="w-full h-full object-cover"
            width={1200}
            height={800}
          />
          <div class="absolute inset-0 bg-linear-to-br from-primary-900/80 via-secondary-900/60 to-primary-900/80"></div>
          <div class="absolute inset-0 flex items-center justify-center p-8">
            <div class="text-center">
              <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-linear-to-br from-primary-500 to-secondary-500 flex items-center justify-center shadow-2xl">
                <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-white mb-2">Manufacturing Process Information</h3>
              <p class="text-slate-300">Illustrative photography · documented methods on the linked pages</p>
            </div>
          </div>
        </div>
        
        <!-- Floating Cards -->
        <div class="absolute -top-4 -right-4 bg-white rounded-lg p-4 shadow-xl z-20 animate-pulse">
          <div class="flex items-center">
            <div class="w-3 h-3 rounded-full bg-green-500 mr-2"></div>
            <span class="text-sm font-semibold text-slate-900">Project Review</span>
          </div>
        </div>
        <div class="absolute -bottom-4 -left-4 bg-white rounded-lg p-4 shadow-xl z-20 animate-pulse" style="animation-delay: 0.5s;">
          <div class="flex items-center">
            <div class="w-3 h-3 rounded-full bg-primary-500 mr-2"></div>
            <span class="text-sm font-semibold text-slate-900">Defined Scope</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


