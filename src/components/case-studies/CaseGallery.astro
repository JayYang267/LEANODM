---
import { caseImageStyle, type CaseImage } from '../../data/case-studies';

interface Props { cover: CaseImage; gallery?: CaseImage[] }
const { cover, gallery = [] } = Astro.props;
const frames = [cover, ...gallery];
---

<case-gallery>
  <figure>
    <div class="case-main-frame">
      <img data-main-image src={cover.src} alt={cover.alt} style={caseImageStyle(cover)}
        fetchpriority="high" decoding="async" />
    </div>
    <figcaption data-main-caption hidden={!cover.caption}>{cover.caption}</figcaption>
  </figure>
  {gallery.length > 0 && <div class="case-thumbnails" role="group" aria-label="Product photos" hidden>
    {frames.map((image, index) => <button type="button" aria-label={`Show photo: ${image.alt}`}
      aria-pressed={index === 0 ? 'true' : 'false'} data-src={image.src} data-alt={image.alt}
      data-caption={image.caption ?? ''} data-fit={image.fit ?? 'cover'} data-position={image.position ?? '50% 50%'}>
      <img src={image.src} alt="" style={caseImageStyle(image)} loading="lazy" decoding="async" />
    </button>)}
  </div>}
</case-gallery>

<script>
  class CaseGallery extends HTMLElement {
    connectedCallback() {
      const image = this.querySelector<HTMLImageElement>('[data-main-image]');
      const caption = this.querySelector<HTMLElement>('[data-main-caption]');
      const controls = this.querySelector<HTMLElement>('.case-thumbnails');
      if (!image || !caption || !controls) return;
      const buttons = Array.from(controls.querySelectorAll('button'));
      this.addEventListener('click', event => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest('button');
        if (!button || !buttons.includes(button) || !button.dataset.src) return;
        image.src = button.dataset.src;
        image.alt = button.dataset.alt ?? '';
        image.style.objectFit = button.dataset.fit ?? 'cover';
        image.style.objectPosition = button.dataset.position ?? '50% 50%';
        caption.textContent = button.dataset.caption ?? '';
        caption.hidden = !caption.textContent;
        for (const item of buttons) item.setAttribute('aria-pressed', String(item === button));
      });
      controls.hidden = false;
    }
  }
  customElements.define('case-gallery', CaseGallery);
</script>

<style>
  case-gallery { display: block; min-width: 0; }
  figure { margin: 0; }
  .case-main-frame {
    overflow: hidden;
    border: 1px solid #e0e7ef;
    border-radius: 6px;
    aspect-ratio: 1;
    background: #f3f5f8;
  }
  img { display: block; width: 100%; height: 100%; }
  figcaption { margin-top: .625rem; font-size: .875rem; color: #516176; }
  .case-thumbnails:not([hidden]) { display: flex; flex-wrap: wrap; gap: .625rem; margin-top: .75rem; }
  button { width: 4rem; aspect-ratio: 1; border: 1px solid #cbd5e1; border-radius: 5px; overflow: hidden; padding: 0; cursor: pointer; background: #f3f5f8; }
  button[aria-pressed="true"] { border: 2px solid var(--color-secondary-600); }
</style>
