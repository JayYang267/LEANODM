---
import { caseImageStyle, caseStudyPath, type CaseStudy } from '../../data/case-studies';

interface Props {
  study: CaseStudy;
  eager?: boolean;
}
const { study: { data }, eager = false } = Astro.props;
const titleId = `case-card-${data.slug}`;
---

<article>
  <a class="case-card" href={caseStudyPath(data.slug)} aria-labelledby={titleId}>
    <img src={data.cover.src} alt={data.cover.alt} style={caseImageStyle(data.cover)}
      loading={eager ? 'eager' : 'lazy'} decoding="async" />
    <div class="case-card-caption">
      <p>{data.category}</p>
      <h3 id={titleId}>{data.title}</h3>
    </div>
  </a>
</article>

<style>
  .case-card {
    position: relative;
    isolation: isolate;
    display: block;
    overflow: hidden;
    aspect-ratio: 416 / 350;
    border-radius: 6px;
    background: #edf0f3;
    color: #fff;
  }
  .case-card img { width: 100%; height: 100%; display: block; transition: transform 260ms ease; }
  .case-card-caption {
    position: absolute;
    inset: auto 0 0;
    padding: .5rem clamp(1.25rem, 3.45vw, 3.125rem) clamp(1.25rem, 2.8vw, 2.5rem);
    background: linear-gradient(180deg, rgb(12 22 40 / 68%), rgb(12 22 40 / 91%));
    overflow-wrap: anywhere;
  }
  .case-card-caption::before {
    content: '';
    position: absolute;
    inset: auto 0 100%;
    height: 2rem;
    background: linear-gradient(transparent, rgb(12 22 40 / 68%));
    pointer-events: none;
  }
  .case-card-caption p { margin: 0 0 .375rem; color: #fff; font-size: .875rem; font-weight: 600; }
  .case-card-caption h3 { margin: 0; color: #fff; font-size: clamp(1.25rem, 2.15vw, 1.625rem); font-weight: 700; line-height: 1.2; }
  .case-card:focus-visible { outline: 3px solid var(--color-secondary-600); outline-offset: 4px; }
  .case-card:is(:hover, :focus-visible) h3 { text-decoration: underline; text-underline-offset: .2em; }
  @media (hover: hover) { .case-card:hover img { transform: scale(1.035); } }
  @media (min-width: 640px) and (max-width: 991px) { .case-card { aspect-ratio: 336 / 350; } }
  @media (max-width: 639px) { .case-card { aspect-ratio: 366 / 350; } }
  @media (prefers-reduced-motion: reduce) { .case-card img { transition: none; transform: none; } }
</style>
