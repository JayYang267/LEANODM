---
import BrandWordmark from './BrandWordmark.astro';
import { leanNavigation, leanPrimaryNavigation, leanSecondaryNavigation } from './leanNavigation';

interface Props {
  contactHref?: string;
  contactLabel?: string;
}

const {
  contactHref = '#project-requirements',
  contactLabel = 'Discuss Your Project',
} = Astro.props;

const pages = Object.keys(import.meta.glob('/src/pages/**/*.astro'));
const hasPage = (path: string) => pages.some((file) => {
  const normalized = file.replace(/^\/src\/pages\//, '/').replace(/index\.astro$/, '').replace(/\.astro$/, '/');
  return normalized === path;
});
const isLocalAnchor = (href: string) => href.startsWith('#');
const isAvailable = (href: string) => isLocalAnchor(href) || hasPage(href);
---

<header class="lean-global-header">
  <div class="lean-global-inner">
    <a href="/" aria-label="LEANODM home" class="lean-global-brand">
      <img src="/brand/xinyinhai-symbol.png" alt="" width="44" height="44" />
      <BrandWordmark />
    </a>

    <nav class="lean-global-desktop" aria-label="LEANODM global navigation">
      {leanPrimaryNavigation.map((item) => (
        isAvailable(item.href)
          ? <a href={item.href}>{item.label}</a>
          : <span class="lean-global-planned" aria-disabled="true" title={`${item.label} page is planned`}>{item.label}<small>Soon</small></span>
      ))}
    </nav>

    <div class="lean-global-actions">
      <nav class="lean-global-secondary" aria-label="LEANODM secondary navigation">
        {leanSecondaryNavigation.map((item) => (
          isAvailable(item.href)
            ? <a href={item.href}>{item.label}</a>
            : <span class="lean-global-planned is-secondary" aria-disabled="true" title={`${item.label} page is planned`}>{item.label}<small>Soon</small></span>
        ))}
      </nav>
      <a class="lean-global-contact" href={contactHref}>{contactLabel}</a>
    </div>

    <details class="lean-global-mobile">
      <summary>
        <span>Nav</span>
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
          <path d="M4 6h12M4 10h12M4 14h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </summary>
      <nav class="lean-global-panel" aria-label="LEANODM mobile navigation">
        {leanNavigation.map((item) => (
          isAvailable(item.href)
            ? <a class:list={{ 'is-secondary': item.secondary }} href={item.href}>{item.label}</a>
            : <span class:list={['lean-global-planned', { 'is-secondary': item.secondary }]} aria-disabled="true" title={`${item.label} page is planned`}>{item.label}<small>Soon</small></span>
        ))}
        <a class="lean-global-contact" href={contactHref}>{contactLabel}</a>
      </nav>
    </details>
  </div>
</header>

<script is:inline>
  document.querySelectorAll('.lean-global-mobile').forEach((menu) => {
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  });
</script>

<style>
  .lean-global-header {
    position: sticky;
    top: 0;
    z-index: 70;
    width: 100%;
    border-bottom: 1px solid #dfe6f1;
    background: rgb(255 255 255 / 98%);
    box-shadow: 0 1px 3px rgb(15 23 42 / 4%);
    backdrop-filter: blur(12px);
  }

  .lean-global-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: min(100%, 1280px);
    min-height: 68px;
    margin-inline: auto;
    padding: 0.65rem 1rem;
  }

  .lean-global-brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    min-width: 0;
  }

  .lean-global-brand > img {
    width: 38px;
    height: 38px;
    object-fit: contain;
  }

  .lean-global-header a,
  .lean-global-header summary,
  .lean-global-planned {
    border-radius: 0.375rem;
  }

  .lean-global-header a:focus-visible,
  .lean-global-header summary:focus-visible {
    outline: 3px solid #183ba3;
    outline-offset: 3px;
  }

  .lean-global-desktop,
  .lean-global-secondary,
  .lean-global-actions {
    display: none;
  }

  .lean-global-mobile > summary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.5rem 0.65rem;
    color: #26364d;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 650;
    list-style: none;
  }

  .lean-global-mobile > summary::-webkit-details-marker {
    display: none;
  }

  .lean-global-panel {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    display: grid;
    grid-template-columns: 1fr;
    max-height: calc(100dvh - 68px);
    overflow-y: auto;
    padding: 0.75rem 1rem 1rem;
    border-bottom: 1px solid #dfe6f1;
    background: white;
    box-shadow: 0 16px 24px rgb(15 23 42 / 9%);
  }

  .lean-global-panel > a,
  .lean-global-panel > .lean-global-planned {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.7rem 0.75rem;
    color: #26364d;
    font-size: 0.94rem;
    font-weight: 600;
  }

  .lean-global-panel > a.is-secondary,
  .lean-global-panel > .lean-global-planned.is-secondary {
    color: #5f6f84;
    font-size: 0.86rem;
    font-weight: 550;
  }

  .lean-global-planned {
    color: #78869a;
    cursor: default;
  }

  .lean-global-planned small {
    color: #9aa6b6;
    font-size: 0.55rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .lean-global-desktop > a:hover,
  .lean-global-secondary > a:hover,
  .lean-global-panel > a:hover {
    color: #c71923;
    background: #fff1f2;
  }

  a.lean-global-contact {
    justify-content: center;
    min-height: 42px;
    padding: 0.68rem 1rem;
    color: white;
    background: #e62129;
    font-size: 0.84rem;
    font-weight: 700;
    text-align: center;
  }

  a.lean-global-contact:hover {
    color: white;
    background: #c71923;
  }

  .lean-global-panel > .lean-global-contact {
    margin-top: 0.4rem;
  }

  @media (max-width: 359px) {
    .lean-global-brand :global(.brand-wordmark) {
      width: 132px;
    }

    .lean-global-inner {
      gap: 0.35rem;
      padding-inline: 0.75rem;
    }

    .lean-global-mobile > summary {
      padding-inline: 0.35rem;
    }
  }

  @media (min-width: 640px) {
    .lean-global-inner {
      padding-inline: 1.5rem;
    }

    .lean-global-panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 0.35rem;
    }
  }

  @media (min-width: 1120px) {
    .lean-global-inner {
      display: grid;
      grid-template-columns: 250px minmax(0, 1fr) auto;
      grid-template-rows: auto auto;
      align-items: center;
      column-gap: 1rem;
      row-gap: 0;
      min-height: 92px;
      padding: 0.55rem 2rem 0.45rem;
    }

    .lean-global-brand {
      grid-row: 1 / 3;
    }

    .lean-global-desktop {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 0.1rem;
      min-width: 0;
    }

    .lean-global-desktop > a,
    .lean-global-desktop > .lean-global-planned {
      display: flex;
      min-height: 40px;
      align-items: center;
      gap: 0.28rem;
      padding: 0.45rem 0.5rem;
      color: #26364d;
      font-size: 0.78rem;
      font-weight: 650;
      white-space: nowrap;
    }

    .lean-global-actions {
      display: contents;
    }

    .lean-global-secondary {
      display: flex;
      grid-column: 2;
      grid-row: 2;
      align-items: center;
      justify-content: flex-start;
      gap: 0.1rem;
    }

    .lean-global-secondary > a,
    .lean-global-secondary > .lean-global-planned {
      display: flex;
      min-height: 40px;
      align-items: center;
      gap: 0.25rem;
      padding: 0.45rem 0.4rem;
      color: #607089;
      font-size: 0.72rem;
      font-weight: 600;
      white-space: nowrap;
    }

    .lean-global-actions > .lean-global-contact {
      display: inline-flex;
      grid-column: 3;
      grid-row: 1;
      align-items: center;
      justify-self: end;
    }

    .lean-global-mobile {
      display: none;
    }
  }

  @media (min-width: 1240px) {
    .lean-global-desktop > a {
      padding-inline: 0.6rem;
      font-size: 0.82rem;
    }

    .lean-global-secondary > a {
      padding-inline: 0.48rem;
    }
  }

  @media (min-width: 1120px) {
    .lean-global-desktop > .lean-global-planned small,
    .lean-global-secondary > .lean-global-planned small {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @media (min-width: 1360px) {
    .lean-global-inner {
      grid-template-columns: 250px minmax(0, 1fr) auto;
    }

    .lean-global-desktop > a,
    .lean-global-desktop > .lean-global-planned {
      padding-inline: 0.7rem;
      font-size: 0.86rem;
    }

    .lean-global-secondary > a,
    .lean-global-secondary > .lean-global-planned {
      padding-inline: 0.55rem;
      font-size: 0.76rem;
    }
  }
</style>
