---
import BrandWordmark from './BrandWordmark.astro';
import LeanCustomizationMenu from './LeanCustomizationMenu.astro';
import LeanNavigationMenu from './LeanNavigationMenu.astro';
import { leanPrimaryNavigation, leanSecondaryNavigation, leanCustomizationNavigation, leanModularNavigation, leanInquiryNavigation, inquiryHrefForPage, type LeanNavigationItem } from './leanNavigation';

const contactHref = inquiryHrefForPage(Astro.url.pathname);
const contactLabel = leanInquiryNavigation.label;

const pages = Object.keys(import.meta.glob('/src/pages/**/*.astro'));
const hasPage = (path: string) => pages.some((file) => {
  const normalized = file.replace(/^\/src\/pages\//, '/').replace(/index\.astro$/, '').replace(/\.astro$/, '/');
  return normalized === path;
});
const isLocalAnchor = (href: string) => href.startsWith('#');
const isAvailable = (href: string) => isLocalAnchor(href) || hasPage(href);
const customizationLinks = leanCustomizationNavigation.filter(link => isAvailable(link.href));
const modularMenus = Object.fromEntries(Object.entries(leanModularNavigation).map(([label, menu]) => [label, { ...menu, links: menu.links.filter(link => isAvailable(link.href)) }]));
const groupedNavigation: Record<string, readonly LeanNavigationItem[]> = {
  'ODM & OEM': leanCustomizationNavigation,
  ...Object.fromEntries(Object.entries(modularMenus).map(([label, menu]) => [label, menu.links])),
};
const primaryNavigation = leanPrimaryNavigation.flatMap((item) => {
  const links = groupedNavigation[item.label]?.filter(link => isAvailable(link.href));
  return links?.length ? [{ ...item, links }] : isAvailable(item.href) ? [{ ...item, links: undefined }] : [];
});
const secondaryNavigation = leanSecondaryNavigation.filter(item => isAvailable(item.href));
const isCurrent = (href: string) => Astro.url.pathname.replace(/\/$/, '') === href.replace(/\/$/, '');
const isInSection = (href: string) => isCurrent(href) || Astro.url.pathname.startsWith(href);
---

<header class="lean-global-header">
  <div class="lean-global-inner">
    <a href="/" aria-label="LEANODM home" class="lean-global-brand">
      <img src="/brand/xinyinhai-symbol-display-96.webp" srcset="/brand/xinyinhai-symbol-display-48.webp 48w, /brand/xinyinhai-symbol-display-96.webp 96w, /brand/xinyinhai-symbol-display-144.webp 144w" sizes="38px" alt="" width="44" height="44" />
      <BrandWordmark />
    </a>

    <nav class="lean-global-desktop" aria-label="LEANODM global navigation">
      {primaryNavigation.map((item) => item.links ? (
        item.overview ? <details class:list={['lean-quality-menu', 'lean-nav-group', { 'lean-modular-nav-group': !!modularMenus[item.label], 'is-active': isInSection(item.href) || item.links.some(link => isInSection(link.href)) }]}>
          <summary>{item.label} <span aria-hidden="true">⌄</span></summary>
          <nav class:list={['lean-quality-panel', { 'lean-modular-panel': !!modularMenus[item.label], 'lean-modular-panel-wide': modularMenus[item.label]?.columns === 3 }]} aria-label={`${item.label} pages`}>
            {modularMenus[item.label] ? <LeanNavigationMenu menu={modularMenus[item.label]} pathname={Astro.url.pathname} overviewHref={item.href} /> : <><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label} overview</a>{item.links.map(link => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}</>}
          </nav>
        </details> :
        <details class:list={['lean-quality-menu', { 'lean-customization-menu': item.label === 'ODM & OEM', 'is-active': isInSection(item.href) || item.links.some(link => isInSection(link.href)) }]}>
          <summary>{item.label} <span aria-hidden="true">⌄</span></summary>
          <nav class:list={['lean-quality-panel', { 'lean-customization-panel': item.label === 'ODM & OEM' }]} aria-label={`${item.label} pages`}>
            {item.label === 'ODM & OEM' ? <LeanCustomizationMenu links={customizationLinks} pathname={Astro.url.pathname} /> : item.links.map(link => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
          </nav>
        </details>
      ) : <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>

    <div class="lean-global-actions">
      {secondaryNavigation.length > 0 && <nav class="lean-global-secondary" aria-label="LEANODM secondary navigation">
        {secondaryNavigation.map(item => <a href={item.href}>{item.label}</a>)}
      </nav>}
      <a class="lean-global-contact" href={contactHref}>{contactLabel}</a>
    </div>

    <details class="lean-global-mobile">
      <summary>
        <span>Menu</span>
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
          <path d="M4 6h12M4 10h12M4 14h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </summary>
      <nav class="lean-global-panel" aria-label="LEANODM mobile navigation">
        <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Home</a>
        {primaryNavigation.map(item => item.links ? (
          <div class="lean-mobile-quality">{item.overview ? <a class="lean-mobile-overview" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}<span aria-hidden="true">↗</span></a> : <span>{item.label}</span>}{item.label === 'ODM & OEM' ? <LeanCustomizationMenu links={customizationLinks} pathname={Astro.url.pathname} /> : modularMenus[item.label] ? <LeanNavigationMenu menu={modularMenus[item.label]} pathname={Astro.url.pathname} /> : item.links.map(link => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}</div>
        ) : <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
        {secondaryNavigation.map(item => <a class="is-secondary" href={item.href}>{item.label}</a>)}
        <a class="lean-global-contact" href={contactHref}>{contactLabel}</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('.lean-global-mobile, .lean-quality-menu, .technical-mobile-menu')];
  const desktop = window.matchMedia('(min-width: 1120px)');
  const closeTimers = new Map<HTMLDetailsElement, number>();
  const cancelClose = (menu: HTMLDetailsElement) => {
    window.clearTimeout(closeTimers.get(menu));
    closeTimers.delete(menu);
  };
  const closeMenu = (menu: HTMLDetailsElement) => {
    cancelClose(menu);
    menu.open = false;
  };
  menus.forEach((menu) => {
    const region = menu.closest<HTMLElement>('.lean-nav-group') ?? menu;
    let mouseInside = false;
    const closeAfterLeaving = () => {
      cancelClose(menu);
      closeTimers.set(menu, window.setTimeout(() => {
        closeTimers.delete(menu);
        if (!mouseInside && !region.contains(document.activeElement)) menu.open = false;
      }, 160));
    };
    menu.addEventListener('toggle', () => {
      if (menu.open) menus.forEach(other => { if (other !== menu) closeMenu(other); });
    });
    menu.addEventListener('click', (event) => {
      cancelClose(menu);
      if (event.target instanceof Element && event.target.closest('a')) closeMenu(menu);
    });
    if (menu.closest('.lean-global-desktop')) {
      region.addEventListener('pointerenter', (event) => {
        if (!desktop.matches || event.pointerType !== 'mouse') return;
        mouseInside = true;
        cancelClose(menu);
        const focusedPanel = menus.some(other => other !== menu && other.open && other.querySelector('.lean-quality-panel')?.contains(document.activeElement));
        if (focusedPanel) return;
        menus.forEach(other => { if (other !== menu) closeMenu(other); });
        menu.open = true;
      });
      region.addEventListener('pointerleave', (event) => {
        if (event.pointerType !== 'mouse') return;
        mouseInside = false;
        closeAfterLeaving();
      });
      region.addEventListener('focusout', (event) => {
        if (!mouseInside && (!(event.relatedTarget instanceof Node) || !region.contains(event.relatedTarget))) closeAfterLeaving();
      });
      desktop.addEventListener('change', () => { mouseInside = false; });
    }
  });
  document.addEventListener('click', (event) => {
    menus.forEach((menu) => {
      if (event.target instanceof Node && !menu.contains(event.target)) closeMenu(menu);
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    menus.forEach((menu) => {
      if (!menu.open) return;
      const restoreFocus = menu.contains(document.activeElement);
      closeMenu(menu);
      if (restoreFocus) menu.querySelector<HTMLElement>('summary')?.focus();
    });
  });
  desktop.addEventListener('change', () => menus.forEach(closeMenu));
</script>

<style>
  .lean-nav-group { position:relative; flex-shrink:0; }
  .lean-nav-group { border-radius:0.375rem; }
  .lean-nav-group.is-active, .lean-nav-group[open] { color:#183ba3; background:#f1f5fb; }
  .lean-quality-menu { position:relative; }
  .lean-quality-menu summary { cursor:pointer; list-style:none; display:flex; gap:5px; align-items:center; min-height:44px; padding:8px 0; color:#26364d; font-size:.875rem; font-weight:650; }
  .lean-quality-menu summary::-webkit-details-marker { display:none; }
  .lean-quality-panel { position:absolute; top:100%; left:0; width:320px; max-width:calc(100vw - 32px); max-height:calc(100dvh - var(--lean-global-header-height) - 16px); overflow-y:auto; overscroll-behavior:contain; padding:10px; border:1px solid #dce3ec; background:white; box-shadow:0 12px 30px #17233520; border-radius:5px; }
  .lean-global-desktop > .lean-quality-menu:not(.lean-modular-nav-group):last-child .lean-quality-panel,
  .lean-global-desktop > .lean-nav-group:not(.lean-modular-nav-group):last-child .lean-quality-panel { left:auto; right:0; }
  .lean-quality-panel a { display:block; min-height:44px; padding:11px 12px; }
  .lean-quality-panel a:hover,.lean-quality-panel a[aria-current] { background:#f1f5fb; color:#183ba3; }
  .lean-customization-menu { position:static; }
  .lean-customization-panel { top:calc(100% - 1px); left:50%; width:760px; max-width:calc(100vw - 48px); padding:0; transform:translateX(-50%); border-radius:10px; box-shadow:0 20px 48px #17233524; }
  .lean-modular-nav-group { position:static; }
  .lean-modular-panel { top:calc(100% - 1px); left:50%; right:auto; width:760px; max-width:calc(100vw - 48px); padding:0; transform:translateX(-50%); border-radius:10px; box-shadow:0 20px 48px #17233524; }
  .lean-modular-panel-wide { width:980px; }
  .lean-quality-menu summary:focus-visible { outline:3px solid #183ba3; outline-offset:5px; }
  .lean-quality-menu.is-active > summary, .lean-global-header a[aria-current] { color:#183ba3; background:#f1f5fb; }
  .lean-quality-menu[open] > summary { color:#183ba3; background:#f1f5fb; }
  .lean-quality-menu summary > span { display:inline-flex; line-height:1; transition:transform 150ms ease; }
  .lean-quality-menu[open] > summary > span { transform:rotate(180deg); }
  .lean-mobile-quality { grid-column:1 / -1; border-top:1px solid #dce3ec; margin-top:8px; padding-top:10px; }
  .lean-mobile-quality>span { font-size:.7rem; color:#56657a; display:block; padding:8px 12px; }
  .lean-mobile-quality a { display:flex; align-items:center; min-height:44px; padding:10px 12px; font-size:.9rem; color:#26364d; font-weight:600; }
  .lean-mobile-quality > .lean-mobile-overview { justify-content:space-between; margin-bottom:4px; color:#183ba3; background:#f1f5fb; }
  .lean-global-header {
    position: sticky;
    top: 0;
    z-index: 70;
    width: 100%;
    border-bottom: 1px solid #dfe6f1;
    background: rgb(255 255 255 / 98%);
    box-shadow: 0 1px 3px rgb(15 23 42 / 4%);
    backdrop-filter: blur(12px);
  }

  .lean-global-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: min(100%, 1280px);
    min-height: calc(var(--lean-global-header-height) - 1px);
    margin-inline: auto;
    padding: 0.65rem 1rem;
  }

  .lean-global-brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    min-width: 0;
  }

  .lean-global-brand > img {
    width: 38px;
    height: 38px;
    object-fit: contain;
  }

  .lean-global-header a,
  .lean-global-header summary {
    border-radius: 0.375rem;
  }

  .lean-global-header a:focus-visible,
  .lean-global-header summary:focus-visible {
    outline: 3px solid #183ba3;
    outline-offset: 3px;
  }

  .lean-global-desktop,
  .lean-global-secondary,
  .lean-global-actions {
    display: none;
  }

  .lean-global-mobile > summary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.5rem 0.65rem;
    color: #26364d;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 650;
    list-style: none;
  }

  .lean-global-mobile > summary::-webkit-details-marker {
    display: none;
  }

  .lean-global-panel {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    display: grid;
    grid-template-columns: 1fr;
    max-height: calc(100dvh - var(--lean-global-header-height));
    overflow-y: auto;
    padding: 0.75rem 1rem 1rem;
    border-bottom: 1px solid #dfe6f1;
    background: white;
    box-shadow: 0 16px 24px rgb(15 23 42 / 9%);
  }

  .lean-global-panel > a {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.7rem 0.75rem;
    color: #26364d;
    font-size: 0.94rem;
    font-weight: 600;
  }

  .lean-global-panel > a.is-secondary {
    color: #5f6f84;
    font-size: 0.86rem;
    font-weight: 550;
  }

  .lean-global-desktop > a:hover,
  .lean-global-secondary > a:hover,
  .lean-global-panel > a:hover {
    color: #c71923;
    background: #fff1f2;
  }

  a.lean-global-contact,
  .lean-global-panel > a.lean-global-contact {
    justify-content: center;
    min-height: 44px;
    padding: 0.68rem 1rem;
    color: white;
    background: #e62129;
    font-size: 0.84rem;
    font-weight: 700;
    text-align: center;
    white-space: nowrap;
  }

  a.lean-global-contact:hover,
  .lean-global-panel > a.lean-global-contact:hover {
    color: white;
    background: #c71923;
  }

  .lean-global-panel > .lean-global-contact {
    margin-top: 0.4rem;
  }

  @media (max-width: 359px) {
    .lean-global-brand :global(.brand-wordmark) {
      width: 132px;
    }

    .lean-global-inner {
      gap: 0.35rem;
      padding-inline: 0.75rem;
    }

    .lean-global-mobile > summary {
      padding-inline: 0.35rem;
    }
  }

  @media (min-width: 640px) {
    .lean-global-inner {
      padding-inline: 1.5rem;
    }

    .lean-global-panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 0.35rem;
    }
  }

  @media (min-width: 1120px) {
    .lean-global-inner {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 1rem;
      row-gap: 0;
      padding: 0.65rem 2rem;
    }

    .lean-global-desktop {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.1rem;
      min-width: 0;
    }

    .lean-global-desktop > a,
    .lean-global-desktop > .lean-quality-menu > summary {
      display: flex;
      min-height: 44px;
      align-items: center;
      gap: 0.28rem;
      padding: 0.45rem 0.5rem;
      color: #26364d;
      font-size: 0.84rem;
      font-weight: 650;
      white-space: nowrap;
    }

    .lean-global-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .lean-global-secondary {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 0.1rem;
    }

    .lean-global-secondary > a {
      display: flex;
      min-height: 44px;
      align-items: center;
      gap: 0.25rem;
      padding: 0.45rem 0.4rem;
      color: #607089;
      font-size: 0.82rem;
      font-weight: 600;
      white-space: nowrap;
    }

    .lean-global-actions > .lean-global-contact {
      display: inline-flex;
      align-items: center;
      justify-self: end;
    }

    .lean-global-mobile {
      display: none;
    }
  }

  @media (min-width: 1240px) {
    .lean-global-desktop > a,
    .lean-nav-parent,
    .lean-global-desktop > .lean-quality-menu > summary {
      padding-inline: 0.6rem;
      font-size: 0.82rem;
    }

    .lean-global-secondary > a {
      padding-inline: 0.48rem;
    }
  }

  @media (min-width: 1360px) {
    .lean-global-desktop > a,
    .lean-nav-parent,
    .lean-global-desktop > .lean-quality-menu > summary {
      padding-inline: 0.7rem;
      font-size: 0.86rem;
    }

    .lean-global-secondary > a {
      padding-inline: 0.55rem;
      font-size: 0.76rem;
    }
  }

  @media (min-width: 1120px) {
    .lean-nav-group > summary { border-radius:0.375rem; }
    .lean-nav-group:is(:hover,:focus-within,[open],.is-active) > summary { color:#183ba3; background:#f1f5fb; }
  }

  @media (min-width: 1120px) and (any-hover: hover) {
    .lean-global-desktop > .lean-quality-menu > summary:hover { color:#183ba3; background:#f1f5fb; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lean-quality-menu summary > span { transition:none; }
  }
</style>
