---
const endpoint = import.meta.env.PUBLIC_FACTORY_VISIT_ENDPOINT?.trim() || import.meta.env.PUBLIC_RFQ_ENDPOINT?.trim() || '';
---

<form id="factory-visit-form" name="factory-visit" method="post" data-visit-form data-endpoint={endpoint} aria-labelledby="factory-visit-title">
  <fieldset data-visit-fields>
    <legend class="rfq-sr-only">Factory visit request</legend>
    <div class="visit-fields-grid">
      <div class="rfq-field"><label for="visit-name">Full name <span class="rfq-required">Required</span></label><input id="visit-name" name="name" autocomplete="name" maxlength="120" required aria-describedby="visit-name-error" /><p class="rfq-field-error" id="visit-name-error" data-visit-error="name" hidden></p></div>
      <div class="rfq-field"><label for="visit-email">Email <span class="rfq-required">Required</span></label><input id="visit-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="visit-email-error" /><p class="rfq-field-error" id="visit-email-error" data-visit-error="email" hidden></p></div>
      <div class="rfq-field"><label for="visit-date">Preferred visit date <span class="rfq-required">Required</span></label><input id="visit-date" name="preferredDate" type="date" required aria-describedby="visit-timezone visit-date-hint visit-preferredDate-error" /><p id="visit-date-hint" class="rfq-field-hint">A preferred date is a request, subject to availability and confirmation.</p><p class="rfq-field-error" id="visit-preferredDate-error" data-visit-error="preferredDate" hidden></p></div>
      <div class="rfq-field"><label for="visit-time">Preferred time <span class="rfq-optional">Optional</span></label><select id="visit-time" name="preferredTime" aria-describedby="visit-timezone"><option value="no-preference">No preference</option><option value="morning">Morning</option><option value="afternoon">Afternoon</option></select></div>
    </div>
    <p id="visit-timezone" class="visit-timezone">Factory local time — China Standard Time (UTC+8)<span>Asia/Shanghai</span></p>
    <details class="visit-optional"><summary>Add optional visit details</summary><div class="visit-optional-body">
      <div class="visit-fields-grid">
        <div class="rfq-field"><label for="visit-company">Company <span class="rfq-optional">Optional</span></label><input id="visit-company" name="company" autocomplete="organization" maxlength="160" /></div>
        <div class="rfq-field"><label for="visit-visitors">Number of visitors <span class="rfq-optional">Optional</span></label><input id="visit-visitors" name="visitors" type="number" min="1" step="1" inputmode="numeric" aria-describedby="visit-visitors-error" /><p class="rfq-field-error" id="visit-visitors-error" data-visit-error="visitors" hidden></p></div>
      </div>
      <div class="rfq-field"><label for="visit-discussion">What would you like to discuss? <span class="rfq-optional">Optional</span></label><textarea id="visit-discussion" name="discussion" rows="3" maxlength="3000" placeholder="A product idea, development needs or a manufacturing question…"></textarea></div>
    </div></details>
  </fieldset>
  <p class="visit-confirmation-note">Your visit is subject to confirmation. Our team will email you to confirm the date and arrangements.</p>
  {!endpoint && <p class="visit-offline-note">Online sending is currently unavailable. Copy your visit request or open an email draft, then send it to <a href="mailto:quotes@leanodm.com">quotes@leanodm.com</a>.</p>}
  <div data-visit-status class="rfq-status" role="status" aria-live="polite" tabindex="-1" hidden></div>
  <div class="visit-actions"><button type="submit" class="rfq-primary-button" data-visit-submit disabled>{endpoint ? 'Request a Factory Visit' : 'Copy visit request'}</button><button type="button" class="rfq-text-button" data-visit-copy hidden={!endpoint}>Copy visit request</button><a class="rfq-email-button" data-visit-email href="mailto:quotes@leanodm.com">Open email draft</a></div>
  <p class="rfq-action-hint">Copying a request or opening a draft does not send it. Please complete sending in your email app.</p>
  <section class="rfq-brief-fallback" data-visit-fallback hidden><label for="visit-copy-text">Your visit request</label><p>Select and copy this text, then send it by email.</p><textarea id="visit-copy-text" data-visit-text rows="9" readonly></textarea></section>
  <noscript><p class="rfq-no-script">Enable JavaScript to prepare this request, or email your name, preferred visit date and time in China Standard Time (UTC+8) to <a href="mailto:quotes@leanodm.com">quotes@leanodm.com</a>. The team will confirm the arrangements.</p></noscript>
</form>
<script>import '../scripts/factory-visit';</script>
