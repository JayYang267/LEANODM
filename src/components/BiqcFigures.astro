---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Figure {
  asset: string;
  alt: string;
  caption?: string;
}
interface Props {
  figures: readonly Figure[];
  group?: string;
}

const { figures, group } = Astro.props;
const sources = import.meta.glob<{ default: ImageMetadata }>('../assets/biqc-training/*.{png,jpeg,jpg,webp}', { eager: true });
const items = await Promise.all(figures.map(async (figure) => {
  const source = sources[`../assets/biqc-training/${figure.asset}`]?.default;
  if (!source) throw new Error(`Missing BIQC training image: ${figure.asset}`);
  const thumb = await getImage({ src: source, width: Math.min(source.width, 520), format: 'webp', quality: 86 });
  const full = await getImage({ src: source, width: Math.min(source.width, 1400), format: 'webp', quality: 92 });
  return { ...figure, thumb, full };
}));
---

<div class="biqc-figures">
  {items.map(({ thumb, full, alt, caption }) => (
    <figure>
      <a href={full.src} data-lightbox={group} data-title={caption ?? alt} data-width={full.attributes.width} data-height={full.attributes.height} aria-label={`View training image: ${caption ?? alt}`}>
        <img src={thumb.src} width={thumb.attributes.width} height={thumb.attributes.height} alt={alt} loading="lazy" decoding="async" />
      </a>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .biqc-figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1rem;
    margin-block: 1rem;
  }
  figure { margin: 0; min-width: 0; max-width: 32rem; }
  a {
    display: block;
    position: relative;
    min-height: 6rem;
    aspect-ratio: 4 / 3;
    background: #f1f4f5;
    border: 1px solid #dbe2e4;
    border-radius: .4rem;
    overflow: hidden;
  }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  img { display: block; position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  figcaption { margin-block-start: .45rem; font-size: .875rem; line-height: 1.5; }
</style>
