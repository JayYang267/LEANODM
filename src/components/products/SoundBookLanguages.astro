---
import '../../styles/sound-book-languages.css';

const animals = ['cat', 'dog', 'bird', 'cow', 'duck', 'sheep'] as const;
const languages = [
  { code: 'en', name: 'English', native: 'English', direction: 'ltr', title: 'Animal Sounds', labels: ['Cat', 'Dog', 'Bird', 'Cow', 'Duck', 'Sheep'], page: 'This is a cat.', script: 'The cat says meow.' },
  { code: 'ja', name: 'Japanese', native: '日本語', direction: 'ltr', title: 'どうぶつのこえ', labels: ['ねこ', 'いぬ', 'とり', 'うし', 'あひる', 'ひつじ'], page: 'ねこだよ。', script: 'ねこが「にゃー」となくよ。' },
  { code: 'ar', name: 'Arabic', native: 'العربية', direction: 'rtl', title: 'أصوات الحيوانات', labels: ['قطة', 'كلب', 'طائر', 'بقرة', 'بطة', 'خروف'], page: 'هذه قطة.', script: 'تقول القطة: مياو.' },
] as const;

// Original, code-drawn animal signs. They represent a layout study, not controls.
const symbols = {
  cat: '<path d="M14 29 13 9l17 13h4L51 9l-1 20v10c0 13-36 13-36 0Z" fill="#e9ac62"/><path d="m17 16 8 8h-8Zm30 0-8 8h8Z" fill="#e8b7a3"/><circle cx="24" cy="33" r="2.4"/><circle cx="41" cy="33" r="2.4"/><path d="m29 39 6 0-3 4Z"/><path d="M32 43q-4 6-8 0m8 0q4 6 8 0M7 35l12 3M6 43l13-2m26-3 12-3M45 41l13 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  dog: '<ellipse cx="32" cy="34" rx="20" ry="23" fill="#e8b77a"/><path d="M20 13C0 11 2 47 13 48c8 0 10-25 7-35Zm24 0c20-2 18 34 7 35-8 0-10-25-7-35Z" fill="#a46b45"/><ellipse cx="32" cy="43" rx="12" ry="10" fill="#fff1d8"/><circle cx="24" cy="31" r="2.4"/><circle cx="40" cy="31" r="2.4"/><path d="M26 39q6-5 12 0-6 11-12 0Z"/><path d="M32 45v5m0 0q-6 3-9-1m9 1q6 3 9-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  bird: '<path d="M13 40 4 31l13 2c-3-27 36-28 36-4v8c0 22-37 24-40 3Z" fill="#79a9c4"/><path d="M19 34c3 13 16 15 23 1-12 6-15-4-23-1Z" fill="#507f9f"/><path d="m52 26 11 5-11 5Z" fill="#e7ad50"/><circle cx="44" cy="24" r="2.5"/><path d="M27 52v7m13-7v7m-17 0h8m5 0h8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  cow: '<path d="M16 16 8 4l1 17m39-5 8-12-1 17" fill="#d5b779" stroke="currentColor" stroke-width="1.5"/><path d="M16 21C1 10 1 31 13 31m35-10c15-11 15 10 3 10" fill="#bb8063"/><path d="M13 21q19-20 38 0v25q-19 16-38 0Z" fill="#fff0d6"/><path d="M15 22q12-10 14 7l-5 13-11-5Zm22-6 13 7-1 13-10-6Z" fill="#8c6b50"/><ellipse cx="32" cy="45" rx="19" ry="12" fill="#e5af9d"/><circle cx="23" cy="28" r="2.4"/><circle cx="41" cy="28" r="2.4"/><ellipse cx="24" cy="44" rx="2" ry="3"/><ellipse cx="40" cy="44" rx="2" ry="3"/>',
  duck: '<path d="M14 37c-7-25 26-31 31-11l1 10 13-3c-2 26-45 31-49 7Z" fill="#f5e6b9"/><path d="M34 35q-4 12-17 8 5 12 20 1" fill="#e7c97f"/><path d="m16 24-14 5 15 8 8-7Z" fill="#e1a242"/><circle cx="27" cy="22" r="2.5"/><path d="M30 54v6m12-6v6m-17 0h8m4 0h9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  sheep: '<path d="M17 46v13m12-12v12m13-12v12m8-14v14" fill="none" stroke="#8f7054" stroke-width="5" stroke-linecap="round"/><path d="M13 43C0 39 6 23 15 23c-2-15 17-20 23-9 11-8 22 3 18 13 13 9 4 25-6 23-8 10-23 4-24-1-6 5-14 1-13-6Z" fill="#f0e1bd"/><path d="M15 26C1 18 2 37 13 36m17-10c14-8 13 11 2 10" fill="#a88864"/><ellipse cx="23" cy="35" rx="11" ry="15" fill="#b69a75"/><circle cx="19" cy="33" r="2"/><circle cx="27" cy="33" r="2"/><path d="m20 40 6 0-3 3Z"/><circle cx="15" cy="19" r="6" fill="#f8edce"/><circle cx="23" cy="16" r="7" fill="#f8edce"/><circle cx="31" cy="19" r="6" fill="#f8edce"/>',
};
---

<section id="languages" class="sb-section sb-language-section" data-sound-book-languages aria-labelledby="sb-language-heading">
  <div class="sb-container">
    <div class="sb-section-heading">
      <div><p class="sb-eyebrow">LANGUAGE & CONTENT</p><h2 id="sb-language-heading">See your content<br />in another language.</h2></div>
      <p>Preview how a cover, inside page and sound-button labels can work together in English, Japanese or Arabic.</p>
    </div>
    <div class="sb-language-toolbar">
      <div class="sb-language-preview-controls" role="group" aria-label="Preview language">
        {languages.map(language => <button type="button" data-preview-language={language.code} aria-pressed="false" aria-controls={`sb-language-panel-${language.code}`} disabled><span>{language.name}</span>{language.code !== 'en' && <span lang={language.code} dir={language.direction}>{language.native}</span>}</button>)}
      </div>
      <p class="sb-language-preview-note">Preview only. Your inquiry language changes when you choose “Add” below.</p>
    </div>
    <div class="sb-language-preview-stage">
      {languages.map(language => <article id={`sb-language-panel-${language.code}`} class="sb-language-panel" data-language-panel={language.code} aria-labelledby={`sb-language-name-${language.code}`}>
        <div class="sb-language-panel-heading"><h3 id={`sb-language-name-${language.code}`}>{language.name} layout</h3><span>Customization concept</span></div>
        <div class="sb-language-book" dir="ltr">
          <div class="sb-language-spread">
            <div class="sb-language-page sb-language-cover">
              <span class="sb-language-page-label">Cover</span>
              <p class="sb-language-cover-title" lang={language.code} dir={language.direction}>{language.title}</p>
              <img class="sb-language-cover-art" src="/media/sound-book/concept-meadow-art.webp" alt="Original concept illustration of a cat, dog, bird, cow, duck and sheep in a green meadow" width="1200" height="900" loading="lazy" />
            </div>
            <div class="sb-language-page sb-language-inside">
              <span class="sb-language-page-label">Inside page</span>
              <div class="sb-language-inside-art"><img src="/media/sound-book/concept-meadow-art.webp" alt="Detail from the same original meadow illustration" width="1200" height="900" loading="lazy" /></div>
              <p class="sb-language-page-sentence" lang={language.code} dir={language.direction}>{language.page}</p>
            </div>
          </div>
          <div class="sb-language-sound-panel">
            <div class="sb-language-keys" aria-label={`${language.name} concept button labels`}>
              {animals.map((animal, index) => <div class="sb-language-key"><svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"><Fragment set:html={symbols[animal]} /></svg><span lang={language.code} dir={language.direction}>{language.labels[index]}</span></div>)}
            </div>
            <div class="sb-language-speaker" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
          </div>
        </div>
        <div class="sb-language-script"><div><span>Audio script example</span><p lang={language.code} dir={language.direction}>{language.script}</p><small>Script example — not an audio recording.</small></div><button type="button" class="sb-language-add" data-add-inquiry-language={language.name} disabled>Add {language.name} to my inquiry <span aria-hidden="true">↗</span></button></div>
      </article>)}
    </div>
    <p class="sb-language-concept-note">Original artwork and layout study, not an existing sample or a verified engineering or audio specification. The six illustrated labels show a possible layout; the artwork repeats across these language previews.</p>
    <p class="sb-language-scope">A reference photograph shows its printed edition, not the available audio languages. Review translated print separately from recording, voice and pronunciation approval. Separate language editions and a device with selectable languages need different content, electronics and validation reviews.</p>
    <p class="sb-language-status" data-language-status role="status" aria-live="polite" hidden></p>
    <noscript><p class="sb-language-nojs">All three language examples are shown. Choose your language requirements in the inquiry form; JavaScript enables the preview and Add controls.</p></noscript>
  </div>
</section>
<script>import '../../scripts/sound-book-languages';</script>
