---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; label?: string; caption: string; compact?: boolean; contain?: boolean; }
const { src, alt, label, caption, compact = false, contain = false } = Astro.props;
const widths = [160, 240, 320, 480, 640, 960].filter(width => width < src.width);
widths.push(src.width);
---
<figure class:list={['ap-evidence', { 'ap-evidence-compact': compact, 'ap-evidence-contain': contain }]}>
  <div class="ap-evidence-image"><Image src={src} alt={alt} widths={widths} sizes={compact ? '(max-width: 599px) 160px, 200px' : '(max-width: 599px) calc(100vw - 48px), (max-width: 859px) 44vw, 370px'} width={src.width} height={src.height} format="webp" quality={80} loading="lazy" decoding="async" /></div>
  <figcaption>{label && <strong>{label}</strong>}<span>{caption}</span></figcaption>
</figure>
