---
interface Props { name: string; }
const { name } = Astro.props;
---
<!-- Category symbols describe play and electronic interaction, not individual products. -->
<svg class="xyh-capability-icon" viewBox="0 0 280 180" fill="none" aria-hidden="true" focusable="false">
  {name === 'blocks' ? <>
    <g class="xyh-capability-play" stroke-linecap="round" stroke-linejoin="round">
      <path d="M80 88V65c0-21 17-38 38-38s38 17 38 38v23" stroke="#123fa8" stroke-width="13" />
      <path d="M99 87V66c0-11 8-19 19-19s19 8 19 19v21" fill="#dce7fb" />
      <path d="M73 107h54v43H95c-12 0-22-10-22-22v-21Z" fill="#123fa8" />
      <path d="m149 108 45-27 15 59-60-32Z" fill="#e92130" />
      <circle cx="194" cy="46" r="17" fill="#123fa8" />
      <path d="M157 150c16 0 29-5 40-15" stroke="#123fa8" stroke-width="7" />
      <path d="m60 66-8-6m13-7-2-10" stroke="#e92130" stroke-width="5" />
      <path d="M223 76c7 8 11 19 11 30" stroke="#123fa8" stroke-width="5" />
    </g>
  </> : <>
    <g class="xyh-capability-connect" stroke="#123fa8" stroke-width="7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M103 61H75c-13 0-23 10-23 23v12c0 13 10 23 23 23h28M177 61h28c13 0 23 10 23 23v12c0 13-10 23-23 23h-28" />
      <path d="M119 31h34c15 0 27 12 27 27M161 149h-34c-15 0-27-12-27-27" stroke-width="5" />
      <rect x="92" y="42" width="96" height="96" rx="25" fill="#123fa8" stroke="none" />
      <g stroke="#fff" stroke-width="4.5">
        <path d="M116 65v50M140 65v50M164 65v50" />
        <circle cx="116" cy="82" r="6" fill="#123fa8" />
        <circle cx="140" cy="101" r="6" fill="#123fa8" />
        <circle cx="164" cy="82" r="6" fill="#123fa8" />
      </g>
    </g>
    <circle cx="210" cy="45" r="10" fill="#e92130" />
    <circle cx="70" cy="135" r="6" fill="#e92130" />
  </>}
</svg>
