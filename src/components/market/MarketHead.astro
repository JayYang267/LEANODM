---
import { SITE } from '@config/site';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  title: string;
  description: string;
  path: string;
  image?: ImageMetadata;
  imageAlt?: string;
  breadcrumbs?: { name: string; path: string }[];
  pageType?: 'WebPage' | 'CollectionPage';
  items?: { name: string; path: string }[];
}
const { title, description, path, image, imageAlt = '', breadcrumbs = [], pageType = 'WebPage', items = [] } = Astro.props;
const origin = SITE.url;
const canonical = new URL(path, origin).href;
const photo = image ? await getImage({src:image,width:Math.min(image.width,1200),format:'webp',quality:82}) : undefined;
const graph = [
  { '@type': pageType, '@id': canonical+'#webpage', url:canonical, name:title, description, inLanguage:'en', isPartOf:{'@id':origin+'/#website'}, about:{'@id':origin+'/#xinyinhai'}, ...(breadcrumbs.length ? {breadcrumb:{'@id':canonical+'#breadcrumbs'}} : {}), ...(photo ? {primaryImageOfPage:{'@type':'ImageObject',url:new URL(photo.src,origin).href}} : {}) },
  ...(breadcrumbs.length ? [{ '@type':'BreadcrumbList','@id':canonical+'#breadcrumbs',itemListElement:breadcrumbs.map((item,index)=>({'@type':'ListItem',position:index+1,name:item.name,item:new URL(item.path,origin).href})) }] : []),
  ...(items.length ? [{ '@type':'ItemList',itemListElement:items.map((item,index)=>({'@type':'ListItem',position:index+1,name:item.name,url:new URL(item.path,origin).href})) }] : []),
];
---
{path !== '/' && <>
  <link rel="canonical" href={canonical} />
  <meta property="og:url" content={canonical} />
  {photo && <><meta property="og:image" content={new URL(photo.src,origin).href} /><meta property="og:image:alt" content={imageAlt} /><meta property="og:image:width" content={String(photo.options.width)} /><meta property="og:image:height" content={String(photo.options.height)} /><meta name="twitter:image" content={new URL(photo.src,origin).href} /></>}
</>}
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\u003c')} />
