---
import BrandWordmark from '../BrandWordmark.astro';
const groups = [
  { title: 'Manufacturing & quality', links: [
    ['Capabilities', '/manufacturing/'], ['Quality controls', '/quality/'], ['Lean practice', '/about/activities/?category=improvement#archive'], ['About Us', '/about/'],
  ] },
  { title: 'Your project', links: [
    ['How we work', '/customization/how-we-work/'], ['Project fit', '/customization/project-fit/'], ['Ethical manufacturing', '/about/ethical-manufacturing/'], ['Start your inquiry', '/rfq/?source=home-footer#rfq-form'],
  ] },
];
---
<footer class="home-footer"><div class="home-footer-container">
  <div class="home-footer-grid"><div class="home-footer-brand"><a href="/" aria-label="LEANODM home"><img src="/brand/xinyinhai-symbol-display-96.webp" srcset="/brand/xinyinhai-symbol-display-48.webp 48w, /brand/xinyinhai-symbol-display-96.webp 96w, /brand/xinyinhai-symbol-display-144.webp 144w" sizes="36px" alt="" width="36" height="36" /><BrandWordmark /></a><p>LEANODM.com presents Xinyinhai’s product development and manufacturing capabilities.</p><a class="home-footer-email" href="mailto:quotes@leanodm.com">quotes@leanodm.com</a></div>{groups.map(group => <nav aria-label={group.title + ' footer navigation'}><h2>{group.title}</h2><ul>{group.links.map(([label,href]) => <li><a href={href}>{label}</a></li>)}</ul></nav>)}</div>
  <div class="home-footer-bottom"><span>{new Date().getFullYear()} · LEANODM.com</span><span>Xinyinhai · Humen, Dongguan, China</span></div>
</div></footer>
<style>
  .home-footer{background:#0c1b36;color:#c2cce0;font-family:Arial,Helvetica,sans-serif;padding:53px 0 24px;font-size:12px;line-height:1.7}
  .home-footer-container{width:min(1240px,calc(100% - 96px));margin-inline:auto}
  .home-footer-grid{display:grid;grid-template-columns:1.65fr 1fr 1fr;gap:55px}
  .home-footer-brand>a:first-child{display:flex;align-items:center;gap:8px;width:fit-content;margin-bottom:20px;background:white;padding:10px 12px;border-radius:4px}
  .home-footer-brand>p{max-width:31ch;color:#99a9c4;margin:0 0 13px}
  .home-footer-email{font-size:11px;text-decoration:underline;text-underline-offset:4px}
  h2{font-size:11px;font-weight:700;color:white;margin:3px 0 16px;letter-spacing:.01em}
  ul{list-style:none;margin:0;padding:0;display:grid;gap:9px}
  a:hover{color:white}
  a:focus-visible{outline:3px solid #e62129;outline-offset:5px}
  .home-footer-bottom{border-top:1px solid #ffffff17;display:flex;justify-content:space-between;gap:20px;margin-top:36px;padding-top:20px;font-size:10px;color:#95a5bf}
  nav a{display:inline-block;padding-block:2px}
  @media(max-width:1100px){.home-footer-container{width:calc(100% - 64px)}.home-footer-grid{gap:30px}}
  @media(max-width:760px){.home-footer{padding:38px 0 22px}.home-footer-container{width:calc(100% - 40px)}.home-footer-grid{grid-template-columns:1fr 1fr;gap:27px 20px}.home-footer-brand{grid-column:1/-1}.home-footer-brand>p{max-width:45ch}.home-footer-bottom{display:flex;flex-direction:column;gap:5px;margin-top:30px;padding-top:18px}h2{margin-bottom:13px}.home-footer-grid nav:last-child{grid-column:1/-1}.home-footer-grid nav:last-child ul{grid-template-columns:1fr 1fr;gap:10px 20px}}
  @media(max-width:760px){.home-footer{font-size:14px}.home-footer-email{font-size:13px}h2{font-size:12px}.home-footer-bottom{font-size:12px}nav a{padding-block:3px}}
</style>
