---
import BrandWordmark from "./BrandWordmark.astro";
import { NAVIGATION, SITE } from '@config/site';
import { leanManufacturingNavigation, leanCustomizationNavigation, leanQualityNavigation, leanAboutNavigation, leanInquiryNavigation } from './leanNavigation';
---

<footer class="bg-slate-900 text-slate-300">
  <div class="container mx-auto px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-4">
      <!-- Website introduction -->
      <div class="lg:col-span-1 space-y-6">
        <a href="/" aria-label="LEANODM home" class="inline-flex shrink-0 items-center gap-2 px-2 py-2">
          <img src="/brand/xinyinhai-symbol-display-96.webp" srcset="/brand/xinyinhai-symbol-display-48.webp 48w, /brand/xinyinhai-symbol-display-96.webp 96w, /brand/xinyinhai-symbol-display-144.webp 144w" sizes="40px" alt="" width="44" height="44" class="h-10 w-10 shrink-0 object-contain" />
          <BrandWordmark />
        </a>
        <p class="text-sm text-slate-400 leading-relaxed max-w-xs">
          {SITE.description}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-6">
          Quick Links
        </h3>
        <ul class="space-y-3">
          {NAVIGATION.filter(item => item.href !== leanInquiryNavigation.href).map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-slate-400 hover:text-primary-400 transition-colors inline-flex items-center group"
              >
                <span class="w-0 group-hover:w-2 h-0.5 bg-primary-400 transition-all mr-0 group-hover:mr-2"></span>
                {item.name}
              </a>
            </li>
          ))}
        </ul>
        <nav aria-label="About footer navigation" class="mt-8">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-6">About</h3>
          <ul class="space-y-3">{leanAboutNavigation.map(item => <li><a href={item.href} class="text-sm text-slate-400 hover:text-primary-400">{item.label}</a></li>)}</ul>
        </nav>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-6">ODM &amp; OEM</h3>
        <ul class="space-y-3 mb-6">{leanCustomizationNavigation.map(item => <li><a href={item.href} class="text-sm text-slate-400 hover:text-primary-400">{item.label}</a></li>)}</ul>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-6"><a href="/manufacturing/">Capabilities</a></h3>
        <ul class="space-y-3 mb-6">{leanManufacturingNavigation.map(item => <li><a href={item.href} class="text-sm text-slate-400 hover:text-primary-400">{item.label}</a></li>)}</ul>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-6"><a href="/quality/">Quality</a></h3>
        <ul class="space-y-3 mb-6">{leanQualityNavigation.map(item => <li><a href={item.href} class="text-sm text-slate-400 hover:text-primary-400">{item.label}</a></li>)}</ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-6">
          Get Started
        </h3>
        <div class="mt-8">
          <a
            href={leanInquiryNavigation.href}
            class="inline-flex items-center px-6 py-3 text-sm font-semibold text-white bg-linear-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 rounded-lg shadow-lg hover:shadow-xl transition-all"
          >
            {leanInquiryNavigation.label}
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-16 pt-8 border-t border-slate-800">
      <div class="flex items-center justify-between">
        <p class="text-sm text-slate-400">
          {new Date().getFullYear()} · LEANODM.com
        </p>
      </div>
    </div>
  </div>
</footer>
