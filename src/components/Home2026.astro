---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeFooter from './market/HomeFooter.astro';
import Icon from './CustomizationIcon.astro';
import ManufacturingEras from './HomeManufacturingEras.astro';
import HomeAwards from './HomeAwards.astro';
import HomeWorkflowIllustration from './HomeWorkflowIllustration.astro';
import HomeIpProductScene from './HomeIpProductScene.astro';
import HomeCapabilityIcon from './HomeCapabilityIcon.astro';
import { SITE } from '../config/site';
import { homeCopy, certificationItems, productScope, customerTypes, workflowSteps, testimonials, homeFaqs } from '../data/home';
import benesse from '../assets/home/partners/benesse.png';
import bandai from '../assets/home/partners/bandai.png';
import beiens from '../assets/home/partners/beiens.png';
import lezhi from '../assets/home/partners/lezhi-xiaotiandi.png';
import auchan from '../assets/home/partners/auchan.png';
import argos from '../assets/home/partners/argos.png';
import wb from '../assets/home/partners/wb-japan.png';
import alibaba from '../assets/home/partners/official-alibaba-com.png';
import amazon from '../assets/home/partners/official-amazon.png';
import kickstarter from '../assets/home/partners/official-kickstarter.svg?url';
import indiegogo from '../assets/home/partners/official-indiegogo.png';
import nvidia from '../assets/home/partners/official-nvidia.svg?url';
import openai from '../assets/home/partners/official-openai.svg?url';
import startupScene from '../assets/home/customer-roles/startup-abstract-v5.png';
import brandScene from '../assets/home/customer-roles/ip-background-v8/player-blank-card.png';
import brandIdentityScene from '../assets/home/customer-roles/brand-abstract-v5.png';
import procurementScene from '../assets/home/customer-roles/procurement-abstract-v5.png';
import '../styles/home-2026.css';
import '../styles/home-capabilities.css';
import '../styles/home-customers.css';
import '../styles/home-workflow.css';
import '../styles/home-factory-video.css';
import '../styles/home-testimonials.css';
import '../styles/home-partners.css';
import '../styles/home-value.css';
import '../styles/home-layout.css';

const title = 'Custom Plastic & Electronic Manufacturing | LEANODM';
const description = 'Custom plastic and electronic product development and mass production through lean manufacturing. Educational toys, gifts and souvenirs, IP stationery, and consumer electronics.';
const canonical = new URL('/', SITE.url).href;
const heroImage = { src: '/media/home-factory/factory-poster.webp', options: { width: 1920, height: 1080 } };
const experience = homeCopy.experience.split('40');
const developed = homeCopy.developed.split('3,000+');
const delivered = homeCopy.delivered.split(/(1,000,000,000\+)/);
const customerScenes = [
  { image: startupScene, alt: 'Abstract illustration of a product idea progressing from drawings and an electronic prototype to repeat production' },
  { image: startupScene, alt: 'Concept illustration of an electronic product prototype and matching units prepared for repeat production' },
  { image: brandScene, alt: 'Concept composition of a plain story card player with fairy-tale characters arranged behind it on white', whiteBackground: true, characterScene: true },
  { image: brandIdentityScene, alt: 'Abstract illustration of a coordinated product, packaging and stationery design for a product brand' },
  { image: startupScene, alt: 'Abstract illustration of a product idea progressing from drawings and an electronic prototype to repeat production' },
  { image: procurementScene, alt: 'Abstract illustration of coordinated gift sets, event passes and bulk packaging for corporate, government and event buyers' },
];
const partners = [
  { name: 'Alibaba.com', image: alibaba, wide: true },
  { name: 'Amazon', image: amazon },
  { name: 'Kickstarter', vector: kickstarter, width: 320, height: 34, wide: true },
  { name: 'Indiegogo', image: indiegogo, wide: true },
  { name: 'NVIDIA', vector: nvidia, width: 2072, height: 396, wide: true, monochrome: true },
  { name: 'OpenAI', vector: openai, width: 1127, height: 305, monochrome: true },
  { name: 'Benesse', image: benesse }, { name: 'BANDAI', image: bandai },
  { name: 'beiens', image: beiens }, { name: 'Lezhi Xiaotiandi', image: lezhi },
  { name: 'Auchan', image: auchan }, { name: 'Argos', image: argos }, { name: 'WB JAPAN', image: wb },
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': canonical + '#webpage', url: canonical, name: title, description, inLanguage: 'en', isPartOf: { '@id': canonical + '#website' }, about: { '@id': canonical + '#xinyinhai' }, primaryImageOfPage: { '@type': 'ImageObject', url: new URL(heroImage.src, canonical).href } },
    { '@type': 'FAQPage', '@id': canonical + '#faq', url: canonical + '#faq', inLanguage: 'en', isPartOf: { '@id': canonical + '#webpage' }, mainEntity: homeFaqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
  ],
};
---
<BaseLayout title={title} description={description} homeImage={{ src: new URL(heroImage.src, canonical).href, alt: 'Production workshop at Xinyinhai', width: heroImage.options.width, height: heroImage.options.height }}>
  <Fragment slot="head">
    <meta property="og:locale" content="en_US" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
  </Fragment>
  <div class="xyh-home">
    <section class="xyh-hero" aria-labelledby="home-title" data-video-slot data-factory-hero data-video-state="poster">
      <img class="xyh-hero-poster" src={heroImage.src} alt="" width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async" />
      <video class="xyh-factory-background" data-factory-background
        data-desktop-source="/media/home-factory/factory-loop-soft-expanded-1080p.mp4"
        data-mobile-source="/media/home-factory/factory-loop-soft-expanded-720p.mp4"
        width="1920" height="1080" muted loop playsinline preload="none"
        aria-hidden="true" tabindex="-1" disablepictureinpicture disableremoteplayback></video>
      <div class="xyh-wrap xyh-hero-content">
        <div class="xyh-hero-lead">
          <p class="xyh-welcome" lang="en"><span aria-hidden="true"></span>{homeCopy.welcome}</p>
          <h1 id="home-title">{homeCopy.title}</h1>
          <p class="xyh-hero-intro">{homeCopy.intro}</p>
          <div class="xyh-actions" lang="en"><a class="xyh-button" href="/rfq/">Start your inquiry <Icon name="arrow-up-right" /></a><a class="xyh-secondary-link" href="#how-we-work">See how it works <Icon name="arrow-down" /></a></div>
        </div>
        <div class="xyh-factory-toolbar" lang="en"><a class="xyh-factory-watch" href="/media/home-factory/factory-tour-soft-1080p.mp4" data-factory-watch aria-haspopup="dialog" aria-controls="factory-film"><span class="xyh-factory-play"><Icon name="play" /></span><span>Watch factory film<small>1 min 41 sec</small></span></a></div>
        <div class="xyh-hero-stats">
          <div><p>{homeCopy.history}</p><p class="xyh-years" lang="en"><span class="xyh-years-number">{experience[0]}<strong>40</strong></span> <span class="xyh-years-caption">{experience[1].trim()}</span></p></div>
          <div><p>{developed[0]}<span>3,000+</span>{developed[1]}</p></div>
          <div><p>{delivered[0]}{delivered[1] && <span>{delivered[1]}</span>}{delivered[2]}</p></div>
        </div>
      </div>
    </section>

    <section class="xyh-certifications xyh-ticker" aria-label="Factory certifications" tabindex="0" data-ticker>
          <div class="xyh-ticker-window"><div class="xyh-ticker-track"><ul class="xyh-cert-rail" aria-label="Factory certifications">{certificationItems.map(cert => <li class:list={['xyh-cert', { 'is-active': cert.active }]} data-cert-name={cert.name}><span class="xyh-cert-art" aria-hidden="true">{'image' in cert ? <img src={cert.image} alt="" width="104" height="50" loading="eager" decoding="async" /> : cert.name}</span><span class="xyh-cert-label">{cert.name}</span></li>)}</ul></div></div>
          <div class="xyh-wrap xyh-cert-caption"><p class="xyh-cert-note"><span aria-hidden="true"></span>{homeCopy.certificationNote}</p></div>
    </section>

    <dialog class="xyh-factory-dialog" id="factory-film" aria-labelledby="factory-film-title" data-factory-dialog>
      <div class="xyh-factory-dialog-heading"><div><p>XINYINHAI</p><h2 id="factory-film-title">Inside the factory</h2></div><button type="button" data-factory-close aria-label="Close factory film" autofocus><Icon name="x" /></button></div>
      <video class="xyh-factory-film" data-factory-film data-source="/media/home-factory/factory-tour-soft-1080p.mp4" width="1920" height="1080" controls muted playsinline preload="none" poster={heroImage.src}>Your browser does not support HTML video. <a href="/media/home-factory/factory-tour-soft-1080p.mp4">Open the factory film</a>.</video>
      <p class="xyh-factory-error" data-factory-film-error role="status" hidden>The video could not load. Please try the direct video links below.</p>
      <p class="xyh-factory-dialog-caption">A look at Xinyinhai’s workshops and production processes.<span><a href="/media/home-factory/factory-tour-soft-1080p.mp4" data-factory-film-source target="_blank" rel="noopener">Open video <Icon name="arrow-up-right" /></a><a href="/media/home-factory/factory-tour-soft-4k.mp4" data-factory-film-source target="_blank" rel="noopener">Watch in 4K <Icon name="arrow-up-right" /></a></span></p>
    </dialog>

    <section class="xyh-section xyh-scope" aria-labelledby="scope-title"><div class="xyh-wrap">
      <div class="xyh-section-heading"><h2 id="scope-title">Product Capabilities</h2><span class="xyh-section-rule" aria-hidden="true"></span></div>
      <ul class="xyh-scope-grid">{productScope.map(item => <li><a class="xyh-scope-link" href={item.href}><div class="xyh-scope-art" aria-hidden="true"><HomeCapabilityIcon name={item.icon} /></div><h3>{item.name}</h3></a></li>)}</ul>
    </div></section>

    <section class="xyh-section xyh-customers" aria-labelledby="customers-title"><div class="xyh-wrap">
      <div class="xyh-section-heading"><h2 id="customers-title">Who Is Our Lean ODM Approach For?</h2></div>
      <div class="xyh-customer-intro">
        <p>Lean manufacturing helps us deliver consistently high-quality products while saving customers the time and expense of building their own development and production teams. A dependable manufacturing partner also helps reduce defects, warranty claims and recalls that can erode consumer trust, damage brand value and create legal exposure.</p>
      </div>
      <div class="xyh-audience-layout" data-home-customers>{customerTypes.map((item, index) => <div class="xyh-audience-item" style={`--customer-row: ${index + 1}`} data-customer-item>
        <button class="xyh-audience-trigger" type="button" id={`customer-type-${index + 1}`} aria-controls={`customer-detail-${index + 1}`} aria-expanded="true" data-customer-trigger>
          <span>{item.title}</span><span class="xyh-audience-indicator" aria-hidden="true"></span>
        </button>
        <article class="xyh-audience-panel" id={`customer-detail-${index + 1}`} aria-labelledby={`customer-heading-${index + 1}`} data-customer-panel>
          <h3 class="xyh-audience-heading" id={`customer-heading-${index + 1}`}>{item.title}</h3>
          <div class="xyh-audience-body">
            <div class="xyh-audience-copy">
              <p>{item.text}</p>
              {'audiences' in item && item.audiences && <ul class="xyh-audience-list">{item.audiences.map(audience => <li>{audience}</li>)}</ul>}
              {item.details && <p class="xyh-audience-details">{item.details}</p>}
            </div>
            <div class:list={['xyh-audience-art', { 'xyh-audience-art-white': customerScenes[index].whiteBackground }]}>{customerScenes[index].characterScene ? <HomeIpProductScene /> : <Image src={customerScenes[index].image} alt={customerScenes[index].alt} widths={[360, 540, 810, 1080]} sizes="(max-width: 760px) calc(100vw - 88px), (max-width: 1100px) 42vw, (min-width: 1376px) 440px, 32vw" loading="lazy" format="webp" quality={85} />}</div>
          </div>
        </article>
      </div>)}</div>
      <div class="xyh-customer-intro xyh-customer-trust">
        <p>Long-term partnerships depend on trust. We help safeguard your ideas, designs and project information through strict confidentiality procedures and project-specific non-disclosure agreements. <a href="/customization/ip-protection/">Explore our IP &amp; Confidentiality safeguards.</a></p>
      </div>
    </div></section>

    <section class="xyh-section xyh-work" id="how-we-work" aria-labelledby="work-title" lang="en"><div class="xyh-wrap">
      <div class="xyh-work-heading"><p class="xyh-eyebrow">HOW WE WORK</p><h2 id="work-title">From Your Product Idea<br /> to Production &amp; Delivery</h2><p class="xyh-work-intro">Start with an idea, a sample or a specification. We’ll help you define the next steps.</p></div>
      <ol class="xyh-steps" data-home-workflow>{workflowSteps.map(step => <li data-workflow-card>
        <span class="xyh-step-number" aria-hidden="true">{step.number}</span>
        <div class="xyh-step-art" aria-hidden="true"><HomeWorkflowIllustration step={step.number} /></div>
        <h3 class="xyh-step-heading"><button class="xyh-step-trigger" type="button" id={`work-step-${step.number}`} aria-label={`${step.number}. ${step.title}`} aria-controls={`work-detail-${step.number}`} aria-expanded="true" data-workflow-trigger>{step.title}</button></h3>
        <div class="xyh-step-detail" id={`work-detail-${step.number}`} role="region" aria-labelledby={`work-step-${step.number}`} data-workflow-detail>
          <p>{step.text}</p>
          {step.options && <nav class="xyh-step-options" aria-label="Explore your project starting point"><ul>{step.options.map(option => <li><a href={option.href}><span class="xyh-step-option-title">{option.title}</span><span class="xyh-step-option-summary">{option.text}</span></a></li>)}</ul></nav>}
          {step.confidentiality && <section class="xyh-step-confidentiality" aria-labelledby={`work-nda-title-${step.number}`}>
            <h4 id={`work-nda-title-${step.number}`}>{step.confidentiality.title}</h4>
            <p>{step.confidentiality.text}</p>
            <a class="xyh-step-nda-link" href={step.confidentiality.href}>{step.confidentiality.label}<span aria-hidden="true">→</span></a>
          </section>}
        </div>
      </li>)}</ol>
      <div class="xyh-work-actions"><a class="xyh-text-link" href="/customization/how-we-work/">Explore Our Development Process →</a></div>
    </div></section>

    <section class="xyh-section xyh-value" aria-labelledby="value-title"><div class="xyh-wrap">
      <h2 class="xyh-value-heading" id="value-title">Lean Manufacturing Means <span>Quality-to-Price Ratio</span></h2>
      <div class="xyh-value-copy">
        <p>{homeCopy.valueIntro}</p>
      </div>
      <ManufacturingEras />
      <div class="xyh-value-copy xyh-value-summary">
        <p>{homeCopy.valueBody.split(/(factory management|quality management)/i).map(part => part.toLowerCase() === 'factory management' ? <a href="/about/activities/?category=improvement#archive">{part}</a> : part.toLowerCase() === 'quality management' ? <a href="/quality/quality-control-process/">{part}</a> : part)}</p>
      </div>
    </div></section>

    <section class="xyh-partners xyh-ticker" id="partners" aria-label="Brand logos" tabindex="0" data-ticker>
      <div class="xyh-ticker-window"><div class="xyh-ticker-track"><ul class="xyh-partner-rail" id="partner-rail">{partners.map(partner => <li class:list={{ 'is-wide-logo': 'wide' in partner && partner.wide, 'is-monochrome': 'monochrome' in partner && partner.monochrome }} data-brand={partner.name}>
        {'vector' in partner ? <img src={partner.vector} alt={partner.name} width={partner.width} height={partner.height} loading="lazy" decoding="async" /> : <Image src={partner.image} alt={partner.name} width={Math.min(partner.image.width, 300)} format="webp" quality={95} loading="lazy" />}
      </li>)}</ul></div></div>
    </section>

    <HomeAwards />

    <section class="xyh-section xyh-testimonials xyh-testimonials-editorial" aria-labelledby="testimonials-title" data-testimonials><div class="xyh-wrap">
      <div class="xyh-testimonial-heading"><h2 id="testimonials-title">What Our Customers Say</h2></div>
      <div class="xyh-review-stage">
      <div class="xyh-review-window"><div class="xyh-quotes" id="customer-testimonial-track" data-review-track>{testimonials.map((item, index) => <article id={`customer-review-${index + 1}`} aria-labelledby={`review-title-${index + 1}`} data-review-card>
        <div class="xyh-review-card-top"><span class="xyh-review-avatar" aria-hidden="true">{item.name.charAt(0)}</span><span class="xyh-quote-mark" aria-hidden="true">“</span></div>
        <h3 id={`review-title-${index + 1}`}>{item.title}</h3>
        <blockquote id={`review-text-${index + 1}`}><p>{item.text}</p></blockquote>
        <footer class="xyh-review-author"><p class="xyh-review-name">{item.name}</p><p class="xyh-review-country">{item.country}</p></footer>
      </article>)}</div></div>
      <button class="xyh-review-arrow xyh-review-arrow-prev" type="button" data-review-direction="-1" aria-controls="customer-testimonial-track" aria-label="Previous customer testimonial"><Icon name="arrow-left" /></button>
      <button class="xyh-review-arrow xyh-review-arrow-next" type="button" data-review-direction="1" aria-controls="customer-testimonial-track" aria-label="Next customer testimonial"><Icon name="arrow-right" /></button>
      </div>
      <div class="xyh-review-navigation">
        <div class="xyh-review-pagination" aria-label="Choose a customer testimonial">{testimonials.map((item, index) => <button type="button" data-review-index={index} aria-label={`Show testimonial by ${item.name}`} aria-pressed={index === 0 ? 'true' : 'false'}></button>)}</div>
      </div>
    </div></section>

    <section class="xyh-section xyh-faq" id="faq" aria-labelledby="faq-title"><div class="xyh-wrap xyh-faq-layout"><div><h2 id="faq-title">Frequently Asked Questions</h2><div class="xyh-faq-art" aria-hidden="true"><Icon name="messages-square" /></div></div><div class="xyh-faq-list">{homeFaqs.map(faq => <details><summary><h3>{faq.question}</h3><Icon name="plus" /></summary><div class="xyh-faq-answer"><p>{faq.answer}</p></div></details>)}</div></div></section>

    <section class="xyh-final" aria-labelledby="final-title"><div class="xyh-wrap"><span class="xyh-final-decoration" aria-hidden="true"></span><h2 id="final-title">Build Better Products. Create Lasting Value.</h2><p>Let us help you bring greater certainty to your products and projects.</p><a href="/rfq/">Start your inquiry<Icon name="arrow-up-right" /></a></div></section>
  </div>
  <HomeFooter slot="footer" />
  <noscript><style>.xyh-ticker-window{overflow:visible;mask-image:none}.xyh-ticker-track{width:100%;display:block}.xyh-ticker-track>ul{width:100%;min-width:0;flex-wrap:wrap;justify-content:center;gap:20px!important}</style></noscript>
</BaseLayout>

<style>
  .xyh-scope-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .xyh-scope-link { display: block; color: inherit; text-decoration: none; }
  .xyh-scope-link:is(:hover, :focus-visible) .xyh-scope-art { border-bottom-color: var(--blue); }
  .xyh-scope-link:focus-visible { outline: 2px solid var(--blue); outline-offset: 7px; }
  @media (max-width: 540px) {
    .xyh-scope-grid { grid-template-columns: 1fr; }
    .xyh-scope-art { height: 190px; }
  }
</style>

<script>
  import { initFactoryVideo } from '../scripts/home-factory-video';
  import { initManufacturingEras } from '../scripts/home-manufacturing-eras';
  import { initHomeWorkflow } from '../scripts/home-workflow';
  import { initHomeCustomers } from '../scripts/home-customers';
  import { initTestimonials } from '../scripts/home-testimonials';
  initFactoryVideo();
  initManufacturingEras();
  initHomeWorkflow();
  initHomeCustomers();
  initTestimonials();
  for (const ticker of document.querySelectorAll<HTMLElement>('[data-ticker]')) {
    const track = ticker.querySelector<HTMLElement>('.xyh-ticker-track');
    const list = track?.querySelector('ul');
    if (!track || !list) continue;
    // Only the original server-rendered list is exposed to assistive tools.
    const duplicate = list.cloneNode(true) as HTMLElement;
    duplicate.removeAttribute('id');
    duplicate.setAttribute('aria-hidden', 'true');
    duplicate.setAttribute('inert', '');
    track.append(duplicate);
    ticker.classList.add('is-ready');
  }
</script>
