---
interface Props {
  variant?: 'hero' | 'controls';
  idPrefix: string;
}

const { variant = 'hero', idPrefix } = Astro.props;
const titleId = `${idPrefix}-title`;
const descriptionId = `${idPrefix}-description`;
const arrowId = `${idPrefix}-arrow`;
const title = variant === 'hero'
  ? 'Illustrative exploded assembly and packaging sequence'
  : 'Seven assembly control points on illustrative geometry';
const description = variant === 'hero'
  ? 'An abstract upper shell, insert, spring and fasteners align above a lower shell. A small assembled object and checked package explain the relationship between assembly and packing. This is explanatory geometry, not a product drawing or factory equipment.'
  : 'Numbered callouts identify component positioning, clean surfaces, secure engagement, fastening, lubricant at designated moving locations, reference sample comparison and smooth operation. The abstract housing and mechanism show concepts, not dimensions or measured performance.';
---

<figure class:list={['assembly-diagram', `assembly-diagram--${variant}`]}>
  <svg viewBox={variant === 'hero' ? '0 0 680 530' : '0 0 680 500'} role="img" aria-labelledby={`${titleId} ${descriptionId}`} xmlns="http://www.w3.org/2000/svg">
    <title id={titleId}>{title}</title>
    <desc id={descriptionId}>{description}</desc>
    <defs>
      <marker id={arrowId} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M1 1 9 5 1 9" fill="none" stroke="#183ba3" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
