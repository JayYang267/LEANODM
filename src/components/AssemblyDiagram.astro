<style>
  .assembly-diagram { margin:0; width:100%; color:#142a46; }
  .assembly-diagram svg { display:block; width:100%; height:auto; overflow:visible; }
  .assembly-outline { stroke:#142a46; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
  .assembly-construction { stroke:#d5deeb; stroke-width:1.2; }
  .assembly-leaders { stroke:#849bbd; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
  .assembly-callouts circle { fill:#fff; stroke:#183ba3; stroke-width:1.8; }
  .assembly-callouts text { fill:#183ba3; font-family:Arial, sans-serif; font-size:18px; font-weight:700; text-anchor:middle; dominant-baseline:central; }
  .assembly-diagram figcaption { padding:8px 16px 14px; color:#506178; font-size:.7rem; line-height:1.5; text-align:center; }
  @media (max-width:1119px) { .assembly-callouts text { font-size:26px; } }
  @media (max-width:599px) { .assembly-callouts text { font-size:30px; } }
</style>
