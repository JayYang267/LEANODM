---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption: string; eager?: boolean; }
const { src, alt, caption, eager = false } = Astro.props;
const widths = [320, 480, 640, 800].filter(width => width < src.width).concat(Math.min(src.width, 960));
---
<figure class="b2b-figure">
  <Image src={src} alt={alt} widths={[...new Set(widths)]} sizes="(max-width: 599px) calc(100vw - 32px), (max-width: 859px) calc(100vw - 48px), 560px" width={Math.min(src.width, 960)} format="webp" quality={82} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  <figcaption>{caption}</figcaption>
</figure>
