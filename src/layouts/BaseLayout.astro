---
import '../styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import LeanGlobalHeader from '@components/LeanGlobalHeader.astro';
import TechnicalPageHeader from '@components/TechnicalPageHeader.astro';
import TechnicalPageFooter from '@components/TechnicalPageFooter.astro';
import { SITE } from '@config/site';

interface Props {
  title?: string;
  description?: string;
  technicalPage?: boolean;
  contactHref?: string;
  mainId?: string;
  technicalNavigation?: readonly { label: string; href: string }[];
  technicalPageTitle?: string;
  technicalContactLabel?: string;
}

const currentPathname = Astro.url.pathname;

const { 
  title = SITE.title, 
  description = SITE.description,
  technicalPage = false,
  contactHref = '#project-requirements',
  mainId = 'main-content',
  technicalNavigation,
  technicalPageTitle,
  technicalContactLabel,
} = Astro.props;
---

<!doctype html>
<html lang="en" class:list={{ 'technical-page': technicalPage }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/brand/xinyinhai-symbol.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-neutral-900 antialiased">
    {technicalPage && <a class="technical-skip-link" href={`#${mainId}`}>Skip to content</a>}
    {technicalPage ? (
      <>
        <LeanGlobalHeader contactHref={contactHref} contactLabel={technicalContactLabel ?? 'Discuss Your Project'} />
        <TechnicalPageHeader navigation={technicalNavigation} pageTitle={technicalPageTitle} />
      </>
    ) : <Header currentPathname={currentPathname} />}
    <main id={technicalPage ? mainId : undefined} tabindex={technicalPage ? -1 : undefined} class="flex-1">
      <slot />
    </main>
    {technicalPage ? <TechnicalPageFooter contactHref={contactHref} navigation={technicalNavigation} pageTitle={technicalPageTitle} contactLabel={technicalContactLabel} /> : <Footer />}
  </body>
</html>

<style>
  .technical-skip-link {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    border-radius: 0.375rem;
    background: #183ba3;
    color: white;
    transform: translateY(-150%);
  }

  .technical-skip-link:focus {
    transform: translateY(0);
    outline: 3px solid #e62129;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.technical-page) {
      scroll-behavior: auto;
    }
  }
</style>
